---
const title = "Advertising Policy | TradeVerdicts";
const description =
  "TradeVerdicts advertising policy explaining ad separation, sponsorship independence, third-party ads, cookies, privacy, and why advertising does not influence trade verdicts or grades.";
const contactEmail = "DustinBakerNFL@gmail.com";
const lastUpdated = "June 30, 2026";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://tradeverdicts.com/advertising" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://tradeverdicts.com/advertising" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "TradeVerdicts Advertising Policy",
      "url": "https://tradeverdicts.com/advertising",
      "dateModified": "2026-06-30",
      "description": description,
      "isPartOf": {
        "@type": "WebSite",
        "name": "TradeVerdicts",
        "url": "https://tradeverdicts.com"
      },
      "about": {
        "@type": "Thing",
        "name": "Advertising policy"
      }
    })} />

    <style>
      :root {
        color-scheme: dark;
        --bg: #07111f;
        --panel: #0d1b2d;
        --panel-soft: #102238;
        --text: #f4f7fb;
        --muted: #aeb9c8;
        --line: rgba(255, 255, 255, 0.12);
        --accent: #f5b544;
        --accent-soft: rgba(245, 181, 68, 0.14);
        --blue: #2f94ff;
        --blue-soft: rgba(47, 148, 255, 0.12);
        --max: 1120px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background:
          radial-gradient(circle at top left, rgba(245, 181, 68, 0.12), transparent 34rem),
          linear-gradient(180deg, #07111f 0%, #081522 48%, #06101b 100%);
        color: var(--text);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        line-height: 1.65;
      }

      a {
        color: inherit;
      }

      .site-header {
        border-bottom: 1px solid var(--line);
        background: rgba(7, 17, 31, 0.86);
        backdrop-filter: blur(14px);
        position: sticky;
        top: 0;
        z-index: 10;
      }

      .nav {
        width: min(var(--max), calc(100% - 32px));
        margin: 0 auto;
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        font-weight: 900;
        letter-spacing: -0.03em;
        font-size: 1.28rem;
      }

      .brand-logo {
        display: block;
        width: 176px;
        height: auto;
      }

      .nav-links {
        display: flex;
        gap: 18px;
        align-items: center;
        color: var(--muted);
        font-weight: 700;
        font-size: 0.95rem;
      }

      .nav-links a {
        text-decoration: none;
      }

      .nav-links a:hover,
      .nav-links a[aria-current="page"] {
        color: var(--text);
      }

      main {
        width: min(var(--max), calc(100% - 32px));
        margin: 0 auto;
        padding: 56px 0 72px;
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
        gap: 32px;
        align-items: stretch;
        margin-bottom: 34px;
      }

      .hero-card,
      .panel {
        border: 1px solid var(--line);
        background: linear-gradient(180deg, rgba(16, 34, 56, 0.94), rgba(10, 23, 39, 0.94));
        border-radius: 28px;
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.25);
      }

      .hero-card {
        padding: clamp(28px, 5vw, 56px);
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--accent);
        background: var(--accent-soft);
        border: 1px solid rgba(245, 181, 68, 0.25);
        border-radius: 999px;
        padding: 8px 12px;
        font-weight: 900;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 20px;
      }

      h1 {
        font-size: clamp(2.35rem, 6vw, 5.2rem);
        line-height: 0.95;
        letter-spacing: -0.075em;
        margin: 0 0 22px;
      }

      .dek {
        color: var(--muted);
        font-size: clamp(1.05rem, 2vw, 1.3rem);
        max-width: 780px;
        margin: 0;
      }

      .mission-line {
        margin-top: 26px;
        padding: 18px 20px;
        border-left: 4px solid var(--accent);
        background: rgba(255, 255, 255, 0.045);
        border-radius: 16px;
        font-weight: 900;
        font-size: 1.1rem;
        letter-spacing: -0.02em;
      }

      .quick-card {
        padding: 26px;
      }

      .quick-card h2 {
        margin-top: 0;
        font-size: 1.2rem;
      }

      .quick-card ul {
        padding-left: 20px;
        color: var(--muted);
      }

      .quick-card li + li {
        margin-top: 10px;
      }

      .updated {
        margin-top: 22px;
        display: inline-flex;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 8px 12px;
        color: var(--muted);
        background: rgba(255, 255, 255, 0.04);
        font-weight: 800;
      }

      .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
        margin-top: 24px;
      }

      .panel {
        padding: clamp(24px, 4vw, 34px);
      }

      .panel.wide {
        grid-column: 1 / -1;
      }

      h2 {
        margin: 0 0 14px;
        font-size: clamp(1.55rem, 3vw, 2.2rem);
        line-height: 1.08;
        letter-spacing: -0.045em;
      }

      h3 {
        margin: 22px 0 8px;
        font-size: 1.08rem;
      }

      p {
        color: var(--muted);
        margin: 0 0 16px;
      }

      .panel p:last-child {
        margin-bottom: 0;
      }

      ul {
        color: var(--muted);
        margin: 0 0 16px;
        padding-left: 22px;
      }

      li + li {
        margin-top: 8px;
      }

      strong {
        color: var(--text);
      }

      .feature-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        margin-top: 20px;
      }

      .feature {
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.04);
        border-radius: 18px;
        padding: 18px;
      }

      .feature strong {
        display: block;
        margin-bottom: 6px;
      }

      .feature span {
        color: var(--muted);
        font-size: 0.95rem;
      }

      .callout {
        border-left: 4px solid var(--blue);
        background: var(--blue-soft);
        border-radius: 16px;
        padding: 16px 18px;
        color: var(--muted);
        margin: 18px 0;
      }

      .cta-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 24px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 18px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 900;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.06);
      }

      .button.primary {
        background: var(--accent);
        color: #08111e;
        border-color: var(--accent);
      }

      .site-footer {
        border-top: 1px solid var(--line);
        padding: 28px 0;
        color: var(--muted);
      }

      .footer-inner {
        width: min(var(--max), calc(100% - 32px));
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 16px;
        font-size: 0.92rem;
      }

      .footer-inner a {
        color: var(--muted);
        text-decoration: none;
        margin-left: 14px;
      }

      .footer-inner a:hover {
        color: var(--text);
      }

      @media (max-width: 820px) {
        .hero,
        .grid,
        .feature-list {
          grid-template-columns: 1fr;
        }

        .nav {
          align-items: flex-start;
          flex-direction: column;
          padding: 18px 0;
        }

        .nav-links {
          flex-wrap: wrap;
        }

        .footer-inner a {
          margin-left: 0;
          margin-right: 14px;
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <nav class="nav" aria-label="Main navigation">
        <a class="brand" href="/" aria-label="TradeVerdicts home">
          <img class="brand-logo" src="/logo.png" alt="TradeVerdicts" />
        </a>

        <div class="nav-links">
          <a href="/search">Search</a>
          <a href="/players">Players</a>
          <a href="/teams">Teams</a>
          <a href="/about">About</a>
          <a href="/methodology">Methodology</a>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-card">
          <div class="eyebrow">Advertising Policy</div>
          <h1>Ads do not write the verdicts.</h1>
          <p class="dek">
            TradeVerdicts may display advertising, sponsorships, affiliate-style placements, or third-party ad units. This page explains how advertising is separated from the trade archive, the verdict cards, the grades, and the written analysis.
          </p>

          <div class="mission-line">
            The archive is built for sports trade research and commentary. Advertising does not control the outcome of any trade page.
          </div>

          <div class="updated">Last updated: {lastUpdated}</div>
        </div>

        <aside class="quick-card panel">
          <h2>Core principles</h2>
          <ul>
            <li>Ads do not influence verdicts or grades.</li>
            <li>Sponsored placements are separate from analysis.</li>
            <li>Trade pages are editorial, not paid rankings.</li>
            <li>Privacy and cookies are handled through the site privacy policy.</li>
            <li>Questions can be sent to {contactEmail}.</li>
          </ul>
        </aside>
      </section>

      <section class="grid">
        <article class="panel wide">
          <h2>How advertising fits TradeVerdicts</h2>
          <p>
            TradeVerdicts is an independent sports trade archive. The site exists to organize trades, show what each team received, connect players and teams, explain draft-pick outcomes, and make a hindsight verdict on the value exchanged.
          </p>
          <p>
            Advertising helps support the work required to maintain that archive: data cleanup, page generation, historical review, correction handling, technical maintenance, and future expansion into additional sports.
          </p>
          <p>
            The presence of an ad on a page does not mean an advertiser reviewed, approved, requested, influenced, or sponsored that trade verdict.
          </p>
        </article>

        <article class="panel">
          <h2>Editorial independence</h2>
          <p>
            Trade verdicts, team grades, player descriptions, asset summaries, and written analysis are editorial judgments. They are not sold to advertisers, sponsors, teams, leagues, agents, sportsbooks, or outside businesses.
          </p>
          <p>
            A trade page may praise one team, criticize another, call a deal even, or explain why hindsight changed the original perception of a transaction. Those conclusions are based on the trade record and the site's grading logic, not on advertising relationships.
          </p>

          <div class="callout">
            Advertisers do not get to buy a better grade, change a verdict, remove criticism, or rewrite the archive.
          </div>
        </article>

        <article class="panel">
          <h2>Types of ads that may appear</h2>
          <p>
            TradeVerdicts may use several forms of monetization as the site grows.
          </p>

          <div class="feature-list">
            <div class="feature">
              <strong>Display ads</strong>
              <span>Standard ad units that may appear in page layouts, sidebars, headers, footers, or article areas.</span>
            </div>
            <div class="feature">
              <strong>Third-party ads</strong>
              <span>Ads delivered by Google or other third-party advertising services.</span>
            </div>
            <div class="feature">
              <strong>Sponsorships</strong>
              <span>Clearly separated sponsor messages, brand placements, or site-supporting partnerships.</span>
            </div>
            <div class="feature">
              <strong>Future formats</strong>
              <span>Newsletter, podcast, research-tool, or database sponsorships may be considered later.</span>
            </div>
          </div>
        </article>

        <article class="panel">
          <h2>Google and third-party advertising</h2>
          <p>
            Some ads may be served by Google or other third-party ad providers. Those providers may use cookies, device identifiers, browser information, ad personalization signals, or similar technologies to deliver, measure, limit, or improve ads.
          </p>
          <p>
            TradeVerdicts does not manually choose every third-party ad a visitor sees. Third-party ad systems may select ads based on the page, the visitor's settings, general advertising signals, or the ad provider's own policies.
          </p>
          <p>
            More information about privacy, cookies, and third-party tools is available on the TradeVerdicts privacy policy page.
          </p>
        </article>

        <article class="panel">
          <h2>Sponsored content and labels</h2>
          <p>
            If TradeVerdicts publishes a sponsored placement, paid message, or advertiser-supported feature, the goal is to make that relationship clear to readers.
          </p>
          <p>
            Sponsorship does not mean the sponsor controls unrelated trade pages, team grades, player pages, search results, or historical verdicts. Sponsored material should be understood as separate from the site's normal trade analysis.
          </p>
        </article>

        <article class="panel">
          <h2>What advertisers cannot control</h2>
          <p>
            Advertising relationships do not determine whether the Saints, Jets, Vikings, Cowboys, Lakers, Yankees, or any other team wins a trade on TradeVerdicts.
          </p>
          <ul>
            <li>Advertisers cannot buy a specific trade verdict.</li>
            <li>Advertisers cannot buy an A grade for a team.</li>
            <li>Advertisers cannot remove a poor grade from an archive page.</li>
            <li>Advertisers cannot change player or pick outcomes.</li>
            <li>Advertisers cannot override corrections or historical review.</li>
          </ul>
        </article>

        <article class="panel wide">
          <h2>Questions about advertising</h2>
          <p>
            For advertising, sponsorship, privacy, correction, or archive questions, email TradeVerdicts at:
          </p>
          <p>
            <strong><a href="mailto:DustinBakerNFL@gmail.com">{contactEmail}</a></strong>
          </p>
          <p>
            TradeVerdicts is independent and is not affiliated with the NFL, NBA, MLB, NHL, NCAA, any league, team, player, or player association. Team names, player names, league references, and historical transaction details are used for identification, commentary, research, and editorial analysis.
          </p>

          <div class="cta-row">
            <a class="button primary" href="mailto:DustinBakerNFL@gmail.com">Email TradeVerdicts</a>
            <a class="button" href="/privacy-policy">Read the privacy policy</a>
            <a class="button" href="/corrections">Submit a correction</a>
            <a class="button" href="/methodology">Read the methodology</a>
          </div>
        </article>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div>© {new Date().getFullYear()} TradeVerdicts. Independent sports trade analysis and archive.</div>
        <div>
          <a href="/">Home</a>
          <a href="/search">Search</a>
          <a href="/players">Players</a>
          <a href="/teams">Teams</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
          <a href="/privacy-policy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/methodology">Methodology</a>
          <a href="/corrections">Corrections</a>
          <a href="/advertising">Advertising</a>
          <a href="/faq">FAQ</a>
        </div>
      </div>
    </footer>
  </body>
</html>

