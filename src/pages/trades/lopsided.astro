  { year: "1995", label: "Buccaneers land Warren Sapp", slug: "1995-1st-round-pick-12th-overall-philadelphia-eagles-1995" },
  { year: "1995", label: "Broncos get Terrell Davis pick", slug: "draft-pick-trade-denver-broncos-1995" },
  { year: "1994", label: "Broncos turn Arthur Marshall into Tom Nalen", slug: "1994-7th-round-pick-218th-overall-tom-nalen-new-york-giants-1994" },
  { year: "1993", label: "Saints land Willie Roaf", slug: "saints-1993-04-25-detroit-lions-1993-first-round-pick-8-william-roaf-willie-roaf" },
  { year: "1992", label: "Packers land Brett Favre", slug: "1992-first-round-pick-17-kevin-smith-rey-green-bay-packers-1992" },
  { year: "1992", label: "Cowboys steal Charles Haley", slug: "1993-third-round-pick-pick-was-exercised-at-end-of-second-round-when-dallas-cowboys-1992" },
  { year: "1989", label: "Cowboys win Herschel Walker blockbuster", slug: "herschel-walker-dallas-cowboys-1989" },
  { year: "1987", label: "49ers get Steve Young", slug: "steve-young-tampa-bay-buccaneers-1987" },
  { year: "1985", label: "49ers trade up for Jerry Rice", slug: "1985-first-round-pick-16-jerry-rice-sr-new-england-patriots-1985" },
  { year: "1980", label: "Raiders land Howie Long pick", slug: "1981-first-round-pick-21-ted-watts-houston-oilers-tennessee-titans-1980" },
  { year: "1976", label: "Seahawks get Steve Largent", slug: "steve-largent-tennessee-titans-houston-oilers-1976" },
  { year: "1976", label: "Oilers win the John Hadl / Lynn Dickey trade", slug: "lynn-dickey-tennessee-titans-1976" },
  { year: "1970", label: "Dolphins get Paul Warfield", slug: "paul-warfield-browns-1970" },
  { year: "1967", label: "Raiders get Daryle Lamonica", slug: "daryle-lamonica-buffalo-bills-1967" },
  { year: "1967", label: "Raiders steal Willie Brown", slug: "rex-mirich-oakland-raiders-1967" },
  { year: "1964", label: "Jets land Joe Namath pick", slug: "first-round-pick-2-joe-namath-houston-oilers-tennessee-titans-1964" },
  { year: "1964", label: "Washington gets Sonny Jurgensen", slug: "sonny-jurgensen-philadelphia-eagles-1964" },
  { year: "1957", label: "Packers get Ray Nitschke pick", slug: "1958-third-round-pick-36-ray-nitschke-new-york-giants-1957" },
];

const activeTrades = trades.filter(isActiveTrade);
const tradeBySlug = new Map(activeTrades.map((trade) => [trade.slug, trade]));

const lopsidedTrades = lopsidedWins
  .map((item) => {
    const trade = tradeBySlug.get(item.slug);
    return trade ? { ...trade, curatedYear: item.year, curatedLabel: item.label } : null;
  })
  .filter(Boolean);

const formatTeamName = (slug = "") =>
  String(slug)
    .split("-")
    .filter(Boolean)
    .map((word) =>
      word === "49ers" ? "49ers" : word.charAt(0).toUpperCase() + word.slice(1)
    )
    .join(" ");
---

<BaseLayout title="Lopsided Wins | TradeVerdicts">
  <main>
    <section class="hero">
      <p class="eyebrow">Browse by angle</p>
      <h1>Lopsided Wins</h1>
      <p>
        50 notable NFL trades where hindsight produced a clear winner, sorted newest to oldest.
      </p>
    </section>

    <section class="trade-list">
      {lopsidedTrades.map((trade) => (
        <a class="trade-card lopsided-card" href={`/trades/${trade.slug}/`}>
          <div class="trade-topline">
            <strong>{trade.curatedLabel}</strong>
            <span>{trade.curatedYear}</span>
          </div>

          <div class="teams">
            {(trade.teams || []).map(formatTeamName).join(" vs ")}
          </div>

          <div class="summary">
            {trade.summary}
          </div>

          <div class="meta">
            <span>{trade.verdict}</span>
            <span>Confidence: {trade.confidence}</span>
          </div>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
main {
  max-width: 1120px;
  margin: 0 auto;
  padding: 48px 24px 80px;
}

.hero {
  margin-bottom: 26px;
}

.eyebrow {
  color: var(--accent);
  font-size: 0.78rem;
  font-weight: 900;
  letter-spacing: 0.08em;
  margin: 0 0 8px;
  text-transform: uppercase;
}

h1 {
  margin: 0 0 8px;
  color: white;
  font-size: clamp(2rem, 5vw, 4rem);
  letter-spacing: -0.04em;
}

p {
  color: var(--muted);
  margin: 0;
}

.trade-list {
  display: grid;
  gap: 14px;
}

.trade-card {
  display: block;
  padding: 18px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--panel);
  color: inherit;
  text-decoration: none;
  transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
}

.trade-card:hover {
  border-color: var(--accent);
  background: rgba(78, 161, 255, 0.07);
  transform: translateY(-1px);
}

.lopsided-card {
  position: relative;
}

.trade-topline {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 8px;
}

.trade-topline strong {
  color: white;
}

.trade-topline span {
  color: white;
  white-space: nowrap;
}

.teams {
  color: white;
  font-weight: 800;
  margin-bottom: 14px;
}

.summary {
  color: #bfe0ff;
  line-height: 1.55;
  margin-bottom: 14px;
}

.meta {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  color: #9ec8f2;
  font-size: 0.85rem;
}

@media (max-width: 700px) {
  main {
    padding: 34px 18px 64px;
  }

  .trade-topline,
  .meta {
    flex-direction: column;
    gap: 6px;
  }

  .trade-card {
    padding: 16px;
  }
}
</style>
