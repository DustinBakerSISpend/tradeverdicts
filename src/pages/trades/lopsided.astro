---
import BaseLayout from "../../layouts/BaseLayout.astro";
import trades from "../../data/nfl/trades.json";

const isActiveTrade = (trade) =>
  trade &&
  trade.suppressed !== true &&
  !["suppressed", "hidden", "hold-conflict"].includes(
    String(trade.publishStatus || "").toLowerCase()
  );

const lopsidedWins = [
  { year: "2023", label: "Bears win the Bryce Young / Panthers haul", slug: "panthers-chicago-bears-trade-2023-0093" },
  { year: "2023", label: "Packers win the Aaron Rodgers exit", slug: "aaron-rodgers-2023-1st-round-pick-15th-overall-will-mcdonald-and-2023-5th-round-pick-170th" },
  { year: "2022", label: "Seahawks fleece Broncos in Russell Wilson deal", slug: "drew-lock-shelby-harris-noah-fant-2022-1st-roun-denver-broncos-2022" },
  { year: "2022", label: "Eagles land A.J. Brown", slug: "eagles-2022-04-28-tennessee-titans-0434" },
  { year: "2020", label: "Cardinals steal DeAndre Hopkins", slug: "cardinals-2020-03-16-houston-texans-deandre-hopkins-and-2020-4th-round-pick-131st-overall-rasha" },
  { year: "2020", label: "Jets win the Jamal Adams haul", slug: "jamal-adams-new-york-jets-2020" },
  { year: "2020", label: "Buccaneers get Rob Gronkowski", slug: "rob-gronkowski-new-england-patriots-2020" },
  { year: "2019", label: "Steelers land Minkah Fitzpatrick", slug: "minkah-fitzpatrick-2020-4th-round-pick-135th-overall-kevin-dotson-miami-dolphins-2019" },
  { year: "2018", label: "Colts turn Jets move-up into Quenton Nelson haul", slug: "2018-1st-round-pick-6th-overall-quenton-nelson-2018-2nd-round-pick-37th-overall" },
  { year: "2017", label: "Chiefs trade up for Patrick Mahomes", slug: "2017-1st-round-pick-27th-overall-tre-davious-white-2017-3rd-round-pick-91st-over" },
  { year: "2016", label: "Chiefs land Chris Jones", slug: "2016-2nd-round-pick-37th-overall-san-francisco-49ers-2016" },
  { year: "2013", label: "Browns cash out Trent Richardson", slug: "2014-1st-round-pick-26th-overall-subsequently-traded-marcus-smith-baltimore-indi" },
  { year: "2012", label: "Rams win the RGIII draft haul", slug: "2012-1st-round-pick-6th-overall-subsequently-traded-morris-claiborne-2012-2nd-ro" },
  { year: "2012", label: "Seahawks land Bobby Wagner", slug: "2012-2nd-round-pick-47th-overall-bobby-wagner-new-york-jets-2012" },
  { year: "2011", label: "Eagles end up with Jason Kelce", slug: "eagles-2011-04-29-baltimore-ravens-0348" },
  { year: "2010", label: "Seahawks get Marshawn Lynch", slug: "marshawn-lynch-buffalo-bills-2010" },
  { year: "2009", label: "Seahawks turn pick into Earl Thomas", slug: "2010-1st-round-pick-14th-overall-earl-thomas-denver-broncos-2009" },
  { year: "2007", label: "Patriots get Randy Moss", slug: "2007-4th-round-pick-110th-overall-new-england-patriots-2007" },
  { year: "2005", label: "Raiders win the Randy Moss trade", slug: "napoleon-harris-2005-1st-round-pick-7th-overall-troy-williamson-las-vegas-oaklan" },
  { year: "2004", label: "Terrell Owens deal burns the 49ers", slug: "brandon-whiting-philadelphia-eagles-baltimore-ravens-2004" },
  { year: "2003", label: "Steelers trade up for Troy Polamalu", slug: "2003-1st-round-pick-16th-overall-troy-polamalu-kansas-city-chiefs-2003" },
  { year: "2003", label: "Patriots land Vince Wilfork pick", slug: "2003-2nd-round-pick-41st-overall-subsequently-traded-bennie-joppru-and-2004-1st-round-pick" },
  { year: "2002", label: "Chiefs get Willie Roaf", slug: "willie-roaf-new-orleans-saints-2002" },
  { year: "2000", label: "Patriots acquire Bill Belichick", slug: "bill-belichick-new-york-jets-2000" },
  { year: "2000", label: "Seahawks win Joey Galloway trade", slug: "joey-galloway-seattle-seahawks-2000" },
  { year: "2000", label: "Packers get Ahman Green", slug: "fred-vinson-green-bay-packers-2000" },
  { year: "1999", label: "Washington wins Ricky Williams haul", slug: "1999-1st-round-pick-12th-overall-subsequently-traded-cade-mcnown-1999-3rd-round-pick-71st" },
  { year: "1999", label: "Rams get Marshall Faulk", slug: "marshall-faulk-indianapolis-colts-1999" },
  { year: "1999", label: "Ravens land Jamal Lewis pick", slug: "1999-2nd-round-pick-42nd-overall-baltimore-ravens-1999" },
  { year: "1998", label: "Cardinals win the Ryan Leaf move-up", slug: "1998-1st-round-pick-2nd-overall-ryan-leaf-arizonast-louis-cardinals-1998" },
  { year: "1998", label: "Jaguars turn Rob Johnson into Fred Taylor", slug: "1998-1st-round-pick-9th-overall-buffalo-bills-1998" },
