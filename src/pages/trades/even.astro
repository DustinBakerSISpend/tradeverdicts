];

const activeTrades = trades.filter(isActiveTrade);
const tradeBySlug = new Map(activeTrades.map((trade) => [trade.slug, trade]));

const curatedEvenTrades = evenTrades
  .map((item) => {
    const trade = tradeBySlug.get(item.slug);
    return trade ? { ...trade, curatedYear: item.year, curatedLabel: item.label } : null;
  })
  .filter(Boolean);

const formatTeamName = (slug = "") =>
  String(slug)
    .split("-")
    .filter(Boolean)
    .map((word) =>
      word === "49ers" ? "49ers" : word.charAt(0).toUpperCase() + word.slice(1)
    )
    .join(" ");
---

<BaseLayout title="Even Trades | TradeVerdicts">
  <main>
    <section class="hero">
      <p class="eyebrow">Browse by angle</p>
      <h1>Even Trades</h1>
      <p>
        {curatedEvenTrades.length} notable NFL trades where hindsight keeps both sides close, sorted newest to oldest.
      </p>
    </section>

    <section class="trade-list">
      {curatedEvenTrades.map((trade) => (
        <a class="trade-card" href={`/trades/${trade.slug}/`}>
          <div class="trade-topline">
            <strong>{trade.curatedLabel}</strong>
            <span>{trade.curatedYear}</span>
          </div>

          <div class="teams">
            {(trade.teams || []).map(formatTeamName).join(" vs ")}
          </div>

          <div class="summary">
            {trade.summary}
          </div>

          <div class="meta">
            <span>{trade.verdict}</span>
            <span>Confidence: {trade.confidence}</span>
          </div>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
main {
  max-width: 1120px;
  margin: 0 auto;
  padding: 48px 24px 80px;
}

.hero {
  margin-bottom: 26px;
}

.eyebrow {
  color: var(--accent);
  font-size: 0.78rem;
  font-weight: 900;
  letter-spacing: 0.08em;
  margin: 0 0 8px;
  text-transform: uppercase;
}

h1 {
  margin: 0 0 8px;
  color: white;
  font-size: clamp(2rem, 5vw, 4rem);
  letter-spacing: -0.04em;
}

p {
  color: var(--muted);
  margin: 0;
}

.trade-list {
  display: grid;
  gap: 14px;
}

.trade-card {
  display: block;
  padding: 18px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--panel);
  color: inherit;
  text-decoration: none;
  transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
}

.trade-card:hover {
  border-color: var(--accent);
  background: rgba(78, 161, 255, 0.07);
  transform: translateY(-1px);
}

.trade-topline {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 8px;
}

.trade-topline strong {
  color: white;
}

.trade-topline span {
  color: white;
  white-space: nowrap;
}

.teams {
  color: white;
  font-weight: 800;
  margin-bottom: 14px;
}

.summary {
  color: #bfe0ff;
  line-height: 1.55;
  margin-bottom: 14px;
}

.meta {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  color: #9ec8f2;
  font-size: 0.85rem;
}

@media (max-width: 700px) {
  main {
    padding: 34px 18px 64px;
  }

  .trade-topline,
  .meta {
    flex-direction: column;
    gap: 6px;
  }

  .trade-card {
    padding: 16px;
  }
}
</style>
