---
import BaseLayout from "../../layouts/BaseLayout.astro";
import trades from "../../data/nfl/trades.json";

const curatedBlockbusters = [
  {
    "title": "Herschel Walker to the Vikings",
    "kicker": "Dynasty-shaping return",
    "why": "The classic franchise-altering trade: Minnesota got the star name, Dallas got the foundation of a dynasty.",
    "slug": "herschel-walker-dallas-cowboys-1989"
  },
  {
    "title": "John Elway rights to the Broncos",
    "kicker": "Franchise QB rights",
    "why": "Denver landed the quarterback who defined its next era after Baltimore/Indianapolis lost leverage.",
    "slug": "rights-to-john-elway-baltimore-indianapolis-colts-1983"
  },
  {
    "title": "Russell Wilson to the Broncos",
    "kicker": "Modern QB overpay",
    "why": "Denver paid a massive package for a short-lived quarterback bet while Seattle sold at the perfect time.",
    "slug": "drew-lock-shelby-harris-noah-fant-2022-1st-roun-denver-broncos-2022"
  },
  {
    "title": "Matthew Stafford for Jared Goff",
    "kicker": "Rare win-win blockbuster",
    "why": "The Rams got a Super Bowl quarterback, while Detroit turned the return into a long-term roster reset.",
    "slug": "matthew-stafford-detroit-lions-2021"
  },
  {
    "title": "Ricky Williams draft haul",
    "kicker": "All-in draft gamble",
    "why": "Mike Ditka's Saints sent a massive package to Washington for one running back.",
    "slug": "1999-1st-round-pick-12th-overall-subsequently-traded-cade-mcnown-1999-3rd-round-pick-71st"
  },
  {
    "title": "Eric Dickerson three-team trade",
    "kicker": "Three-team star RB deal",
    "why": "A rare three-team blockbuster involving Dickerson, Cornelius Bennett, major picks, and multiple franchises.",
    "slug": "greg-bell-leon-owen-gill-1988-first-round-pick-from-bills-14-gaston-green-1988-f"
  },
  {
    "title": "Marshall Faulk to the Rams",
    "kicker": "Greatest Show on Turf fuel",
    "why": "St. Louis paid a modest price for a Hall of Fame back who became central to an all-time offense.",
    "slug": "marshall-faulk-indianapolis-colts-1999"
  },
  {
    "title": "Khalil Mack to the Bears",
    "kicker": "Two-firsts edge swing",
    "why": "Chicago bought an instant defensive superstar, while the Raiders failed to turn the haul into equal value.",
    "slug": "2019-1st-round-pick-24th-overall-chicago-bears-2018"
  },
  {
    "title": "Jalen Ramsey to the Rams",
    "kicker": "Win-now cornerback bet",
    "why": "Los Angeles paid two first-round picks and still won because Ramsey became a championship-level piece.",
    "slug": "carson-wentz-philadelphia-eagles-2021"
  },
  {
    "title": "Brett Favre to the Packers",
    "kicker": "Franchise QB steal",
    "why": "Green Bay turned one first-round pick into a Hall of Fame quarterback and a new franchise era.",
    "slug": "1992-first-round-pick-17-kevin-smith-rey-green-bay-packers-1992"
  },
  {
    "title": "Joe Montana to the Chiefs",
    "kicker": "Late-career legend move",
    "why": "Kansas City acquired instant credibility and short-window contention from an all-time quarterback.",
    "slug": "joe-montana-san-francisco-49ers-1993"
  },
  {
    "title": "Steve Young to the 49ers",
    "kicker": "Successor QB jackpot",
    "why": "San Francisco bought low on a future Hall of Fame quarterback before he became the post-Montana answer.",
    "slug": "steve-young-tampa-bay-buccaneers-1987"
  },
  {
    "title": "Deshaun Watson to the Browns",
    "kicker": "Guaranteed-contract disaster",
    "why": "Cleveland surrendered a huge pick package and contract commitment while Houston escaped with premium value.",
    "slug": "deshaun-watson-and-2024-6th-round-pick-203rd-overall-subsequently-traded-will-re"
  },
  {
    "title": "Robert Griffin III draft trade",
    "kicker": "QB draft mega-package",
    "why": "Washington paid a massive package for RG3, while the Rams captured the stronger long-term asset result.",
    "slug": "2012-1st-round-pick-6th-overall-subsequently-traded-morris-claiborne-2012-2nd-ro"
  },
  {
    "title": "DeAndre Hopkins to the Cardinals",
    "kicker": "Modern receiver shocker",
    "why": "Arizona acquired an elite wide receiver while Houston accepted a return that became instantly infamous.",
    "slug": "cardinals-2020-03-16-houston-texans-deandre-hopkins-and-2020-4th-round-pick-131st-overall-rasha"
  }
];

const isActiveTrade = (trade) =>
  trade &&
  trade.suppressed !== true &&
  !["suppressed", "hidden", "hold-conflict"].includes(
    String(trade.publishStatus || "").toLowerCase()
  );

const activeTrades = trades.filter(isActiveTrade);
const tradeBySlug = new Map(activeTrades.map((trade) => [trade.slug, trade]));

const formatTeamName = (slug = "") =>
  String(slug)
    .split("-")
    .filter(Boolean)
    .map((word) =>
      word === "49ers" ? "49ers" : word.charAt(0).toUpperCase() + word.slice(1)
    )
    .join(" ");

const trimSummary = (summary = "", limit = 210) => {
  const clean = String(summary || "").replace(/\s+/g, " ").trim();

  if (clean.length <= limit) return clean;

  return `${clean.slice(0, limit).replace(/\s+\S*$/, "")}...`;
};

const getGradeClass = (grade = "") => {
  const letter = String(grade).trim().charAt(0).toUpperCase();

  if (letter === "A") return "grade-a";
  if (letter === "B") return "grade-b";
  if (letter === "C") return "grade-c";
  if (letter === "D") return "grade-d";
  if (letter === "F") return "grade-f";

  return "grade-neutral";
};

const getVisibleGrades = (trade) => {
  const grades = trade?.grades || {};
  const teams = trade?.teams || [];

  return teams
    .map((team) => ({
      team,
      teamName: formatTeamName(team),
      grade: grades[team],
    }))
    .filter((item) => item.grade)
    .slice(0, 3);
};

const blockbusterCards = curatedBlockbusters
  .map((item) => ({
    ...item,
    trade: tradeBySlug.get(item.slug),
  }))
  .filter((item) => item.trade);
---

<BaseLayout title="NFL Blockbuster Trades | TradeVerdicts">
  <main class="blockbuster-shell">
    <section class="blockbuster-hero">
      <a class="back-link" href="/">? Back to home</a>
      <p class="eyebrow">Curated NFL trade collection</p>
      <h1>Blockbuster NFL trades that changed franchises.</h1>
      <p>
        These are the franchise-shaping moves: quarterback rights fights, massive draft hauls,
        win-now star swings, and trades that still define how fans talk about roster building.
      </p>
      <div class="hero-stats" aria-label="Blockbuster page stats">
        <span><strong>{blockbusterCards.length}</strong> curated blockbusters</span>
        <span><strong>Premium</strong> trade pages only</span>
        <span><strong>Ready</strong> for public launch</span>
      </div>
    </section>

    <section class="blockbuster-grid" aria-label="Curated blockbuster NFL trades">
      {blockbusterCards.map((item) => {
        const grades = getVisibleGrades(item.trade);

        return (
          <a class="blockbuster-card" href={"/trades/" + item.trade.slug + "/"}>
            <div class="card-topline">
              <span>{item.kicker}</span>
              <strong>{item.trade.verdict}</strong>
            </div>

            <h2>{item.title}</h2>
            <p>{item.why}</p>
            <p class="summary">{trimSummary(item.trade.summary)}</p>

            <div class="grade-row">
              {grades.map((grade) => (
                <span class={getGradeClass(grade.grade)}>
                  <b>{grade.grade}</b>
                  <small>{grade.teamName}</small>
                </span>
              ))}
            </div>
          </a>
        );
      })}
    </section>

    <section class="method-note">
      <h2>Why these trades count as blockbusters</h2>
      <p>
        TradeVerdicts treats a blockbuster as more than a famous name. The trade has to change a
        team's direction, involve major draft or player value, reshape a championship window, or
        remain historically searchable years later.
      </p>
      <a href="/methodology">Read the grading methodology ?</a>
    </section>
  </main>
</BaseLayout>

<style>
  .blockbuster-shell {
    max-width: 1120px;
    margin: 0 auto;
    padding: 32px 18px 64px;
  }

  .blockbuster-hero,
  .method-note,
  .blockbuster-card {
    border: 1px solid rgba(90, 132, 190, 0.28);
    background: linear-gradient(180deg, rgba(18, 28, 42, 0.96), rgba(12, 20, 31, 0.96));
    border-radius: 18px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
  }

  .blockbuster-hero {
    padding: 30px;
    margin-bottom: 22px;
  }

  .back-link {
    display: inline-flex;
    color: #57a6ff;
    font-weight: 800;
    font-size: 13px;
    margin-bottom: 22px;
    text-decoration: none;
  }

  .eyebrow {
    margin: 0 0 10px;
    color: #3b9cff;
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .blockbuster-hero h1 {
    max-width: 760px;
    margin: 0;
    color: #f7fbff;
    font-size: clamp(34px, 5vw, 58px);
    line-height: 0.94;
    letter-spacing: -0.06em;
  }

  .blockbuster-hero p {
    max-width: 760px;
    color: #bdd0e5;
    line-height: 1.7;
    margin: 18px 0 0;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .hero-stats span {
    border: 1px solid rgba(87, 166, 255, 0.28);
    border-radius: 999px;
    padding: 9px 12px;
    color: #a9bfd7;
    font-size: 12px;
    font-weight: 800;
  }

  .hero-stats strong {
    color: #ffffff;
  }

  .blockbuster-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .blockbuster-card {
    display: flex;
    flex-direction: column;
    min-height: 290px;
    padding: 18px;
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      background 0.18s ease;
  }

  .blockbuster-card:hover {
    transform: translateY(-2px);
    border-color: rgba(87, 166, 255, 0.75);
    background: rgba(20, 33, 50, 0.98);
  }

  .card-topline {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
    color: #70b7ff;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-topline strong {
    color: #dcecff;
    letter-spacing: 0;
    text-transform: none;
    text-align: right;
  }

  .blockbuster-card h2 {
    margin: 0;
    color: #ffffff;
    font-size: 20px;
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .blockbuster-card p {
    color: #bdd0e5;
    line-height: 1.55;
    margin: 12px 0 0;
    font-size: 14px;
  }

  .blockbuster-card .summary {
    color: #8fa3bd;
    font-size: 13px;
  }

  .grade-row {
    display: flex;
    gap: 10px;
    margin-top: auto;
    padding-top: 18px;
    flex-wrap: wrap;
  }

  .grade-row span {
    display: grid;
    gap: 2px;
    min-width: 78px;
  }

  .grade-row b {
    font-size: 22px;
    line-height: 1;
  }

  .grade-row small {
    color: #8fa3bd;
    font-size: 10px;
    line-height: 1.2;
  }

  .grade-a {
    color: #35f49b;
  }

  .grade-b {
    color: #4db3ff;
  }

  .grade-c {
    color: #f5f871;
  }

  .grade-d,
  .grade-f {
    color: #ff5570;
  }

  .grade-neutral {
    color: #dcecff;
  }

  .method-note {
    margin-top: 18px;
    padding: 22px;
  }

  .method-note h2 {
    margin: 0 0 10px;
    color: #ffffff;
    font-size: 20px;
    letter-spacing: -0.03em;
  }

  .method-note p {
    margin: 0;
    color: #bdd0e5;
    line-height: 1.7;
    max-width: 820px;
  }

  .method-note a {
    display: inline-flex;
    margin-top: 14px;
    color: #57a6ff;
    font-size: 13px;
    font-weight: 900;
    text-decoration: none;
  }

  @media (max-width: 980px) {
    .blockbuster-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .blockbuster-shell {
      padding: 18px 12px 44px;
    }

    .blockbuster-hero {
      padding: 22px;
    }

    .blockbuster-grid {
      grid-template-columns: 1fr;
    }

    .card-topline {
      display: grid;
    }

    .card-topline strong {
      text-align: left;
    }
  }
</style>
