---
import BaseLayout from "../../layouts/BaseLayout.astro";
import trades from "../../data/nfl/trades.json";
import players from "../../data/nfl/players.json";
import tradeOverrides from "../../data/nfl/trade-overrides.json";
import {
  createEligibilityContext,
  getPublicPlayerRecords,
  getPublicTrades,
  getTradeEligibility,
} from "../../utils/publicRecords.js";
import {
  getTeamDisplayName,
  getTeamRouteSlug,
} from "../../utils/teamRegistry.js";

const tradeEligibilityContext = createEligibilityContext(trades);

export function getStaticPaths() {
  const staticPublicTrades = getPublicTrades(trades);
  const staticPublicPlayers = getPublicPlayerRecords(
    players,
    staticPublicTrades
  );

  const escapeStaticRegex = (value) =>
    String(value || "").replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

  const playersByFirstToken = new Map();

  for (const player of staticPublicPlayers) {
    const name = String(player.name || "").trim();
    const slug = String(player.slug || "").trim();
    const firstToken = name.match(/[A-Za-z0-9]+/)?.[0]?.toLowerCase();

    if (!name || !slug || !firstToken) continue;

    const entry = {
      name,
      slug,
      matcher: new RegExp(`\\b${escapeStaticRegex(name)}\\b`),
    };

    const bucket = playersByFirstToken.get(firstToken) || [];
    bucket.push(entry);
    playersByFirstToken.set(firstToken, bucket);
  }

  return staticPublicTrades.map((trade) => {
    const assetTexts = Object.values(trade.assetsReceived || {})
      .flatMap((items) => (Array.isArray(items) ? items : []))
      .map((item) => String(item?.asset || ""))
      .filter(Boolean);

    const assetTokens = new Set(
      assetTexts.flatMap((text) =>
        [...text.matchAll(/[A-Za-z0-9]+/g)].map((match) =>
          match[0].toLowerCase()
        )
      )
    );

    const matchedPlayers = new Map();

    for (const token of assetTokens) {
      const candidates = playersByFirstToken.get(token) || [];

      for (const candidate of candidates) {
        if (assetTexts.some((text) => candidate.matcher.test(text))) {
          matchedPlayers.set(candidate.name, {
            name: candidate.name,
            slug: candidate.slug,
          });
        }
      }
    }

    return {
      params: { slug: trade.slug },
      props: {
        trade,
        playerLinks: [...matchedPlayers.values()],
      },
    };
  });
}
const { trade, playerLinks = [] } = Astro.props;
const tradeEligibility = getTradeEligibility(
  trade,
  tradeEligibilityContext
);
const override = tradeOverrides.find((item) => item.slug === trade.slug);

const heroTitleOverride = override?.headline || "";
const heroSummary = override?.dek || trade.summary;

const normalizePublicCopy = (value) =>
  String(value || "")
    .replace(/\s+/g, " ")
    .trim();

const tradeOverridesBySlug = new Map(
  tradeOverrides.map((item) => [item.slug, item])
);

const getBasePageTitle = (item) => {
  const itemOverride = tradeOverridesBySlug.get(item.slug);

  if (itemOverride?.seoTitle) {
    return normalizePublicCopy(itemOverride.seoTitle);
  }

  const source = normalizePublicCopy(
    itemOverride?.dek || item.summary || item.verdict || item.slug
  );
  const limit = 62;
  const subject =
    source.length <= limit
      ? source
      : `${source.slice(0, limit).replace(/\s+\S*$/, "")}…`;

  return `${subject || item.verdict} | TradeVerdicts`;
};

const pageTitleGroups = new Map();

for (const item of getPublicTrades(trades)) {
  const baseTitle = getBasePageTitle(item);
  const bucket = pageTitleGroups.get(baseTitle) || [];
  bucket.push(item.slug);
  pageTitleGroups.set(baseTitle, bucket);
}

for (const bucket of pageTitleGroups.values()) {
  bucket.sort((a, b) => a.localeCompare(b));
}

const basePageTitle = getBasePageTitle(trade);
const pageTitleGroup = pageTitleGroups.get(basePageTitle) || [trade.slug];
const pageTitlePosition = Math.max(1, pageTitleGroup.indexOf(trade.slug) + 1);
const pageTitle =
  pageTitleGroup.length > 1
    ? /\s*\|\s*TradeVerdicts$/.test(basePageTitle)
      ? basePageTitle.replace(
          /\s*\|\s*TradeVerdicts$/,
          ` #${pageTitlePosition} | TradeVerdicts`
        )
      : `${basePageTitle} #${pageTitlePosition}`
    : basePageTitle;

const heroTitle =
  heroTitleOverride ||
  pageTitle.replace(/\s*\|\s*TradeVerdicts$/i, "").trim();

const showTradeSummary =
  Boolean(trade.summary) &&
  normalizePublicCopy(trade.summary) !== normalizePublicCopy(heroSummary);

const showTradeAnalysis = Boolean(trade.analysis);

const sourceUrls = Array.from(
  new Set(
    (Array.isArray(trade.sourceUrls) ? trade.sourceUrls : [])
      .map((value) => String(value || "").trim())
      .filter(Boolean)
      .filter((value) => {
        try {
          const parsed = new URL(value);

          if (!["http:", "https:"].includes(parsed.protocol)) {
            return false;
          }

          const host = parsed.hostname
            .toLowerCase()
            .replace(/^www\./, "");

          return !(
            host === "tradeverdicts.com" ||
            host.endsWith(".tradeverdicts.com")
          );
        } catch {
          return false;
        }
      })
  )
);

const sourceLinks = sourceUrls.map((url) => {
  const parsed = new URL(url);
  const host = parsed.hostname.replace(/^www\./, "");

  return {
    url,
    label: host,
  };
});

const formatTeamName = getTeamDisplayName;

const getTeamHref = (slug) => {
  const routeSlug = getTeamRouteSlug(slug);

  return routeSlug ? `/teams/${routeSlug}/` : "/teams/";
};

const formatDate = (dateString) => {
  return new Date(dateString).toLocaleDateString("en-US", {
    timeZone: "UTC",
    month: "long",
    day: "numeric",
    year: "numeric",
  });
};

const formatConfidence = (value) =>
  String(value || "")
    .trim()
    .replace(/\b\w/g, (character) => character.toUpperCase());

const escapeRegex = (string) =>
  string.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

const playerMap = new Map(playerLinks.map((player) => [player.name, player.slug]));
const sortedPlayerNames = [...playerMap.keys()].sort((a, b) => b.length - a.length);


const normalizeRenderedAsset = (item) =>
  String(item?.asset || "")
    .toLowerCase()
    .replace(/\s+/g, " ")
    .replace(/[()]/g, "")
    .replace(/\s+,/g, ",")
    .trim();

const normalizeSelectedPlayerName = (value) =>
  String(value || "")
    .normalize("NFKD")
    .replace(/\p{Diacritic}/gu, "")
    .replace(/[’']/g, "")
    .replace(/\b(jr|sr|ii|iii|iv|v)\b\.?/gi, "")
    .replace(/[^a-z0-9]+/gi, " ")
    .replace(/\s+/g, " ")
    .toLowerCase()
    .trim();

const cleanSelectedPlayerName = (value) => {
  const name = String(value || "")
    .replace(/^player\s*:\s*/i, "")
    .replace(/\s+\((QB|RB|FB|WR|TE|OT|T|OG|G|C|DE|DT|DL|EDGE|LB|ILB|OLB|CB|S|FS|SS|K|P|LS)\)$/i, "")
    .replace(/,\s*(QB|RB|FB|WR|TE|OT|T|OG|G|C|DE|DT|DL|EDGE|LB|ILB|OLB|CB|S|FS|SS|K|P|LS)$/i, "")
    .replace(/\s+/g, " ")
    .trim();

  if (!/[A-Za-z]/.test(name)) return "";
  if (/\b(round|overall|draft|pick|conditional|cash|considerations?)\b/i.test(name)) return "";

  const wordCount = name.split(/\s+/).filter(Boolean).length;
  if (wordCount < 2 || wordCount > 6) return "";

  return name;
};

const isPickAsset = (item) => {
  const type = String(item?.type || "").toLowerCase();
  const asset = String(item?.asset || "");

  return (
    type === "pick" ||
    /\b\d{4}\s+\d+(?:st|nd|rd|th)\s+round pick\b/i.test(asset) ||
    /\b\d+(?:st|nd|rd|th)\s+round pick\b/i.test(asset) ||
    /\b\d+(?:st|nd|rd|th)\s+overall\b/i.test(asset) ||
    /\bdraft pick\b/i.test(asset)
  );
};

const isPlayerAsset = (item) => {
  const type = String(item?.type || "").toLowerCase();
  return type === "player";
};

const pickIdentityFromAsset = (item) => {
  const asset = String(item?.asset || "");

  const match = asset.match(
    /\b(\d{4})\s+(\d+)(?:st|nd|rd|th)\s+round pick\s*\(\s*(\d+)(?:st|nd|rd|th)\s+overall\b/i
  );

  if (!match) return "";

  const [, year, round, overall] = match;
  return `${year}:${round}:${overall}`;
};

const selectedPlayerFromPickAsset = (item) => {
  const asset = String(item?.asset || "");

  const match = asset.match(
    /\(\s*\d+(?:st|nd|rd|th)\s+overall(?:\s+subsequently traded)?\s*[,;]\s*([A-Z][A-Za-z.'’\-]+(?:\s+[A-Z][A-Za-z.'’\-]+){1,5})\s*\)/i
  );

  return cleanSelectedPlayerName(match?.[1]);
};

const getUniqueAssetsForTeam = (trade, team) => {
  const items = trade.assetsReceived?.[team] || [];
  const seen = new Set();

  const uniqueItems = items.filter((item) => {
    const signature = normalizeRenderedAsset(item);

    if (!signature) return true;
    if (seen.has(signature)) return false;

    seen.add(signature);
    return true;
  });

  const selectedPlayerNamesShownInPicks = new Set(
    uniqueItems
      .filter(isPickAsset)
      .map(selectedPlayerFromPickAsset)
      .filter(Boolean)
      .map(normalizeSelectedPlayerName)
  );

  const pickIdentitiesWithSelectedPlayers = new Set(
    uniqueItems
      .filter(isPickAsset)
      .filter((item) => selectedPlayerFromPickAsset(item))
      .map(pickIdentityFromAsset)
      .filter(Boolean)
  );

  return uniqueItems.filter((item) => {
    if (isPlayerAsset(item)) {
      const playerName = cleanSelectedPlayerName(item.asset);
      if (!playerName) return true;

      return !selectedPlayerNamesShownInPicks.has(
        normalizeSelectedPlayerName(playerName)
      );
    }

    if (isPickAsset(item) && !selectedPlayerFromPickAsset(item)) {
      const pickIdentity = pickIdentityFromAsset(item);

      if (pickIdentity && pickIdentitiesWithSelectedPlayers.has(pickIdentity)) {
        return false;
      }
    }

    return true;
  });
};

function renderAssetWithPlayerLinks(assetText) {
  const text = String(assetText || "");
  const parts = [];
  let remaining = text;

  while (remaining.length > 0) {
    const match = sortedPlayerNames
      .map((name) => {
        const regex = new RegExp(`\\b${escapeRegex(name)}\\b`);
        const found = remaining.match(regex);
        return found ? { name, index: found.index } : null;
      })
      .filter(Boolean)
      .sort((a, b) => a.index - b.index)[0];

    if (!match) {
      parts.push({ type: "text", value: remaining });
      break;
    }

    if (match.index > 0) {
      parts.push({ type: "text", value: remaining.slice(0, match.index) });
    }

    parts.push({
      type: "player",
      value: match.name,
      slug: playerMap.get(match.name),
    });

    remaining = remaining.slice(match.index + match.name.length);
  }

  return parts;
}

const teamA = trade.teams?.[0];
const teamB = trade.teams?.[1];
---

<BaseLayout
  title={pageTitle}
  description={heroSummary}
  indexEligible={tradeEligibility.indexEligible}
  adEligible={tradeEligibility.adEligible}
>
  <main>
    <section class="trade-hero">
      <div class="eyebrow">
        {override?.featured ? "Featured NFL Trade Verdict" : "NFL Trade Verdict"}
      </div>
      <h1>{heroTitle}</h1>
      <p>{heroSummary}</p>

      <div class="badges">
        <span>{formatDate(trade.tradeDate)}</span>

        <span>
          {teamA && <a href={getTeamHref(teamA)}>{formatTeamName(teamA)}</a>}
          {teamA && teamB && " - "}
          {teamB && <a href={getTeamHref(teamB)}>{formatTeamName(teamB)}</a>}
        </span>

        <span>
          <a href="/methodology/#confidence">
            Record confidence: {formatConfidence(trade.confidence)}
          </a>
        </span>

        {override?.locked && <span class="feature-badge">Editorial Locked</span>}

        {trade.publishStatus !== "ready" && (
          <span class="warning-badge">
            {trade.publishStatus === "provisional"
              ? "Provisional Record"
              : "Review Pending"}
          </span>
        )}
      </div>
    </section>

    <section class="trade-assets">
      {trade.teams.map((team) => (
        <div class="asset-panel">
          <h2>
            <a href={getTeamHref(team)}>{formatTeamName(team)}</a> Received
          </h2>

          <ul>
            {getUniqueAssetsForTeam(trade, team).map((item) => (
              <li>
                <span class="asset-type">{item.type}</span>
                {renderAssetWithPlayerLinks(item.asset).map((part) =>
                  part.type === "player" ? (
                    <a class="player-link" href={`/players/${part.slug}/`}>
                      {part.value}
                    </a>
                  ) : (
                    <span>{part.value}</span>
                  )
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="scoreboard">
      {trade.teams.map((team) => (
        <div class="team-panel">
          <h2>
            <a href={getTeamHref(team)}>{formatTeamName(team)}</a>
          </h2>
          <div class={`grade ${trade.grades[team] === "D" || trade.grades[team] === "F" ? "bad" : ""}`}>
            {trade.grades[team]}
          </div>
        </div>
      ))}
    </section>

    {(showTradeSummary || showTradeAnalysis) && (
      <section class="analysis">
        {showTradeSummary && (
          <>
            <h2>Trade Summary</h2>
            <p>{trade.summary}</p>
          </>
        )}

        {showTradeAnalysis && (
          <>
            <h2>Trade Analysis</h2>
            <div class="analysis-sections">
              {String(trade.analysis || "")
                .split(/\r?\n\s*\r?\n/)
                .map((block) => block.trim())
                .filter(Boolean)
                .map((block) => {
                  const isHeading = /^(Why |What |How |The Long-Term Legacy$|The Contract Factor$|Final Verdict$|Why This Trade Still Matters$)/.test(block);

                  return isHeading ? (
                    <h3 class="analysis-subhead">{block}</h3>
                  ) : (
                    <p>{block}</p>
                  );
                })}
            </div>
          </>
        )}
      </section>
    )}

    {sourceLinks.length > 0 && (
      <section class="analysis sources">
        <h2>Sources</h2>
        <ul>
          {sourceLinks.map((source, index) => (
            <li>
              <a
                href={source.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {source.label}{sourceLinks.length > 1 ? ` — Source ${index + 1}` : ""}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {override?.sections?.length > 0 && (
      <section class="expanded-analysis">
        <div class="expanded-label">Featured Deep Dive</div>

        {override.sections.map((section) => (
          <article>
            <h2>{section.heading}</h2>
            <p>{section.body}</p>
          </article>
        ))}
      </section>
    )}
  </main>
</BaseLayout>

<style>
  .trade-hero {
    margin-bottom: 32px;
  }

  .eyebrow {
    color: var(--accent);
    font-weight: 800;
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(2.3rem, 5vw, 4.2rem);
    margin-bottom: 14px;
  }

  a {
    color: inherit;
  }

  .player-link {
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }

  .player-link:hover,
  .asset-panel h2 a:hover,
  .team-panel h2 a:hover,
  .badges a:hover {
    text-decoration: underline;
  }

  .asset-panel h2 a,
  .team-panel h2 a,
  .badges a {
    text-decoration: none;
  }

  .trade-hero p,
  .analysis p,
  .team-panel p,
  .asset-panel li,
  .expanded-analysis p {
    color: var(--muted);
    line-height: 1.6;
  }

  .trade-hero p {
    max-width: 860px;
    margin-bottom: 22px;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .badges span {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 8px 12px;
    color: var(--muted);
    text-transform: capitalize;
  }

  .feature-badge {
    border-color: var(--accent) !important;
    color: var(--accent) !important;
    background: rgba(57, 167, 255, 0.12) !important;
  }

  .warning-badge {
    border-color: #f59e0b !important;
    color: #fbbf24 !important;
    background: rgba(245, 158, 11, 0.12) !important;
  }

  .trade-assets,
  .scoreboard {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 28px;
  }

  .asset-panel,
  .team-panel,
  .analysis,
  .expanded-analysis {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 24px;
  }

  .asset-panel h2,
  .team-panel h2,
  .analysis h2,
  .expanded-analysis h2 {
    margin-bottom: 14px;
  }

  .asset-panel ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .asset-panel li {
    margin-bottom: 10px;
  }

  .asset-type {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 3px 8px;
    margin-right: 8px;
    font-weight: 800;
  }

  .grade {
    font-size: 3rem;
    font-weight: 900;
    color: var(--good);
    margin-bottom: 12px;
  }

  .grade.bad {
    color: var(--bad);
  }

  .analysis h2:not(:first-child) {
    margin-top: 24px;
  }

  .expanded-analysis {
    margin-top: 28px;
  }

  .expanded-label {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 18px;
  }

  .expanded-analysis article:not(:last-child) {
    margin-bottom: 28px;
  }

  .expanded-analysis p {
    line-height: 1.75;
  }

  @media (max-width: 800px) {
    .trade-assets,
    .scoreboard {
      grid-template-columns: 1fr;
    }
  }

  .analysis-sections {
    display: grid;
    gap: 12px;
  }

  .analysis-subhead {
    margin: 14px 0 0;
    color: #ffffff;
    font-size: 1.05rem;
    line-height: 1.3;
    font-weight: 800;
  }

  .analysis-sections p {
    margin: 0;
    color: #bfe0ff;
    line-height: 1.65;
  }

</style>
