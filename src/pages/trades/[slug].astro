---
import BaseLayout from "../../layouts/BaseLayout.astro";
import trades from "../../data/nfl/trades.json";

export function getStaticPaths() {
  return trades.map((trade) => ({
    params: { slug: trade.slug },
    props: { trade },
  }));
}

const { trade } = Astro.props;

const teamNameMap = {
  "minnesota-vikings": "Minnesota Vikings",
  "baltimore-ravens": "Baltimore Ravens",
};

const formatTeamName = (slug) => teamNameMap[slug] || slug;

const formatDate = (dateString) => {
  return new Date(dateString).toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });
};

const teamA = trade.teams[0];
const teamB = trade.teams[1];
---

<BaseLayout title={`${trade.verdict} | TradeVerdicts`}>
  <main>
    <section class="trade-hero">
      <div class="eyebrow">NFL Trade Verdict</div>
      <h1>{trade.verdict}</h1>
      <p>{trade.summary}</p>

      <div class="badges">
  <span>{formatDate(trade.tradeDate)}</span>
  <span>{formatTeamName(teamA)} ↔ {formatTeamName(teamB)}</span>
  <span>Confidence: {trade.confidence}</span>
  <span>Tier: {trade.tier}</span>

  {trade.publishStatus !== "ready" && (
    <span class="warning-badge">
      {trade.publishStatus === "provisional"
        ? "Provisional Record"
        : "Needs Review"}
    </span>
  )}
</div>
    </section>

    <section class="trade-assets">
      {trade.teams.map((team) => (
        <div class="asset-panel">
          <h2>{formatTeamName(team)} Received</h2>

          <ul>
            {trade.assetsReceived[team]?.map((item) => (
              <li>
                <span class="asset-type">{item.type}</span>
                {item.asset}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="scoreboard">
      {trade.teams.map((team) => (
        <div class="team-panel">
          <h2>{formatTeamName(team)}</h2>
          <div class={`grade ${trade.grades[team] === "D" || trade.grades[team] === "F" ? "bad" : ""}`}>
            {trade.grades[team]}
          </div>
        </div>
      ))}
    </section>

    <section class="analysis">
      <h2>Trade Summary</h2>
      <p>{trade.summary}</p>

      <h2>Trade Analysis</h2>
      <p>{trade.analysis}</p>
    </section>
  </main>
</BaseLayout>

<style>
  .trade-hero {
    margin-bottom: 32px;
  }

  .eyebrow {
    color: var(--accent);
    font-weight: 800;
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(2.3rem, 5vw, 4.2rem);
    margin-bottom: 14px;
  }

  .trade-hero p,
  .analysis p,
  .team-panel p,
  .asset-panel li {
    color: var(--muted);
    line-height: 1.6;
  }

  .trade-hero p {
    max-width: 860px;
    margin-bottom: 22px;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .badges span {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 8px 12px;
    color: var(--muted);
    text-transform: capitalize;
  }

  .warning-badge {
  border-color: #f59e0b !important;
  color: #fbbf24 !important;
  background: rgba(245, 158, 11, 0.12) !important;
}

  .trade-assets,
  .scoreboard {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 28px;
  }

  .asset-panel,
  .team-panel,
  .analysis {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 24px;
  }

  .asset-panel h2,
  .team-panel h2,
  .analysis h2 {
    margin-bottom: 14px;
  }

  .asset-panel ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .asset-panel li {
    margin-bottom: 10px;
  }

  .asset-type {
    display: inline-block;
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 3px 8px;
    margin-right: 8px;
    font-weight: 800;
  }

  .grade {
    font-size: 3rem;
    font-weight: 900;
    color: var(--good);
    margin-bottom: 12px;
  }

  .grade.bad {
    color: var(--bad);
  }

  .analysis h2:not(:first-child) {
    margin-top: 24px;
  }

  @media (max-width: 800px) {
    .trade-assets,
    .scoreboard {
      grid-template-columns: 1fr;
    }
  }
</style>