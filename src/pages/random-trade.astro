---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Random NFL Trade Verdict | TradeVerdicts"
  indexEligible={false}
  adEligible={false}
>
  <main class="random-shell">
    <section class="random-card" aria-live="polite">
      <p class="eyebrow">NFL Trade Database</p>
      <h1>Finding a Random Trade</h1>
      <p id="randomStatus">
        Selecting a verdict from the TradeVerdicts archive...
      </p>

      <noscript>
        <p>
          JavaScript is required for the random-trade feature.
          <a href="/trades/">Browse all trades instead.</a>
        </p>
      </noscript>
    </section>
  </main>
</BaseLayout>

<script>
  const status = document.getElementById("randomStatus");
  const storageKey = "tradeverdicts-random-trade-history";
  const recentLimit = 10;

  const getRecentHistory = () => {
    try {
      const parsed = JSON.parse(
        sessionStorage.getItem(storageKey) || "[]"
      );

      return Array.isArray(parsed)
        ? parsed.filter((value) => typeof value === "string")
        : [];
    } catch {
      return [];
    }
  };

  const saveRecentHistory = (history) => {
    try {
      sessionStorage.setItem(
        storageKey,
        JSON.stringify(history.slice(0, recentLimit))
      );
    } catch {
      // Random selection still works when session storage is unavailable.
    }
  };

  const secureRandomIndex = (length) => {
    if (length <= 1) return 0;

    if (window.crypto?.getRandomValues) {
      const values = new Uint32Array(1);
      window.crypto.getRandomValues(values);
      return values[0] % length;
    }

    return Math.floor(Math.random() * length);
  };

  const loadRandomTrade = async () => {
    try {
      const response = await fetch("/api/random-trade.json", {
        headers: {
          Accept: "application/json",
        },
      });

      if (!response.ok) {
        throw new Error(
          `Random trade request failed with status ${response.status}.`
        );
      }

      const pool = await response.json();

      if (!Array.isArray(pool) || pool.length === 0) {
        throw new Error("The random trade pool is empty.");
      }

      const recentHistory = getRecentHistory();
      const recentSet = new Set(recentHistory);

      let candidates = pool.filter(
        (trade) =>
          trade &&
          typeof trade.slug === "string" &&
          !recentSet.has(trade.slug)
      );

      if (candidates.length === 0) {
        candidates = pool.filter(
          (trade) =>
            trade &&
            typeof trade.slug === "string"
        );
      }

      const selected =
        candidates[secureRandomIndex(candidates.length)];

      if (!selected?.slug) {
        throw new Error("No valid random trade was selected.");
      }

      saveRecentHistory([
        selected.slug,
        ...recentHistory.filter((slug) => slug !== selected.slug),
      ]);

      window.location.replace(
        `/trades/${encodeURIComponent(selected.slug)}/`
      );
    } catch (error) {
      status.textContent =
        "A random trade could not be selected. Please try again.";

      const retry = document.createElement("button");
      retry.type = "button";
      retry.className = "retry-button";
      retry.textContent = "Try Again";
      retry.addEventListener("click", () => {
        retry.remove();
        status.textContent =
          "Selecting another verdict from the archive...";
        loadRandomTrade();
      });

      status.insertAdjacentElement("afterend", retry);
      console.error(error);
    }
  };

  loadRandomTrade();
</script>

<style>
  .random-shell {
    display: grid;
    place-items: center;
    min-height: 58vh;
    padding: 52px 20px 80px;
  }

  .random-card {
    width: min(680px, 100%);
    border: 1px solid var(--border);
    border-left: 5px solid var(--accent);
    border-radius: 20px;
    padding: 34px;
    background:
      linear-gradient(180deg, rgba(19, 29, 42, 0.99), rgba(8, 13, 20, 0.99));
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.34);
  }

  .eyebrow {
    margin: 0 0 10px;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 14px;
    font-size: clamp(2.2rem, 6vw, 4rem);
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .random-card p {
    color: var(--muted);
    line-height: 1.65;
  }

  .random-card a {
    color: var(--accent);
  }

  :global(.retry-button) {
    margin-top: 18px;
    min-height: 42px;
    border: 1px solid var(--accent);
    border-radius: 10px;
    padding: 9px 14px;
    background: rgba(78, 161, 255, 0.16);
    color: white;
    cursor: pointer;
    font-weight: 900;
  }

  :global(.retry-button:hover) {
    background: rgba(78, 161, 255, 0.25);
  }

  @media (max-width: 620px) {
    .random-shell {
      padding: 34px 14px 64px;
    }

    .random-card {
      border-left-width: 4px;
      border-radius: 16px;
      padding: 24px 18px;
    }
  }
</style>
