---
import BaseLayout from "../../layouts/BaseLayout.astro";
import trades from "../../data/nfl/trades.json";
import { getTeamStats } from "../../utils/teamStats.js";
import { getPublicTrades } from "../../utils/publicRecords.js";
import {
  CURRENT_NFL_TEAMS,
  getTeamArchiveTrades,
} from "../../utils/teamRegistry.js";


const publicTrades = getPublicTrades(trades);
function teamStats(slug) {
  const teamTrades = getTeamArchiveTrades(
    publicTrades,
    slug
  );

  const years = teamTrades
    .map((trade) => Number(String(trade.tradeDate || "").slice(0, 4)))
    .filter(Boolean);

  return {
    ...getTeamStats(publicTrades, slug),
    yearRange: years.length ? `${Math.min(...years)}-${Math.max(...years)}` : "Coming soon",
  };
}

const teamCards = CURRENT_NFL_TEAMS.map(({ name, slug }) => ({
  name,
  slug,
  ...teamStats(slug),
}));
---

<BaseLayout
  title="NFL Teams | TradeVerdicts"
  description="Browse complete public NFL team trade histories while SEO/index eligibility remains separately controlled."
>
  <main>
    <section class="teams-hero">
      <div class="eyebrow">NFL Trade Database</div>
      <h1>Browse NFL Teams</h1>
      <p>
        Every current NFL franchise in one clean directory, with counts based on the complete public TradeVerdicts NFL trade archive.
      </p>
    </section>

    <section class="teams-grid">
      {teamCards.map((team) => (
        <a class="team-card" href={`/teams/${team.slug}/`}>
          <div class="team-card-top">
            <h2>{team.name}</h2>
            <span>{team.yearRange}</span>
          </div>

          <div class="team-stats">
            <div>
              <strong>{team.total}</strong>
              <span>Trades</span>
            </div>
            <div>
              <strong>{team.wins}</strong>
              <span>Wins</span>
            </div>
            <div>
              <strong>{team.losses}</strong>
              <span>Losses</span>
            </div>
            <div>
              <strong>{team.even}</strong>
              <span>Even</span>
            </div>
          </div>

          <p>View team trades -></p>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 1180px;
    margin: 0 auto;
    padding: 56px 20px 80px;
  }

  .teams-hero {
    text-align: center;
    margin-bottom: 34px;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4.8rem);
    letter-spacing: -0.06em;
  }

  .teams-hero p {
    max-width: 680px;
    margin: 18px auto 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .teams-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .team-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 20px;
    color: inherit;
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .team-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    background: rgba(57, 167, 255, 0.06);
  }

  .team-card-top {
    min-height: 78px;
  }

  .team-card h2 {
    margin: 0 0 8px;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .team-card-top span,
  .team-card p {
    color: var(--muted);
  }

  .team-card p {
    margin: 16px 0 0;
    font-size: 0.95rem;
  }

  .team-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }

  .team-stats div {
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.035);
    padding: 10px 8px;
    text-align: center;
  }

  .team-stats strong {
    display: block;
    font-size: 1.05rem;
  }

  .team-stats span {
    display: block;
    color: var(--muted);
    font-size: 0.72rem;
    margin-top: 3px;
  }

  @media (max-width: 1000px) {
    .teams-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    main {
      padding-top: 34px;
    }

    .teams-grid {
      grid-template-columns: 1fr;
    }

    .team-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
