---
import BaseLayout from "../../layouts/BaseLayout.astro";
import trades from "../../data/nfl/trades.json";

const NFL_TEAMS = [
  ["Arizona Cardinals", "arizona-cardinals"],
  ["Atlanta Falcons", "atlanta-falcons"],
  ["Baltimore Ravens", "baltimore-ravens"],
  ["Buffalo Bills", "buffalo-bills"],
  ["Carolina Panthers", "carolina-panthers"],
  ["Chicago Bears", "chicago-bears"],
  ["Cincinnati Bengals", "cincinnati-bengals"],
  ["Cleveland Browns", "cleveland-browns"],
  ["Dallas Cowboys", "dallas-cowboys"],
  ["Denver Broncos", "denver-broncos"],
  ["Detroit Lions", "detroit-lions"],
  ["Green Bay Packers", "green-bay-packers"],
  ["Houston Texans", "houston-texans"],
  ["Indianapolis Colts", "indianapolis-colts"],
  ["Jacksonville Jaguars", "jacksonville-jaguars"],
  ["Kansas City Chiefs", "kansas-city-chiefs"],
  ["Las Vegas Raiders", "las-vegas-raiders"],
  ["Los Angeles Chargers", "los-angeles-chargers"],
  ["Los Angeles Rams", "los-angeles-rams"],
  ["Miami Dolphins", "miami-dolphins"],
  ["Minnesota Vikings", "minnesota-vikings"],
  ["New England Patriots", "new-england-patriots"],
  ["New Orleans Saints", "new-orleans-saints"],
  ["New York Giants", "new-york-giants"],
  ["New York Jets", "new-york-jets"],
  ["Philadelphia Eagles", "philadelphia-eagles"],
  ["Pittsburgh Steelers", "pittsburgh-steelers"],
  ["San Francisco 49ers", "san-francisco-49ers"],
  ["Seattle Seahawks", "seattle-seahawks"],
  ["Tampa Bay Buccaneers", "tampa-bay-buccaneers"],
  ["Tennessee Titans", "tennessee-titans"],
  ["Washington Commanders", "washington-commanders"],
];

function teamStats(slug) {
  const teamTrades = trades
    .filter((trade) => trade.publishStatus !== "hold-conflict")
    .filter((trade) => trade.teams?.includes(slug));

  const years = teamTrades
    .map((trade) => Number(String(trade.tradeDate || "").slice(0, 4)))
    .filter(Boolean);

  const displayName = NFL_TEAMS.find((team) => team[1] === slug)?.[0] || slug;
  const shortName = displayName.split(" ").at(-1).toLowerCase();

  const wins = teamTrades.filter((trade) => {
    const verdict = String(trade.verdict || "").toLowerCase();
    return (
      verdict === `${shortName} win` ||
      verdict === `${shortName} wins` ||
      verdict === `${displayName.toLowerCase()} win` ||
      verdict === `${displayName.toLowerCase()} wins`
    );
  }).length;

  const even = teamTrades.filter(
    (trade) => String(trade.verdict || "").toLowerCase() === "even trade"
  ).length;

  return {
    total: teamTrades.length,
    wins,
    losses: teamTrades.length - wins - even,
    even,
    yearRange: years.length ? `${Math.min(...years)}–${Math.max(...years)}` : "Coming soon",
  };
}

const teamCards = NFL_TEAMS.map(([name, slug]) => ({
  name,
  slug,
  ...teamStats(slug),
}));
---

<BaseLayout title="NFL Teams | TradeVerdicts">
  <main>
    <section class="teams-hero">
      <div class="eyebrow">NFL Trade Database</div>
      <h1>Browse NFL Teams</h1>
      <p>
        Every current NFL franchise in one clean directory. Historical names are normalized inside each team archive.
      </p>
    </section>

    <section class="teams-grid">
      {teamCards.map((team) => (
        <a class="team-card" href={`/teams/${team.slug}`}>
          <div class="team-card-top">
            <h2>{team.name}</h2>
            <span>{team.yearRange}</span>
          </div>

          <div class="team-stats">
            <div>
              <strong>{team.total}</strong>
              <span>Trades</span>
            </div>
            <div>
              <strong>{team.wins}</strong>
              <span>Wins</span>
            </div>
            <div>
              <strong>{team.losses}</strong>
              <span>Losses</span>
            </div>
            <div>
              <strong>{team.even}</strong>
              <span>Even</span>
            </div>
          </div>

          <p>View team trades →</p>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>

<style>
  .teams-hero {
    margin-bottom: 34px;
  }

  .eyebrow {
    color: var(--accent);
    font-weight: 800;
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(2.6rem, 5vw, 4.6rem);
    margin-bottom: 14px;
  }

  .teams-hero p {
    color: var(--muted);
    line-height: 1.6;
    max-width: 760px;
  }

  .teams-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .team-card {
    display: block;
    color: inherit;
    text-decoration: none;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 18px;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .team-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    background: rgba(57, 167, 255, 0.06);
  }

  .team-card-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 18px;
  }

  .team-card h2 {
    font-size: 1.05rem;
    margin: 0;
  }

  .team-card-top span {
    color: var(--muted);
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .team-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 16px;
  }

  .team-stats div {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 8px;
    text-align: center;
  }

  .team-stats strong {
    display: block;
    font-size: 1.15rem;
  }

  .team-stats span {
    color: var(--muted);
    font-size: 0.72rem;
  }

  .team-card p {
    color: var(--accent);
    font-weight: 800;
    margin: 0;
  }

  @media (max-width: 1100px) {
    .teams-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 700px) {
    .teams-grid {
      grid-template-columns: 1fr;
    }

    .team-stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>