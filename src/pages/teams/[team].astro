---
import BaseLayout from "../../layouts/BaseLayout.astro";
import trades from "../../data/nfl/trades.json";
import { getTeamStats } from "../../utils/teamStats.js";
import { getIndexEligibleTrades, getPublicTrades } from "../../utils/publicRecords.js";
import {
  getPublicTeamRouteSlugs,
  getTeamArchiveSourceSlugs,
  getTeamArchiveTrades,
  getTeamDisplayName,
  getTeamValueClassification,
} from "../../utils/teamRegistry.js";

export function getStaticPaths() {
  const staticPublicTrades = getPublicTrades(trades);
  const routeSlugs = getPublicTeamRouteSlugs(
    staticPublicTrades
  );

  return routeSlugs.map((team) => ({
    params: { team },
    props: { team },
  }));
}

const { team } = Astro.props;
const renderPublicTrades = getPublicTrades(trades);
const indexEligibleTradeSlugSet = new Set(
  getIndexEligibleTrades(trades)
    .map((trade) => trade.slug)
    .filter(Boolean)
);


const teamTrades = getTeamArchiveTrades(
  renderPublicTrades,
  team
).sort((a, b) => new Date(b.tradeDate) - new Date(a.tradeDate));

const teamDisplayName = getTeamDisplayName(team);
const teamClassification = getTeamValueClassification(team);
const archiveSourceSlugs = getTeamArchiveSourceSlugs(team);
const archiveAliasNames = archiveSourceSlugs
  .slice(1)
  .map(getTeamDisplayName);
const isCurrentFranchise =
  teamClassification === "canonical-current-franchise";
const isDefunctArchive =
  teamClassification ===
  "defunct-franchise-historical-archive";
const isReviewArchive =
  teamClassification ===
    "composite-multi-franchise-data-error" ||
  teamClassification ===
    "malformed-or-contaminated-data-error";

const pageTitle = isCurrentFranchise
  ? `${teamDisplayName} Trade History | TradeVerdicts`
  : isDefunctArchive
    ? `${teamDisplayName} Historical Trade Archive | TradeVerdicts`
    : `${teamDisplayName} Record Review | TradeVerdicts`;

const pageDescription = isCurrentFranchise
  ? `Trade grades, verdicts, asset movement, and historical context for ${teamDisplayName} franchise trades.`
  : isDefunctArchive
    ? `Historical trade records for the defunct ${teamDisplayName} football franchise.`
    : `A noindex research archive for a legacy team value that still requires participant cleanup.`;

const heroEyebrow = isCurrentFranchise
  ? "NFL Franchise Trade History"
  : isDefunctArchive
    ? "Historical Football Trade Archive"
    : "Legacy Record Review";

const { wins, losses, even } = getTeamStats(
  renderPublicTrades,
  team
);

const eraDefinitions = [
  {
    id: "2020s",
    label: "2020s",
    test: (year) => year >= 2020 && year <= 2029,
  },
  {
    id: "2010s",
    label: "2010s",
    test: (year) => year >= 2010 && year <= 2019,
  },
  {
    id: "2000s",
    label: "2000s",
    test: (year) => year >= 2000 && year <= 2009,
  },
  {
    id: "1990s",
    label: "1990s",
    test: (year) => year >= 1990 && year <= 1999,
  },
  {
    id: "1980s",
    label: "1980s",
    test: (year) => year >= 1980 && year <= 1989,
  },
  {
    id: "1970s",
    label: "1970s",
    test: (year) => year >= 1970 && year <= 1979,
  },
  {
    id: "pre-1970",
    label: "Pre-1970",
    test: (year) => year < 1970,
  },
];

const eraGroups = eraDefinitions.map((era) => ({
  id: era.id,
  label: era.label,
  trades: teamTrades.filter((trade) => {
    const year = Number(String(trade.tradeDate || "").slice(0, 4));
    return Number.isFinite(year) && era.test(year);
  }),
}));
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  indexEligible={false}
  adEligible={false}
>
  <main>
    <section class="team-hero">
      <div class="eyebrow">{heroEyebrow}</div>
      <h1>{teamDisplayName}</h1>
      <p>{pageDescription}</p>

      {archiveAliasNames.length > 0 && (
        <p class="archive-note">
          This archive includes confirmed historical identities:
          {` ${archiveAliasNames.join(", ")}.`}
        </p>
      )}

      {isReviewArchive && (
        <aside class="archive-warning">
          <strong>Research review archive</strong>
          <p>
            This legacy route is preserved for navigation while its
            underlying multi-team or contaminated participant data is
            researched. It is not indexed or monetized.
          </p>
        </aside>
      )}
    </section>

    <section class="stats-grid" aria-label={`${teamDisplayName} trade statistics`}>
      <div class="stat-card">
        <span>Total Trades</span>
        <strong>{teamTrades.length}</strong>
      </div>
      <div class="stat-card">
        <span>Wins</span>
        <strong>{wins}</strong>
      </div>
      <div class="stat-card">
        <span>Losses</span>
        <strong>{losses}</strong>
      </div>
      <div class="stat-card">
        <span>Even</span>
        <strong>{even}</strong>
      </div>
    </section>

    <section class="era-browser" aria-labelledby="era-browser-title">
      <div class="era-heading">
        <div>
          <div class="eyebrow">Team Trade Archive</div>
          <h2 id="era-browser-title">Browse Trades by Era</h2>
        </div>
        <p>Choose a decade to view the complete public trade record.</p>
      </div>

      <div class="era-buttons" role="group" aria-label="Trade history eras">
        {eraGroups.map((era) => (
          <button
            class="era-button"
            type="button"
            data-era-button={era.id}
            aria-controls={`era-panel-${era.id}`}
            aria-expanded="false"
            disabled={era.trades.length === 0}
          >
            <span>{era.label}</span>
            <strong>
              {era.trades.length}
              <small>{era.trades.length === 1 ? "trade" : "trades"}</small>
            </strong>
          </button>
        ))}
      </div>
    </section>

    <section class="archive-shell" aria-live="polite">
      <div id="archivePlaceholder" class="archive-placeholder">
        <h2>Select an era above.</h2>
        <p>
          The selected {teamDisplayName} public trade archive will appear here.
        </p>
      </div>

      {eraGroups.map((era) => (
        <section
          id={`era-panel-${era.id}`}
          class="era-panel"
          data-era-panel={era.id}
          hidden
        >
          <div class="archive-header">
            <div>
              <div class="eyebrow">{era.label} Trade History</div>
              <h2>{teamDisplayName}</h2>
            </div>
            <strong>
              {era.trades.length}
              {` ${era.trades.length === 1 ? "trade" : "trades"}`}
            </strong>
          </div>

          <div class="trade-list">
            {era.trades.map((trade) => (
              indexEligibleTradeSlugSet.has(trade.slug) ? (
                <a class="trade-card" href={`/trades/${trade.slug}/`}>
                  <div class="top-row">
                    <strong>{trade.verdict}</strong>
                    <time datetime={trade.tradeDate}>{trade.tradeDate}</time>
                  </div>
                  <p>{trade.summary}</p>
                </a>
              ) : (
                <div class="trade-card archive-trade-card">
                  <div class="top-row">
                    <strong>{trade.verdict}</strong>
                    <time datetime={trade.tradeDate}>{trade.tradeDate}</time>
                  </div>
                  <p>{trade.summary}</p>
                  <span class="archive-record-label">
                    Historical archive record
                  </span>
                </div>
              )
            ))}
          </div>
        </section>
      ))}
    </section>
  </main>
</BaseLayout>

<script>
  const buttons = Array.from(
    document.querySelectorAll("[data-era-button]")
  );
  const panels = Array.from(
    document.querySelectorAll("[data-era-panel]")
  );
  const placeholder = document.getElementById("archivePlaceholder");

  const validEraIds = new Set(
    buttons
      .filter((button) => !button.disabled)
      .map((button) => button.dataset.eraButton)
  );

  const showEra = (eraId, updateUrl = true) => {
    if (!validEraIds.has(eraId)) return;

    for (const button of buttons) {
      const isActive = button.dataset.eraButton === eraId;
      button.classList.toggle("active", isActive);
      button.setAttribute("aria-expanded", String(isActive));
    }

    for (const panel of panels) {
      panel.hidden = panel.dataset.eraPanel !== eraId;
    }

    if (placeholder) {
      placeholder.hidden = true;
    }

    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set("era", eraId);
      window.history.replaceState({}, "", url);
    }

    document
      .querySelector(`[data-era-panel="${eraId}"]`)
      ?.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
  };

  for (const button of buttons) {
    button.addEventListener("click", () => {
      showEra(button.dataset.eraButton);
    });
  }

  const initialEra = new URL(window.location.href).searchParams.get("era");

  if (initialEra && validEraIds.has(initialEra)) {
    showEra(initialEra, false);
  }
</script>

<style>
  .team-hero {
    margin-bottom: 32px;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    margin-bottom: 14px;
  }

  .team-hero p,
  .archive-warning p,
  .era-heading p,
  .archive-placeholder p,
  .trade-card p {
    color: var(--muted);
    line-height: 1.6;
  }

  .archive-note {
    font-size: 0.92rem;
  }

  .archive-warning {
    background: rgba(255, 184, 77, 0.08);
    border: 1px solid rgba(255, 184, 77, 0.35);
    border-radius: 14px;
    margin-top: 18px;
    max-width: 760px;
    padding: 16px 18px;
  }

  .archive-warning strong {
    color: var(--accent);
    display: block;
    margin-bottom: 6px;
  }

  .archive-warning p {
    margin: 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 34px;
  }

  .stat-card,
  .era-browser,
  .archive-shell {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 16px;
  }

  .stat-card {
    padding: 20px;
  }

  .stat-card span {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .stat-card strong {
    display: block;
    font-size: 2.2rem;
    margin-top: 8px;
  }

  .era-browser {
    padding: 22px;
  }

  .era-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
  }

  .era-heading h2,
  .archive-header h2,
  .archive-placeholder h2 {
    margin: 0;
  }

  .era-heading p {
    margin: 0;
    max-width: 420px;
    text-align: right;
  }

  .era-buttons {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 10px;
  }

  .era-button {
    min-height: 88px;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 13px 10px;
    background: rgba(255, 255, 255, 0.035);
    color: white;
    cursor: pointer;
    text-align: left;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .era-button:hover:not(:disabled),
  .era-button.active {
    border-color: var(--accent);
    background: rgba(78, 161, 255, 0.14);
    transform: translateY(-1px);
  }

  .era-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .era-button:disabled {
    cursor: not-allowed;
    opacity: 0.4;
  }

  .era-button > span {
    display: block;
    font-size: 1rem;
    font-weight: 900;
  }

  .era-button > strong {
    display: block;
    color: var(--accent);
    font-size: 1.18rem;
    margin-top: 10px;
  }

  .era-button small {
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 700;
    margin-left: 4px;
  }

  .archive-shell {
    margin-top: 22px;
    padding: 22px;
    scroll-margin-top: 20px;
  }

  .archive-placeholder {
    padding: 34px 18px;
    text-align: center;
  }

  .archive-placeholder p {
    margin: 8px 0 0;
  }

  .era-panel {
    scroll-margin-top: 20px;
  }

  .archive-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
  }

  .archive-header > strong {
    color: var(--accent);
  }

  .trade-list {
    display: grid;
    gap: 14px;
  }

  .trade-card {
    display: block;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px;
    background: rgba(8, 13, 20, 0.52);
    color: inherit;
    text-decoration: none;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .trade-card:hover {
    border-color: var(--accent);
    background: rgba(78, 161, 255, 0.07);
    transform: translateY(-1px);
  }

  .trade-card p {
    margin: 8px 0 0;
  }

  .archive-trade-card {
    cursor: default;
  }

  .archive-record-label {
    color: var(--muted);
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    margin-top: 10px;
    text-transform: uppercase;
  }

  .top-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .top-row time {
    color: var(--muted);
  }

  @media (max-width: 1050px) {
    .era-buttons {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 800px) {
    .stats-grid {
      grid-template-columns: 1fr 1fr;
    }

    .era-heading,
    .archive-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .era-heading p {
      text-align: left;
    }
  }

  @media (max-width: 620px) {
    .era-buttons {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .era-browser,
    .archive-shell {
      padding: 16px;
    }
  }

  @media (max-width: 420px) {
    .stats-grid,
    .era-buttons {
      grid-template-columns: 1fr;
    }
  }
</style>
