---
import BaseLayout from "../../layouts/BaseLayout.astro";
import trades from "../../data/nfl/trades.json";
import { getTeamStats } from "../../utils/teamStats.js";

export function getStaticPaths() {
  const teams = [...new Set(trades.flatMap((trade) => trade.teams))];

  return teams.map((team) => ({
    params: { team },
    props: { team },
  }));
}

const { team } = Astro.props;

const formatTeamName = (slug) =>
  slug
    .split("-")
    .map((word) => (word === "49ers" ? "49ers" : word.charAt(0).toUpperCase() + word.slice(1)))
    .join(" ");

const teamTrades = trades
  .filter((trade) => trade.publishStatus !== "hold-conflict")
  .filter((trade) => trade.teams?.includes(team))
  .sort((a, b) => new Date(b.tradeDate) - new Date(a.tradeDate));

const teamDisplayName = formatTeamName(team);
const { wins, losses, even } = getTeamStats(trades, team);

const recentTrades = teamTrades.slice(0, 10);
const majorTrades = teamTrades.filter((trade) => trade.tier === "major").slice(0, 10);
const allTrades = teamTrades;
---

<BaseLayout title={`${formatTeamName(team)} Trade History | TradeVerdicts`}>
  <main>
    <section class="team-hero">
      <div class="eyebrow">NFL Trade History</div>
      <h1>{formatTeamName(team)}</h1>
      <p>
        Trade grades, verdicts, asset movement, and historical context for {formatTeamName(team)} trades.
      </p>
    </section>

    <section class="stats-grid">
      <div class="stat-card">
        <span>Total Trades</span>
        <strong>{teamTrades.length}</strong>
      </div>
      <div class="stat-card">
        <span>Wins</span>
        <strong>{wins}</strong>
      </div>
      <div class="stat-card">
        <span>Losses</span>
        <strong>{losses}</strong>
      </div>
      <div class="stat-card">
        <span>Even</span>
        <strong>{even}</strong>
      </div>
    </section>

    <section class="trade-section">
      <div class="section-header">
        <h2>Recent Trades</h2>
      </div>

      <div class="trade-list">
        {recentTrades.map((trade) => (
          <a class="trade-card" href={`/trades/${trade.slug}/`}>
            <div class="top-row">
              <strong>{trade.verdict}</strong>
              <span>{trade.tradeDate}</span>
            </div>
            <p>{trade.summary}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="trade-section">
      <div class="section-header">
        <h2>Major Trades</h2>
      </div>

      <div class="trade-list">
        {majorTrades.map((trade) => (
          <a class="trade-card" href={`/trades/${trade.slug}/`}>
            <div class="top-row">
              <strong>{trade.verdict}</strong>
              <span>{trade.tradeDate}</span>
            </div>
            <p>{trade.summary}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="trade-section">
      <div class="section-header">
        <h2>All Trades</h2>
        <span>{allTrades.length} records</span>
      </div>

      <div class="trade-list compact">
        {allTrades.map((trade) => (
          <a class="trade-card" href={`/trades/${trade.slug}/`}>
            <div class="top-row">
              <strong>{trade.verdict}</strong>
              <span>{trade.tradeDate}</span>
            </div>
            <p>{trade.summary}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .team-hero {
    margin-bottom: 32px;
  }

  .eyebrow {
    color: var(--accent);
    font-weight: 800;
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    margin-bottom: 14px;
  }

  p {
    color: var(--muted);
    line-height: 1.6;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 42px;
  }

  .stat-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 20px;
  }

  .stat-card span {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .stat-card strong {
    display: block;
    font-size: 2.2rem;
    margin-top: 8px;
  }

  .trade-section {
    margin-top: 36px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
    margin-bottom: 16px;
  }

  .section-header span {
    color: var(--muted);
  }

  .trade-list {
    display: grid;
    gap: 14px;
  }

  .trade-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px;
  }

  .trade-card:hover {
    border-color: var(--accent);
  }

  .compact .trade-card {
    padding: 14px 18px;
  }

  .top-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .top-row span {
    color: var(--muted);
  }

  @media (max-width: 800px) {
    .stats-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
