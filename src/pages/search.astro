---
import BaseLayout from '../layouts/BaseLayout.astro';
import tradesData from '../data/nfl/trades.json';
import { getIndexEligibleTrades } from '../utils/publicRecords.js';

const rows = Array.isArray(tradesData) ? tradesData : tradesData.trades || [];

function normalize(value) {
  return String(value ?? '')
    .toLowerCase()
    .replace(/['']/g, '')
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();
}

function getTradeDate(trade) {
  const direct = trade.date || trade.tradeDate || trade.transactionDate || trade.completedDate;
  if (direct) return String(direct);

  const slug = String(trade.slug ?? '');
  return slug.match(/(?:19|20)\d{2}-\d{2}-\d{2}/)?.[0] || slug.match(/(?:19|20)\d{2}/)?.[0] || '';
}

function formatTeamName(slug = "") {
  const value = String(slug ?? "").trim();
  if (!value) return "";

  const words = value.includes("-")
    ? value.split("-").filter(Boolean)
    : value.split(/\s+/).filter(Boolean);

  return words
    .map((word) => {
      if (word === "49ers") return "49ers";
      return word.charAt(0).toUpperCase() + word.slice(1);
    })
    .join(" ");
}

function cleanTitleAsset(value) {
  return String(value ?? "")
    .replace(/\s*\([^)]*\)/g, "")
    .replace(/\s+/g, " ")
    .replace(/[,.]\s*$/g, "")
    .trim();
}

function isDraftPackage(value) {
  return /\b(round|pick|overall|draft|selection)\b/i.test(String(value ?? ""));
}

function getTeamList(trade) {
  const teams = trade.teams || trade.teamNames || trade.teamKeys || trade.participants || [];
  return Array.isArray(teams) ? teams : [];
}

function findTeamName(rawText, teamList) {
  const text = normalize(rawText);

  const candidates = teamList
    .map((team) => formatTeamName(team))
    .filter(Boolean)
    .map((full) => {
      const pieces = full.split(/\s+/).filter(Boolean);
      return {
        full,
        city: pieces.slice(0, -1).join(" "),
        nickname: pieces.at(-1) || full,
      };
    });

  for (const candidate of candidates) {
    const full = normalize(candidate.full);
    const city = normalize(candidate.city);
    const nickname = normalize(candidate.nickname);

    if (
      text === full ||
      text === city ||
      text === nickname ||
      full.includes(text) ||
      text.includes(full) ||
      (city && text.includes(city)) ||
      (nickname && text.includes(nickname))
    ) {
      return candidate.full;
    }
  }

  return cleanTitleAsset(rawText);
}

function inferTitleFromSummary(trade) {
  const summary = String(trade.summary || trade.description || trade.shortSummary || "").trim();
  if (!summary) return "";

  const teams = getTeamList(trade);
  const acquiredMatch = summary.match(/^(.+?)\s+acquired\s+(.+?)\s+from\s+(.+?)\s+for\s+(.+)$/i);

  if (acquiredMatch) {
    const acquirer = findTeamName(acquiredMatch[1], teams);
    const acquiredAsset = cleanTitleAsset(acquiredMatch[2]);
    const sourceTeam = findTeamName(acquiredMatch[3], teams);
    const sentAsset = cleanTitleAsset(acquiredMatch[4]);

    if (isDraftPackage(acquiredAsset) && sentAsset && !isDraftPackage(sentAsset)) {
      return sentAsset + " to " + sourceTeam;
    }

    if (acquiredAsset && !isDraftPackage(acquiredAsset)) {
      return acquiredAsset + " to " + acquirer;
    }

    if (sentAsset && !isDraftPackage(sentAsset)) {
      return sentAsset + " to " + sourceTeam;
    }
  }

  const tradedMatch = summary.match(/^(.+?)\s+traded\s+(.+?)\s+to\s+(.+?)\s+for\s+(.+)$/i);

  if (tradedMatch) {
    const movedAsset = cleanTitleAsset(tradedMatch[2]);
    const destination = findTeamName(tradedMatch[3], teams);

    if (movedAsset && !isDraftPackage(movedAsset)) {
      return movedAsset + " to " + destination;
    }
  }

  return "";
}

function getTitle(trade) {
  const directTitle = trade.title || trade.headline || trade.name;
  if (directTitle) return directTitle;

  const inferredTitle = inferTitleFromSummary(trade);
  if (inferredTitle) return inferredTitle;

  return String(trade.slug ?? "trade-verdict")
    .replace(/-/g, " ")
    .replace(/\b\w/g, (letter) => letter.toUpperCase());
}

function escapeRegExp(value) {
  return String(value ?? "").replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

function titleCase(value) {
  return String(value ?? "")
    .replace(/\b\w/g, (letter) => letter.toUpperCase())
    .replace(/\bAnd\b/g, "and")
    .replace(/\bFor\b/g, "for")
    .replace(/\bTo\b/g, "to");
}


function cleanSearchTitleFragment(value) {
  return String(value || "")
    .replace(/\s+/g, " ")
    .replace(/\s+([.,;:])/g, "$1")
    .trim();
}

function getSearchSummaryText(trade) {
  const candidates = [
    trade.summary,
    trade.shortSummary,
    trade.description,
    trade.analysis,
    trade.primarySummary,
    trade.partnerSummary
  ];

  if (Array.isArray(trade.perspectives)) {
    trade.perspectives.forEach((perspective) => {
      candidates.push(
        perspective.primarySummary,
        perspective.partnerSummary,
        perspective.summary,
        perspective.analysis
      );
    });
  }

  return candidates
    .map(cleanSearchTitleFragment)
    .find((value) => value && value.length > 20) || "";
}

function fallbackSearchTitleFromSummary(trade) {
  const summary = getSearchSummaryText(trade);
  if (!summary) return "";

  const lead = cleanSearchTitleFragment(summary)
    .split(/\.\s+/)[0]
    .replace(/\.$/, "");

  const acquiredMatch = lead.match(/^(.+?)\s+acquired\s+(.+?)\s+from\s+(.+?)\s+for\s+(.+)$/i);
  if (acquiredMatch) {
    const [, team, incoming, partner, outgoing] = acquiredMatch;
    return `${cleanSearchTitleFragment(team)} acquired ${cleanSearchTitleFragment(incoming)} — ${cleanSearchTitleFragment(partner)} received ${cleanSearchTitleFragment(outgoing)}`;
  }

  const sentMatch = lead.match(/^(.+?)\s+sent\s+(.+?)\s+to\s+(.+?)\s+for\s+(.+)$/i);
  if (sentMatch) {
    const [, team, outgoing, partner, incoming] = sentMatch;
    return `${cleanSearchTitleFragment(team)} sent ${cleanSearchTitleFragment(outgoing)} to ${cleanSearchTitleFragment(partner)} — received ${cleanSearchTitleFragment(incoming)}`;
  }

  return lead;
}

function fallbackSearchTitleFromSlug(trade) {
  const slug = String(trade.slug ?? "").trim();
  if (!slug) return "NFL Trade Verdict";

  const dateYear = getTradeDate(trade).match(/(?:19|20)\d{2}/)?.[0];
  const slugYear = slug.match(/(?:19|20)\d{2}$/)?.[0];
  const year = dateYear || slugYear || "";

  let title = titleCase(slug.replace(/-/g, " "))
    .replace(/\s+(?:19|20)\d{2}$/i, "")
    .replace(/\s+/g, " ")
    .trim();

  const teamFields = [
    trade.sourceTeam,
    trade.primaryTeam,
    trade.partnerTeam,
    trade.team,
    trade.teamA,
    trade.teamB,
    trade.winningTeam,
    trade.losingTeam,
  ].filter(Boolean);

  teamFields.forEach((teamSlug) => {
    const teamName = formatTeamName(teamSlug);
    if (teamName) {
      title = title.replace(new RegExp(`\\s+${escapeRegExp(teamName)}$`, "i"), "").trim();
    }
  });

  return year ? `${title}, ${year}` : title;
}

function isLowValueSearchTitle(value) {
  const normalized = String(value ?? "").toLowerCase();

  return (
    !normalized ||
    normalized.startsWith("the countervalue") ||
    normalized.includes("standard database entry") ||
    normalized.includes("documented impact") ||
    normalized.includes("impact was real but not") ||
    normalized.includes("not franchise-shaping")
  );
}

function getSearchTitle(trade) {
  const title = getTitle(trade);
  return isLowValueSearchTitle(title) ? fallbackSearchTitleFromSlug(trade) : title;
}

function getMeta(trade) {
  const parts = [];
  const date = getTradeDate(trade);
  const verdict = trade.verdict || trade.result || trade.winner || trade.outcome;

  if (date) parts.push(date);
  if (verdict) parts.push(verdict);

  return parts.join(' · ') || 'NFL trade verdict';
}

function getSummary(trade) {
  return trade.summary || trade.description || trade.shortSummary || 'View the full trade verdict, assets, grades, and long-term outcome.';
}

function getSortDate(trade) {
  const parsed = Date.parse(getTradeDate(trade));
  if (!Number.isNaN(parsed)) return parsed;

  const year = getTradeDate(trade).match(/(?:19|20)\d{2}/)?.[0];
  return year ? Number(year) : 0;
}

function flattenSearchValue(value, depth = 0) {
  if (value == null || depth > 4) return "";

  if (typeof value === "string" || typeof value === "number" || typeof value === "boolean") {
    return String(value);
  }

  if (Array.isArray(value)) {
    return value.map((item) => flattenSearchValue(item, depth + 1)).join(" ");
  }

  if (typeof value === "object") {
    return Object.entries(value)
      .map(([key, child]) => key + " " + flattenSearchValue(child, depth + 1))
      .join(" ");
  }

  return "";
}

function compactSearchText(trade) {
  const assetText = flattenSearchValue(trade.assetsReceived || trade.assets || trade.assetsSent || trade.tradeAssets);
  const teamText = [
    ...(Array.isArray(trade.teams) ? trade.teams : []),
    trade.teamA,
    trade.teamB,
    trade.winningTeam,
    trade.losingTeam,
  ].filter(Boolean).join(" ");

  return normalize([
    trade.slug,
    trade.id,
    trade.canonicalTradeSlug,
    trade.title,
    getSearchTitle(trade),
    getSearchSummaryText(trade),
    getSummary(trade),
    trade.partnerSummary,
    trade.verdict,
    trade.winner,
    trade.tier,
    trade.confidence,
    getTradeDate(trade),
    teamText,
    assetText,
  ].filter(Boolean).join(" "));
}

const publicTrades = getIndexEligibleTrades(rows);

const searchIndex = publicTrades.map((trade) => ({
  slug: trade.slug,
  title: getSearchTitle(trade),
  summary: getSearchSummaryText(trade),
  meta: getMeta(trade),
  summary: getSummary(trade),
  date: getTradeDate(trade),
  sortDate: getSortDate(trade),
  tier: String(trade.tier || ""),
  confidence: String(trade.confidence || ""),
  searchText: compactSearchText(trade),
}));

const searchIndexJson = JSON.stringify(searchIndex).replace(/</g, '\\u003c');
---

<BaseLayout
  title="Search TradeVerdicts"
  indexEligible={false}
  adEligible={false}
>
  <main id="searchPage" class="search-page">
    <section class="hero">
      <p class="eyebrow">TradeVerdicts Search</p>
      <h1>Do It — Search Any Player, Team, Year, Month, or Date</h1>
      <p>
        Search NFL trade verdicts by player, franchise, season, month, exact trade date, or any combination.
      </p>

      <form class="big-search" action="/search/" method="get">
        <label for="q">Universal Search</label>
        <div>
          <input id="q" name="q" type="search" placeholder="Type any player, team, year, month, or date..." />
          <button type="submit">Search</button>
        </div>
      </form>
    </section>

    <section class="search-box">
      <div class="section-head">
        <h2>Search by Specific Detail</h2>
        <p>Use one field or combine several. Example: Vikings + 1989, or Herschel Walker + October.</p>
      </div>

      <form class="field-grid" action="/search/" method="get">
        <label>
          <span>Player</span>
          <input id="player" name="player" type="search" placeholder="Type player name..." />
        </label>

        <label>
          <span>Team</span>
          <input id="team" name="team" type="search" placeholder="Type team name..." />
        </label>

        <label>
          <span>Year</span>
          <input id="year" name="year" type="number" placeholder="Type year..." />
        </label>

        <label>
          <span>Month</span>
          <input id="month" name="month" type="search" placeholder="Type month..." />
        </label>

        <label>
          <span>Date</span>
          <input id="date" name="date" type="date" />
        </label>

        <button type="submit">Search Trades</button>
      </form>
    </section>

    <section id="resultsSection" class="results" hidden>
      <div class="results-head">
        <div>
          <p class="eyebrow">Results</p>
          <h2 id="resultsTitle">0 trades found</h2>
        </div>
        <a href="/search/">Clear search</a>
      </div>

      <div id="resultsGrid" class="results-grid"></div>

      <div id="emptyState" class="empty" hidden>
        <h3>No public trade verdicts matched that search.</h3>
        <p>Try a broader player name, team name, year, or universal search term.</p>
      </div>
    </section>

    <section id="starterSection" class="starter">
      <p class="eyebrow">Ready</p>
      <h2>{publicTrades.length.toLocaleString()} public NFL trade verdicts are searchable.</h2>
      <p>Start with a player or team, then narrow by year, month, or exact date.</p>
    </section>
  </main>

  <script type="application/json" id="searchIndex" set:html={searchIndexJson}></script>

  <script is:inline>
    const indexNode = document.getElementById('searchIndex');
    const searchIndex = JSON.parse(indexNode?.textContent || '[]');

    const params = new URLSearchParams(window.location.search);

    const fields = {
      q: document.getElementById('q'),
      player: document.getElementById('player'),
      team: document.getElementById('team'),
      year: document.getElementById('year'),
      month: document.getElementById('month'),
      date: document.getElementById('date'),
    };

    Object.entries(fields).forEach(([key, input]) => {
      if (input && params.has(key)) {
        input.value = params.get(key) || '';
      }
    });

    function clean(value) {
      return String(value || '').trim();
    }

    function normalizeBasic(value) {
      return String(value || "")
        .toLowerCase()
        .normalize("NFKD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[’']/g, "")
        .replace(/\bj\s+j\b/g, "jj")
        .replace(/\ba\s+j\b/g, "aj")
        .replace(/\bc\s+j\b/g, "cj")
        .replace(/[^a-z0-9]+/g, " ")
        .replace(/\s+/g, " ")
        .trim();
    }

    function normalize(value) {
      return normalizeBasic(value);
    }

    const franchiseAliases = [
      ["washington redskins", "washington commanders"],
      ["washington football team", "washington commanders"],
      ["redskins", "washington commanders"],
      ["oakland raiders", "las vegas raiders"],
      ["los angeles raiders", "las vegas raiders"],
      ["st louis rams", "los angeles rams"],
      ["saint louis rams", "los angeles rams"],
      ["cleveland rams", "los angeles rams"],
      ["san diego chargers", "los angeles chargers"],
      ["houston oilers", "tennessee titans"],
      ["tennessee oilers", "tennessee titans"],
      ["boston braves", "washington commanders"],
      ["washington braves", "washington commanders"],
      ["baltimore colts", "indianapolis colts"],
      ["boston patriots", "new england patriots"],
      ["phoenix cardinals", "arizona cardinals"],
      ["st louis cardinals", "arizona cardinals"],
      ["new york titans", "new york jets"],
      ["vikes", "minnesota vikings"],
      ["niners", "san francisco 49ers"],
      ["bucs", "tampa bay buccaneers"],
      ["jags", "jacksonville jaguars"],
      ["pats", "new england patriots"]
    ];

    function unique(values) {
      return [...new Set(values.filter(Boolean))];
    }

    function queryVariants(value) {
      const base = normalizeBasic(value);
      if (!base) return [""];

      const variants = [base];

      franchiseAliases.forEach(([alias, canonical]) => {
        const a = normalizeBasic(alias);
        const c = normalizeBasic(canonical);
        const nick = c.split(" ").at(-1);

        if (base.includes(a)) {
          variants.push(base.replace(a, c));
          variants.push(base.replace(a, nick));
          variants.push(c);
          variants.push(nick);
        }

        if (base.includes(c)) {
          variants.push(base.replace(c, a));
          variants.push(a);
        }
      });

      return unique(variants.map(normalizeBasic));
    }

    function editDistance(a, b) {
      a = String(a || "");
      b = String(b || "");

      if (a === b) return 0;
      if (!a || !b) return Math.max(a.length, b.length);
      if (Math.abs(a.length - b.length) > 3) return 99;

      const dp = Array.from({ length: a.length + 1 }, () => Array(b.length + 1).fill(0));

      for (let i = 0; i <= a.length; i++) dp[i][0] = i;
      for (let j = 0; j <= b.length; j++) dp[0][j] = j;

      for (let i = 1; i <= a.length; i++) {
        for (let j = 1; j <= b.length; j++) {
          const cost = a[i - 1] === b[j - 1] ? 0 : 1;
          dp[i][j] = Math.min(
            dp[i - 1][j] + 1,
            dp[i][j - 1] + 1,
            dp[i - 1][j - 1] + cost
          );
        }
      }

      return dp[a.length][b.length];
    }

    function tokenMatches(sourceTokens, sourceCompact, token) {
      if (!token) return true;
      if (sourceTokens.includes(token)) return true;

      const tokenCompact = token.replace(/\s+/g, "");
      if (tokenCompact.length >= 2 && sourceCompact.includes(tokenCompact)) return true;

      if (token.length <= 2) return false;

      return sourceTokens.some((candidate) => {
        if (!candidate) return false;

        if (candidate.includes(token)) {
          return token.length >= 4;
        }

        if (token.includes(candidate)) {
          return candidate.length >= 5 && token.length >= candidate.length + 2;
        }

        const maxDistance = token.length >= 9 ? 2 : token.length >= 6 ? 1 : 0;
        return maxDistance > 0 && editDistance(candidate, token) <= maxDistance;
      });
    }

    function sourceMatchesQuery(source, term) {
      if (!clean(term)) return true;

      const sourceNorm = normalizeBasic(source);
      const sourceTokens = sourceNorm.split(/\s+/).filter(Boolean);
      const sourceCompact = sourceTokens.join("");

      return queryVariants(term).some((variant) => {
        if (!variant) return true;
        if (sourceNorm.includes(variant)) return true;

        const tokens = variant
          .split(/\s+/)
          .filter(Boolean)
          .filter((token) => !["the", "a", "an", "and", "or", "to", "for", "of", "in", "on"].includes(token));

        return tokens.length > 0 && tokens.every((token) => tokenMatches(sourceTokens, sourceCompact, token));
      });
    }

    function monthNumber(value) {
      const raw = clean(value).toLowerCase();

      const map = {
        jan: '01', january: '01',
        feb: '02', february: '02',
        mar: '03', march: '03',
        apr: '04', april: '04',
        may: '05',
        jun: '06', june: '06',
        jul: '07', july: '07',
        aug: '08', august: '08',
        sep: '09', sept: '09', september: '09',
        oct: '10', october: '10',
        nov: '11', november: '11',
        dec: '12', december: '12',
      };

      if (/^\d{1,2}$/.test(raw)) return raw.padStart(2, '0');
      return map[raw] || map[raw.slice(0, 3)] || '';
    }

    function includesTerm(source, term) {
      return sourceMatchesQuery(source, term);
    }

    function fastIncludesTerm(source, term) {
      if (!clean(term)) return true;

      const sourceNorm = normalizeBasic(source);
      const termNorm = normalizeBasic(term);
      if (!termNorm) return true;
      if (sourceNorm.includes(termNorm)) return true;

      const sourcePadded = " " + sourceNorm + " ";
      const tokens = termNorm
        .split(/\s+/)
        .filter(Boolean)
        .filter((token) => !["the", "a", "an", "and", "or", "to", "for", "of", "in", "on"].includes(token));

      return tokens.length > 0 && tokens.every((token) => sourcePadded.includes(" " + token + " "));
    }

    function queryScoreTokens(value) {
      return normalizeBasic(value)
        .split(/\s+/)
        .filter(Boolean)
        .filter((token) => !["the", "a", "an", "and", "or", "to", "for", "of", "in", "on"].includes(token));
    }

    function scoreSearchResult(item, query) {
      const fields = [
        item.title || "",
        item.summary || "",
        item.meta || "",
        item.searchText || "",
      ];

      const displayNorm = normalizeBasic([item.title || "", item.summary || "", item.meta || ""].join(" "));
      const fullNorm = normalizeBasic(fields.join(" "));
      const fullTokens = fullNorm.split(/\s+/).filter(Boolean);
      const fullCompact = fullTokens.join("");
      const terms = [query.q, query.player, query.team, query.year, query.month, query.date].filter(Boolean);

      let score = 0;

      for (const term of terms) {
        const termNorm = normalizeBasic(term);
        if (!termNorm) continue;

        const tokens = queryScoreTokens(term);
        const phraseInDisplay = displayNorm.includes(termNorm);
        const phraseInFull = fullNorm.includes(termNorm);
        const allTokensPresent = tokens.length > 0 && tokens.every((token) => tokenMatches(fullTokens, fullCompact, token));
        const exactTokenHits = tokens.filter((token) => fullTokens.includes(token)).length;

        if (phraseInDisplay) score += 10000;
        else if (phraseInFull) score += 7000;

        if (tokens.length >= 2 && allTokensPresent) score += 3000;
        score += exactTokenHits * 500;

        if (String(item.tier || "").toLowerCase() === "landmark" && (phraseInDisplay || phraseInFull || allTokensPresent)) {
          score += 1250;
        }

        if (String(item.confidence || "").toLowerCase() === "high" && (phraseInDisplay || phraseInFull || allTokensPresent)) {
          score += 150;
        }
      }

      return score;
    }

    function matchesYear(item, value) {
      if (!clean(value)) return true;
      return item.date.includes(clean(value)) || includesTerm(item.searchText, value);
    }

    function matchesMonth(item, value) {
      if (!clean(value)) return true;

      const wanted = monthNumber(value);
      const found = String(item.date || '').match(/(?:19|20)\d{2}[-/](\d{1,2})/);

      if (wanted && found) return found[1].padStart(2, '0') === wanted;

      return includesTerm(item.searchText, value);
    }

    function matchesDate(item, value) {
      if (!clean(value)) return true;
      return String(item.date || '').startsWith(clean(value)) || includesTerm(item.searchText, value);
    }

    function compactAssetHeadline(value) {
  let text = String(value || "")
    .replace(/\s+/g, " ")
    .replace(/\s+([.,;:])/g, "$1")
    .trim();

  text = text
    .replace(/\bfirst round\b/gi, "1st Rd")
    .replace(/\bsecond round\b/gi, "2nd Rd")
    .replace(/\bthird round\b/gi, "3rd Rd")
    .replace(/\bfourth round\b/gi, "4th Rd")
    .replace(/\bfifth round\b/gi, "5th Rd")
    .replace(/\bsixth round\b/gi, "6th Rd")
    .replace(/\bseventh round\b/gi, "7th Rd")
    .replace(/\beighth round\b/gi, "8th Rd")
    .replace(/\bninth round\b/gi, "9th Rd")
    .replace(/\btenth round\b/gi, "10th Rd")
    .replace(/\beleventh round\b/gi, "11th Rd")
    .replace(/\btwelfth round\b/gi, "12th Rd")
    .replace(/\bround pick\b/gi, "pick")
    .replace(/\((\d+)(?:st|nd|rd|th) overall,\s*([^\)]+)\)/gi, "(#$1, $2)")
    .replace(/\((\d+)(?:st|nd|rd|th) overall\)/gi, "(#$1)")
    .replace(/\bsubsequently traded,\s*/gi, "")
    .replace(/\bundisclosed consideration\b/gi, "undisclosed")
    .replace(/\bnot specified in source record\b/gi, "not specified");

  text = text.replace(/\s+and\s+/gi, " + ");

  if (text.length > 92) {
    text = text.slice(0, 89).replace(/[\s,;+]+$/, "") + "...";
  }

  return text;
}

function buildSearchCardHeadline(item, verdict) {
  const summary = String(item.summary || "");

  const acquiredMatch = summary.match(/^(.+?)\s+acquired\s+(.+?)\s+from\s+(.+?)\s+for\s+(.+?)(?:\.\s|$)/i);
  if (acquiredMatch) {
    const incoming = compactAssetHeadline(acquiredMatch[2]);
    const outgoing = compactAssetHeadline(acquiredMatch[4]);
    return `${verdict} — ${incoming} for ${outgoing}`;
  }

  const receivedMatch = summary.match(/^(.+?)\s+received\s+(.+?)\s+and\s+sent\s+(.+?)(?:\.\s|$)/i);
  if (receivedMatch) {
    return `${verdict} — ${compactAssetHeadline(receivedMatch[2])} for ${compactAssetHeadline(receivedMatch[3])}`;
  }

  const tradedMatch = summary.match(/^(.+?)\s+traded\s+(.+?)\s+to\s+(.+?)\s+for\s+(.+?)(?:\.\s|$)/i);
  if (tradedMatch) {
    return `${verdict} — ${compactAssetHeadline(tradedMatch[4])} for ${compactAssetHeadline(tradedMatch[2])}`;
  }

  const fallbackTitle = compactAssetHeadline(item.title || "");
  if (fallbackTitle && fallbackTitle !== verdict) {
    return `${verdict} — ${fallbackTitle}`;
  }

  return verdict;
}

function escapeHtml(value) {
      return String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    const query = {
      q: clean(params.get('q')),
      player: clean(params.get('player')),
      team: clean(params.get('team')),
      year: clean(params.get('year')),
      month: clean(params.get('month')),
      date: clean(params.get('date')),
    };

    const hasSearch = Object.values(query).some(Boolean);

    const searchPage = document.getElementById('searchPage');
    const starterSection = document.getElementById('starterSection');
    const resultsSection = document.getElementById('resultsSection');
    const resultsTitle = document.getElementById('resultsTitle');
    const resultsGrid = document.getElementById('resultsGrid');
    const emptyState = document.getElementById('emptyState');

    if (hasSearch) {
      searchPage?.classList.add('search-active');

      if (searchPage && resultsSection) {
        searchPage.insertBefore(resultsSection, searchPage.firstElementChild);
      }

      const heroHeading = document.querySelector('.hero h1');
      const heroIntro = document.querySelector('.hero > p:not(.eyebrow)');
      const detailIntro = document.querySelector('.search-box .section-head p');

      if (heroHeading) heroHeading.textContent = 'Modify Search';
      if (heroIntro) heroIntro.textContent = 'Adjust the universal search, or refine the results with specific details below.';
      if (detailIntro) detailIntro.textContent = 'Narrow the active results by player, team, year, month, or exact date.';

      function itemMatchesSearch(item, useFuzzy) {
        const textMatcher = useFuzzy ? includesTerm : fastIncludesTerm;

        return (
          textMatcher(item.searchText, query.q) &&
          textMatcher(item.searchText, query.player) &&
          textMatcher(item.searchText, query.team) &&
          matchesYear(item, query.year) &&
          matchesMonth(item, query.month) &&
          matchesDate(item, query.date)
        );
      }

      function rankResults(items) {
        return items
          .map((item) => ({
            ...item,
            searchScore: scoreSearchResult(item, query),
          }))
          .sort((a, b) => (b.searchScore || 0) - (a.searchScore || 0) || (b.sortDate || 0) - (a.sortDate || 0))
          .slice(0, 150);
      }

      let matchedItems = searchIndex.filter((item) => itemMatchesSearch(item, false));

      if (matchedItems.length < 3) {
        matchedItems = searchIndex.filter((item) => itemMatchesSearch(item, true));
      }

      const results = rankResults(matchedItems);

      starterSection.hidden = true;
      resultsSection.hidden = false;
      resultsTitle.textContent = `${results.length} trade${results.length === 1 ? '' : 's'} found`;

      if (results.length) {
        emptyState.hidden = true;
        resultsGrid.hidden = false;
        resultsGrid.classList.add("search-related-results");
resultsGrid.innerHTML = results.map((item) => {
  const summary = item.summary || item.title || "";
  const metaParts = String(item.meta || "").split("·");
  const date = (metaParts[0] || "").trim();
  const verdict = (metaParts.slice(1).join("·") || item.meta || "Open verdict").trim();
  const headline = buildSearchCardHeadline(item, verdict);
  const href = `/trades/${encodeURIComponent(item.slug)}/`;

  return `
    <a class="search-related-card" href="${href}">
      <div class="search-related-head">
        <span class="search-related-verdict">${escapeHtml(headline)}</span>
        <span class="search-related-date">${escapeHtml(date)}</span>
      </div>
      <p class="search-related-summary">${escapeHtml(summary)}</p>
    </a>
  `;
}).join('');
      } else {
        resultsGrid.hidden = true;
        emptyState.hidden = false;
      }
    }
  </script>

