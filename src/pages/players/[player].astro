---
import BaseLayout from "../../layouts/BaseLayout.astro";
import players from "../../data/nfl/players.json";
import trades from "../../data/nfl/trades.json";



export function getStaticPaths() {
  return players
    .filter((player) => {
      const name = String(player?.name || "").trim();
      const slug = String(player?.slug || "").trim();

      if (!name || !slug) return false;
      if (/^(?:undisclosed|unknown|not clearly specified|not conveyed|no consideration|player(?:\(s\))? to be named later)/i.test(name)) return false;
      if (/^(?:undisclosed|undisclosed-consideration|undisclosed-compensation|undisclosed-terms|undisclosed-historical-consideration|unspecified-consideration|no-consideration-recorded|not-conveyed|not-clearly-specified-in-source|player-to-be-named-later|player-s-to-be-named-later)/i.test(slug)) return false;

      return true;
    })
    .map((player) => ({
      params: { player: player.slug },
      props: { player },
    }));
}

const { player } = Astro.props;

const relatedTrades = trades
  .filter((trade) => trade.publishStatus !== "hold-conflict")
  .filter((trade) =>
    JSON.stringify(trade.assetsReceived || {})
      .toLowerCase()
      .includes(player.name.toLowerCase())
  )
  .sort((a, b) => new Date(b.tradeDate) - new Date(a.tradeDate));

const formatTeamName = (slug) =>
  slug
    .split("-")
    .map((word) =>
      word === "49ers" ? "49ers" : word.charAt(0).toUpperCase() + word.slice(1)
    )
    .join(" ");

const involvedTeams = [
  ...new Set(relatedTrades.flatMap((trade) => trade.teams || [])),
];
---

<BaseLayout title={`${player.name} Trade History | TradeVerdicts`}>
  <main>
    <section class="player-hero">
      <div class="eyebrow">Player Trade Profile</div>

      <h1>{player.name}</h1>

      <p>
        Trade history, asset movement, verdicts, and team impact for {player.name}.
      </p>

      <div class="meta">
        <span>{relatedTrades.length} Related Trade{relatedTrades.length === 1 ? "" : "s"}</span>

        {involvedTeams.map((team) => (
          <span>{formatTeamName(team)}</span>
        ))}
      </div>
    </section>

    <section class="career-impact">
      <h2>Trade Impact Summary</h2>

      <p>
        {player.name} appears in {relatedTrades.length} trade record{relatedTrades.length === 1 ? "" : "s"} in the TradeVerdicts database.
      </p>
    </section>

    <section class="trade-history">
      <h2>Related Trades</h2>

      <div class="trade-list">
        {relatedTrades.map((trade) => (
          <a class="trade-row" href={`/trades/${trade.slug}`}>
            <div>
              <strong>{trade.verdict}</strong>
              <p>{trade.summary}</p>
            </div>

            <span>{trade.tradeDate}</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .player-hero {
    margin-bottom: 40px;
  }

  .eyebrow {
    color: var(--accent);
    font-weight: 800;
    margin-bottom: 12px;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    margin-bottom: 14px;
  }

  p {
    color: var(--muted);
    line-height: 1.6;
  }

  .meta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .meta span {
    border: 1px solid var(--border);
    background: var(--panel);
    border-radius: 999px;
    padding: 8px 12px;
    color: var(--muted);
  }

  .career-impact,
  .trade-history {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 24px;
    margin-bottom: 20px;
  }

  h2 {
    margin-bottom: 14px;
  }

  .trade-list {
    display: grid;
    gap: 14px;
  }

  .trade-row {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
  }

  .trade-row:hover {
    border-color: var(--accent);
  }

  .trade-row strong {
    color: var(--accent);
  }

  .trade-row p {
    margin-top: 6px;
  }

  .trade-row span {
    color: var(--muted);
    white-space: nowrap;
  }

  @media (max-width: 800px) {
    .trade-row {
      flex-direction: column;
    }
  }
</style>
