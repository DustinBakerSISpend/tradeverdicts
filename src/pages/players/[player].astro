---
import BaseLayout from "../../layouts/BaseLayout.astro";
import players from "../../data/nfl/players.json";
import trades from "../../data/nfl/trades.json";
import {
  createEligibilityContext,
} from "../../utils/eligibility.js";
import {
  getPublicPlayerRecords,
  getSearchablePlayerRecords,
  getSearchableRelatedPublicTrades,
  getPublicTrades,
  getRelatedPublicTrades,
} from "../../utils/publicRecords.js";
import {
  createPlayerEligibilityContext,
  getPlayerEligibility,
} from "../../utils/playerEligibility.js";
import {
  getTeamRouteSlug,
} from "../../utils/teamRegistry.js";

export function getStaticPaths() {
  const routePublicTrades = getPublicTrades(trades);
  const routePublicPlayers = getSearchablePlayerRecords(
    players,
    routePublicTrades
  );
  const routeTradeEligibilityContext =
    createEligibilityContext(trades);
  const routeNameCounts = new Map();
  for (const row of routePublicPlayers) {
    const key = String(row?.name || "").trim().toLowerCase();
    if (key) routeNameCounts.set(key, (routeNameCounts.get(key) || 0) + 1);
  }
  const routePlayerEligibilityContext =
    createPlayerEligibilityContext(
      routePublicPlayers,
      routePublicTrades,
      routeTradeEligibilityContext
    );

  return routePublicPlayers.map((player) => {
    const playerEligibility = getPlayerEligibility(
      player,
      routePublicTrades,
      routePlayerEligibilityContext
    );

    const relatedTrades = getSearchableRelatedPublicTrades(
      player,
      routePublicTrades
    ).sort(
      (a, b) =>
        new Date(a.tradeDate) - new Date(b.tradeDate)
    );

    return {
      params: { player: player.slug },
      props: {
        player,
        playerEligibility,
        relatedTrades,
        duplicateNameCount:
          routeNameCounts.get(String(player?.name || "").trim().toLowerCase()) || 1,
      },
    };
  });
}

const {
  player,
  playerEligibility,
  relatedTrades,
  duplicateNameCount = 1,
} = Astro.props;


const formatTeamName = (slug) =>
  String(slug || "")
    .split("-")
    .filter(Boolean)
    .map((word) =>
      word === "49ers"
        ? "49ers"
        : word.charAt(0).toUpperCase() + word.slice(1)
    )
    .join(" ");

const getTeamHref = (slug) => {
  const routeSlug = getTeamRouteSlug(slug);

  return routeSlug
    ? `/teams/${routeSlug}/`
    : "/teams/";
};

const formatTradeDate = (value) => {
  const raw = String(value || "").trim();
  const match = raw.match(/^(\d{4})-(\d{2})-(\d{2})$/);

  if (!match) return raw || "Date unavailable";

  const [, year, month, day] = match;

  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }).format(
    new Date(
      Date.UTC(
        Number(year),
        Number(month) - 1,
        Number(day)
      )
    )
  );
};

const formatAssetType = (value) =>
  String(value || "asset")
    .replace(/[_-]+/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .split(" ")
    .map(
      (word) =>
        word.charAt(0).toUpperCase() +
        word.slice(1)
    )
    .join(" ");

const getGradeEntries = (trade) =>
  Object.entries(
    trade.grades &&
      typeof trade.grades === "object"
      ? trade.grades
      : {}
  )
    .filter(
      ([team, grade]) =>
        String(team || "").trim() &&
        String(grade || "").trim()
    )
    .map(([team, grade]) => ({
      team,
      grade: String(grade).trim(),
    }));

const getAssetGroups = (trade) =>
  Object.entries(
    trade.assetsReceived &&
      typeof trade.assetsReceived === "object"
      ? trade.assetsReceived
      : {}
  )
    .map(([team, items]) => ({
      team,
      items: Array.isArray(items)
        ? items
            .filter(
              (item) =>
                item &&
                String(item.asset || "").trim()
            )
            .map((item) => ({
              type: String(item.type || "asset").trim(),
              asset: String(item.asset || "").trim(),
            }))
        : [],
    }))
    .filter((group) => group.items.length > 0);

const normalizeSearchText = (value = "") =>
  String(value)
    .normalize("NFKD")
    .toLowerCase()
    .replace(/[’']/g, "")
    .replace(/[^a-z0-9]+/g, " ")
    .replace(/\b(?:jr|sr|ii|iii|iv)\b/g, " ")
    .replace(/\s+/g, " ")
    .trim();

const playerSearchName = normalizeSearchText(player.name);

// Exact, first-party-confirmed name variants on four existing public profiles.
// Keep this explicit rather than splitting every slash-name or matching other
// people who share a surname. A selected draft pick is not a player transfer.
// Kilmer: Washington franchise history (1971 Saints trade).
// Rashad: Minnesota Vikings Ring of Honor biography (1974/1976 moves).
// Baker: Detroit Lions history and Cleveland Browns 1990 media guide.
const verifiedDirectPlayerAssetAliases = {
  "bill-kilmer": ["Billy Kilmer"],
  "bill-kilmer-billy-kilmer": ["Billy Kilmer"],
  "al-baker-bubba-baker": ["Al 'Bubba' Baker"],
  "ahmad-rashad-bobby-moore": [
    "Ahmad Rashad",
    "Ahmad Rashad (formerly Bobby Moore)",
  ],
};
const normalizedVerifiedAssetAliases = (
  verifiedDirectPlayerAssetAliases[player.slug] || []
).map(normalizeSearchText);

const getPlayerAssetMentions = (trade) =>
  Object.entries(
    trade.assetsReceived &&
      typeof trade.assetsReceived === "object"
      ? trade.assetsReceived
      : {}
  ).flatMap(([team, items]) =>
    (Array.isArray(items) ? items : [])
      .filter((item) => {
        const asset = normalizeSearchText(item?.asset || "");
        return (
          (playerSearchName && asset.includes(playerSearchName)) ||
          (String(item?.type || "").toLowerCase() === "player" &&
            normalizedVerifiedAssetAliases.includes(asset))
        );
      })
      .map((item) => ({
        team,
        type: String(item.type || "asset").trim(),
        asset: String(item.asset || "").trim(),
      }))
  );

const teamSlugs = [
  ...new Set(
    relatedTrades.flatMap((trade) =>
      Array.isArray(trade.teams)
        ? trade.teams
        : []
    )
  ),
];

const teamNames = teamSlugs.map(formatTeamName);

const years = relatedTrades
  .map((trade) => {
    const dateYear = Number(
      String(trade.tradeDate || "").slice(0, 4)
    );
    const seasonYear = Number(trade.season);

    return Number.isFinite(dateYear)
      ? dateYear
      : Number.isFinite(seasonYear)
        ? seasonYear
        : null;
  })
  .filter((year) => year !== null);

const firstYear =
  years.length > 0 ? Math.min(...years) : null;

const lastYear =
  years.length > 0 ? Math.max(...years) : null;

const yearSpan =
  firstYear && lastYear
    ? firstYear === lastYear
      ? String(firstYear)
      : `${firstYear}–${lastYear}`
    : "Historical record";

const teamLabel =
  teamNames.length > 0
    ? new Intl.ListFormat("en-US", {
        style: "long",
        type: "conjunction",
      }).format(teamNames)
    : "the teams involved";

const tradeCount = relatedTrades.length;
const firstTrade = relatedTrades[0] || null;
const lastTrade = relatedTrades[relatedTrades.length - 1] || null;

// An athlete being named as the eventual selection of a traded draft pick
// does NOT mean that athlete was transferred as a player. Keep both histories
// without changing their canonical trade/asset records or public eligibility.
const playerTradeContexts = relatedTrades.map((trade) => {
  const mentions = getPlayerAssetMentions(trade);
  const relationship = mentions.some((item) => item.type.toLowerCase() === "player")
    ? "direct-player-trade"
    : mentions.some((item) => item.type.toLowerCase() === "pick")
      ? "draft-pick-lineage"
      : "other-related-transaction";
  return { trade, mentions, relationship };
});
const directPlayerTradeCount = playerTradeContexts.filter(
  (item) => item.relationship === "direct-player-trade"
).length;
const draftPickLineageCount = playerTradeContexts.filter(
  (item) => item.relationship === "draft-pick-lineage"
).length;
const otherRelatedCount = tradeCount - directPlayerTradeCount - draftPickLineageCount;
const directMentionCount = playerTradeContexts.reduce(
  (total, row) => total + row.mentions.length,
  0
);
const hasOnlyDirectPlayerTrades = directPlayerTradeCount === tradeCount;

const distinctVerdicts = [
  ...new Set(
    relatedTrades
      .map((trade) => String(trade.verdict || "").trim())
      .filter(Boolean)
  ),
];

const duplicateDisambiguator =
  duplicateNameCount > 1 ? ` (${yearSpan})` : "";

// Distinguish player-transfer history from traded draft picks that later
// produced or referenced the player. Do not falsely claim an athlete was traded.
const profileHeading = hasOnlyDirectPlayerTrades
  ? `${player.name} NFL Trade History${duplicateDisambiguator}`
  : directPlayerTradeCount > 0
    ? `${player.name} Player Trades and Draft-Pick History${duplicateDisambiguator}`
    : draftPickLineageCount > 0
      ? `${player.name} NFL Draft-Pick Trade History${duplicateDisambiguator}`
      : `${player.name} NFL Trade-Related Records${duplicateDisambiguator}`;
const titleCore = hasOnlyDirectPlayerTrades
  ? `${player.name}${duplicateDisambiguator}: ${tradeCount} NFL Trade${tradeCount === 1 ? "" : "s"}${duplicateNameCount > 1 ? "" : ` (${yearSpan})`}`
  : profileHeading;
const shorterTitle = hasOnlyDirectPlayerTrades
  ? `${player.name}${duplicateDisambiguator} NFL Trades`
  : draftPickLineageCount > 0 && directPlayerTradeCount === 0
    ? `${player.name} NFL Draft-Pick Trades`
    : `${player.name} NFL Trade Records`;
const title = `${titleCore.length <= 53 ? titleCore : shorterTitle} | TradeVerdicts`;
const singleTradeDescription =
  tradeCount === 1 && firstTrade
    ? `See the ${String(firstTrade.tradeDate || "").slice(0, 4)} NFL trade involving ${player.name}: ${firstTrade.teams.map(formatTeamName).join(" and ")}. Review the assets, team grades and final verdict.`
    : "";
// Official NFL/team draft records distinguish these same-name athletes.
// Only the seven exact first-party-verified public identities receive distinct pick-trade snippets.
// Never describe a traded selection as an actual player transfer.
const sourcedSameNamePickDescriptors = {
  "chris-jones-dt-2013": "Chris Jones, the 2013 Texans DT from Bowling Green",
  "chris-jones-wr-1995": "Chris T. Jones, the 1995 Eagles WR from Miami",
  "chris-jones": "Chris Jones, the 2016 Chiefs DL from Mississippi State",
  "kevin-smith-cb-1992": "Kevin Smith, the 1992 Cowboys CB from Texas A&M",
  "kevin-smith-ucla-1992": "Kevin Smith, the 1992 Raiders draft pick from UCLA",
  "reggie-brown": "Reggie Brown, the 1996 Lions LB from Texas A&M",
  "reggie-brown-seahawks-1996": "Reggie Brown, the 1996 Seahawks RB from Fresno State",
};
const sourcedPickDescription = sourcedSameNamePickDescriptors[player.slug]
  ? `Explore NFL draft-pick trades linked to ${sourcedSameNamePickDescriptors[player.slug]}. These records trace exchanged selections, not a player transfer.`
  : null;
const description = hasOnlyDirectPlayerTrades
  ? tradeCount === 1 && firstTrade
    ? singleTradeDescription.length <= 158
      ? singleTradeDescription
      : `See the ${String(firstTrade.tradeDate || "").slice(0, 4)} NFL trade involving ${player.name}, including exchanged assets, team grades and the final verdict.`
    : `${player.name}: ${tradeCount} documented NFL trades (${yearSpan}) across ${teamSlugs.length} teams. Explore assets received, draft picks, grades and verdicts.`
  : directPlayerTradeCount > 0
    ? `Explore ${player.name}'s documented player trades and related draft-pick transactions. Compare actual exchanged assets, original grades and verdicts.`
    : draftPickLineageCount > 0
      ? sourcedPickDescription || `See NFL trades of draft selections later linked to ${player.name}. These records trace traded picks, not a documented player transfer. Explore sources and verdicts.`
      : `Explore NFL transactions linked to ${player.name}, with recorded assets, teams, grades, historical context and source-backed verdicts.`;

const pageUrl = new URL(
  `/players/${player.slug}/`,
  Astro.site
).href;

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: profileHeading,
  description,
  url: pageUrl,
  mainEntity: {
    "@type": "Person",
    name: player.name,
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Players",
      item: new URL("/players/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: player.name,
      item: pageUrl,
    },
  ],
};

const tradeCards = relatedTrades.map(
  (trade, index) => ({
    trade,
    sequence: index + 1,
    teamSlugs: Array.isArray(trade.teams)
      ? trade.teams
      : [],
    teamLabel: Array.isArray(trade.teams) &&
      trade.teams.length > 0
      ? new Intl.ListFormat("en-US", {
          style: "long",
          type: "conjunction",
        }).format(
          trade.teams.map(formatTeamName)
        )
      : "NFL Trade",
    gradeEntries: getGradeEntries(trade),
    assetGroups: getAssetGroups(trade),
  })
);
---

<BaseLayout
  title={title}
  description={description}
  indexEligible={playerEligibility.indexEligible}
  adEligible={playerEligibility.adEligible}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(profileSchema)}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <main class="player-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/players/">Players</a>
      <span aria-hidden="true">/</span>
      <span>{player.name}</span>
    </nav>

    <section class="player-hero">
      <p class="eyebrow">{hasOnlyDirectPlayerTrades ? "NFL Player Trade History" : "NFL Trade and Draft-Pick Connections"}</p>
      <h1>{profileHeading}</h1>

      <p class="hero-summary">
        TradeVerdicts links {player.name} to {tradeCount} sourced NFL
        transaction{tradeCount === 1 ? "" : "s"} involving {teamLabel}.
        {" "}{directPlayerTradeCount} linked trade{directPlayerTradeCount === 1 ? "" : "s"}
        {" "}record{directPlayerTradeCount === 1 ? "s" : ""} the player as an exchanged asset;
        {" "}{draftPickLineageCount} trace{draftPickLineageCount === 1 ? "s" : ""} draft picks
        {" "}associated with the name.
        {draftPickLineageCount > 0 && directPlayerTradeCount === 0 && (
          <> The linked records do not establish a direct trade of the player.</>
        )}
        {otherRelatedCount > 0 && (
          <> Additional relationships require original asset or identity review.</>
        )}
      </p>

      <div class="stat-grid">
        <div class="stat-card">
          <strong>{tradeCount}</strong>
          <span>Related trade record{tradeCount === 1 ? "" : "s"}</span>
        </div>

        <div class="stat-card">
          <strong>{teamSlugs.length}</strong>
          <span>Team{teamSlugs.length === 1 ? "" : "s"} represented</span>
        </div>

        <div class="stat-card">
          <strong>{yearSpan}</strong>
          <span>Trade-history span</span>
        </div>
      </div>

      <div class="team-links">
        <span>Teams in this profile:</span>
        {teamSlugs.map((team) => (
          <a href={getTeamHref(team)}>
            {formatTeamName(team)}
          </a>
        ))}
      </div>
    </section>

    <section class="player-context">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Player Transaction Context</p>
          <h2>Why {player.name} Appears in the Trade Database</h2>
        </div>

        <span class="record-count">
          {directPlayerTradeCount} player-transfer record{directPlayerTradeCount === 1 ? "" : "s"};
          {" "}{draftPickLineageCount} draft-pick link{draftPickLineageCount === 1 ? "" : "s"}
        </span>
      </div>

      <p class="context-intro">
        {tradeCount === 1 && firstTrade ? (
          <>
            This profile is tied to the {formatTradeDate(firstTrade.tradeDate)}
            transaction between {firstTrade.teams.map(formatTeamName).join(" and ")}.
            The card below shows the sourced assets and how {player.name}
            is associated with the transaction. A draft choice referencing a later
            selection is not itself a direct trade of the player.
          </>
        ) : (
          <>
            These {tradeCount} sourced transactions reference {player.name}
            from {formatTradeDate(firstTrade?.tradeDate)} through
            {formatTradeDate(lastTrade?.tradeDate)}. Some links reflect
            draft picks later associated with the player, not player transfers.
            Each connection comes from a specific database relationship.
          </>
        )}
      </p>

      <div class="context-grid">
        {playerTradeContexts.map(({ trade, mentions, relationship }, index) => (
          <article class="context-card">
            <div class="context-card-topline">
              <div>
                <p class="eyebrow">
                  {relationship === "direct-player-trade"
                    ? "Player traded"
                    : relationship === "draft-pick-lineage"
                      ? "Draft-pick trade lineage"
                      : "Related transaction"}
                  {" "}· Record {index + 1}
                </p>
                <h3>{formatTradeDate(trade.tradeDate)}</h3>
              </div>
              <span>{trade.verdict}</span>
            </div>

            {mentions.length > 0 ? (
              <div class="mention-list">
                {mentions.map((mention) => (
                  <p>
                    <strong>{formatTeamName(mention.team)}</strong>
                    {" "}received {mention.asset}.
                  </p>
                ))}
              </div>
            ) : (
              <p>
                The player-to-trade relationship is explicit in the database,
                although the canonical asset line does not contain an exact
                normalized name match for {player.name}.
              </p>
            )}

            <a href={`/trades/${trade.slug}/`}>
              Open the complete trade analysis
              <span aria-hidden="true">&rarr;</span>
            </a>
          </article>
        ))}
      </div>

      {tradeCount > 1 && (
        <p class="context-foot">
          Across this profile, the recorded verdicts are
          {" "}{distinctVerdicts.join("; ")}. The timeline spans {yearSpan}
          and {teamSlugs.length} represented teams.
        </p>
      )}
    </section>

    <section class="profile-overview">
      <div>
        <p class="eyebrow">How to Read This Profile</p>
        <h2>Trade and Draft-Pick History Overview</h2>
      </div>

      <div class="overview-copy">
        <p>
          Every transaction below comes from an explicit player-to-trade
          relationship in the TradeVerdicts database. Name-only substring
          matching is not used.
        </p>

        <p>
          The cards summarize the date, teams, assets, grades, and verdict.
          Open the full trade page for the complete analysis and sourcing
          context. Grading standards are explained in the
          {" "}
          <a href="/methodology/">TradeVerdicts methodology</a>.
        </p>
      </div>
    </section>

    <section class="trade-history">
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            {tradeCount === 1 ? "Transaction Snapshot" : "Chronological Timeline"}
          </p>
          <h2>
            {tradeCount === 1
              ? "Recorded Related Transaction"
              : `${tradeCount} Related Trade Records`}
          </h2>
        </div>

        <span class="record-count">
          Oldest to newest
        </span>
      </div>

      <div class="trade-list">
        {tradeCards.map((card) => (
          <article class="trade-card">
            <header class="trade-card-header">
              <div>
                <p class="eyebrow">
                  Trade {card.sequence} of {tradeCount}
                </p>
                <h3>{card.teamLabel}</h3>
              </div>

              <time datetime={card.trade.tradeDate}>
                {formatTradeDate(card.trade.tradeDate)}
              </time>
            </header>

            <div class="trade-meta">
              <span class="verdict">
                {card.trade.verdict}
              </span>

              {card.trade.tier && (
                <span>Tier: {card.trade.tier}</span>
              )}

              {card.trade.confidence && (
                <span>
                  Confidence: {card.trade.confidence}
                </span>
              )}
            </div>

            <p class="trade-summary">
              {card.trade.summary}
            </p>

            <div class="detail-grid">
              <section class="detail-panel">
                <h4>Assets Received</h4>

                <div class="asset-groups">
                  {card.assetGroups.map((group) => (
                    <div class="asset-group">
                      <h5>
                        <a href={getTeamHref(group.team)}>
                          {formatTeamName(group.team)}
                        </a>
                      </h5>

                      <ul>
                        {group.items.map((item) => (
                          <li>
                            <span class="asset-type">
                              {formatAssetType(item.type)}
                            </span>
                            <span>{item.asset}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </section>

              <section class="detail-panel">
                <h4>Team Grades</h4>

                <div class="grade-grid">
                  {card.gradeEntries.map((entry) => (
                    <div class="grade-row">
                      <a href={getTeamHref(entry.team)}>
                        {formatTeamName(entry.team)}
                      </a>
                      <strong>{entry.grade}</strong>
                    </div>
                  ))}
                </div>
              </section>
            </div>

            <a
              class="detail-link"
              href={`/trades/${card.trade.slug}/`}
            >
              Read the full trade verdict
              <span aria-hidden="true">&rarr;</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <aside class="directory-return">
      <div>
        <p class="eyebrow">Continue Browsing</p>
        <h2>Find Another Player</h2>
        <p>
          Return to the paginated player directory or search the verified
          public-player index.
        </p>
      </div>

      <a href="/players/">Open the player directory</a>
    </aside>
  </main>
</BaseLayout>

<style>
  .player-page {
    display: grid;
    gap: 24px;
    width: min(1120px, 100%);
    margin: 0 auto;
    padding: 42px 20px 80px;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .breadcrumbs a,
  .profile-overview a {
    color: var(--accent);
  }

  .player-hero,
  .player-context,
  .profile-overview,
  .trade-history,
  .directory-return {
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--panel);
    padding: clamp(22px, 4vw, 38px);
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin-bottom: 9px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.8rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
    margin-bottom: 18px;
  }

  h2,
  h3,
  h4,
  h5 {
    line-height: 1.2;
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  h3 {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  h4 {
    margin-bottom: 14px;
  }

  h5 {
    margin-bottom: 8px;
  }

  p {
    color: var(--muted);
    line-height: 1.7;
  }

  .hero-summary {
    max-width: 820px;
    font-size: 1.08rem;
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 26px;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    gap: 7px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--panel-2);
    padding: 17px;
  }

  .stat-card strong {
