---
import BaseLayout from "../../layouts/BaseLayout.astro";
import players from "../../data/nfl/players.json";
import trades from "../../data/nfl/trades.json";
import {
  createEligibilityContext,
} from "../../utils/eligibility.js";
import {
  getPublicPlayerRecords,
  getSearchablePlayerRecords,
  getSearchableRelatedPublicTrades,
  getPublicTrades,
  getRelatedPublicTrades,
  getTradeEligibility,
} from "../../utils/publicRecords.js";
import {
  createPlayerEligibilityContext,
  getPlayerEligibility,
} from "../../utils/playerEligibility.js";

export function getStaticPaths() {
  const routePublicTrades = getPublicTrades(trades);
  const routePublicPlayers = getSearchablePlayerRecords(
    players,
    routePublicTrades
  );
  const routeTradeEligibilityContext =
    createEligibilityContext(trades);
  const routePlayerEligibilityContext =
    createPlayerEligibilityContext(
      routePublicPlayers,
      routePublicTrades,
      routeTradeEligibilityContext
    );

  return routePublicPlayers.map((player) => {
    const playerEligibility = getPlayerEligibility(
      player,
      routePublicTrades,
      routePlayerEligibilityContext
    );

    const relatedTrades = getSearchableRelatedPublicTrades(
      player,
      routePublicTrades
    ).sort(
      (a, b) =>
        new Date(a.tradeDate) - new Date(b.tradeDate)
    );

    return {
      params: { player: player.slug },
      props: {
        player,
        playerEligibility,
        relatedTrades,
      },
    };
  });
}

const {
  player,
  playerEligibility,
  relatedTrades,
} = Astro.props;

const profileTradeEligibilityContext =
  createEligibilityContext(trades);

const formatTeamName = (slug) =>
  String(slug || "")
    .split("-")
    .filter(Boolean)
    .map((word) =>
      word === "49ers"
        ? "49ers"
        : word.charAt(0).toUpperCase() + word.slice(1)
    )
    .join(" ");

const formatTradeDate = (value) => {
  const raw = String(value || "").trim();
  const match = raw.match(/^(\d{4})-(\d{2})-(\d{2})$/);

  if (!match) return raw || "Date unavailable";

  const [, year, month, day] = match;

  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  }).format(
    new Date(
      Date.UTC(
        Number(year),
        Number(month) - 1,
        Number(day)
      )
    )
  );
};

const formatAssetType = (value) =>
  String(value || "asset")
    .replace(/[_-]+/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .split(" ")
    .map(
      (word) =>
        word.charAt(0).toUpperCase() +
        word.slice(1)
    )
    .join(" ");

const getGradeEntries = (trade) =>
  Object.entries(
    trade.grades &&
      typeof trade.grades === "object"
      ? trade.grades
      : {}
  )
    .filter(
      ([team, grade]) =>
        String(team || "").trim() &&
        String(grade || "").trim()
    )
    .map(([team, grade]) => ({
      team,
      grade: String(grade).trim(),
    }));

const getAssetGroups = (trade) =>
  Object.entries(
    trade.assetsReceived &&
      typeof trade.assetsReceived === "object"
      ? trade.assetsReceived
      : {}
  )
    .map(([team, items]) => ({
      team,
      items: Array.isArray(items)
        ? items
            .filter(
              (item) =>
                item &&
                String(item.asset || "").trim()
            )
            .map((item) => ({
              type: String(item.type || "asset").trim(),
              asset: String(item.asset || "").trim(),
            }))
        : [],
    }))
    .filter((group) => group.items.length > 0);

const teamSlugs = [
  ...new Set(
    relatedTrades.flatMap((trade) =>
      Array.isArray(trade.teams)
        ? trade.teams
        : []
    )
  ),
];

const teamNames = teamSlugs.map(formatTeamName);

const years = relatedTrades
  .map((trade) => {
    const dateYear = Number(
      String(trade.tradeDate || "").slice(0, 4)
    );
    const seasonYear = Number(trade.season);

    return Number.isFinite(dateYear)
      ? dateYear
      : Number.isFinite(seasonYear)
        ? seasonYear
        : null;
  })
  .filter((year) => year !== null);

const firstYear =
  years.length > 0 ? Math.min(...years) : null;

const lastYear =
  years.length > 0 ? Math.max(...years) : null;

const yearSpan =
  firstYear && lastYear
    ? firstYear === lastYear
      ? String(firstYear)
      : `${firstYear}–${lastYear}`
    : "Historical record";

const teamLabel =
  teamNames.length > 0
    ? new Intl.ListFormat("en-US", {
        style: "long",
        type: "conjunction",
      }).format(teamNames)
    : "the teams involved";

const tradeCount = relatedTrades.length;

const title =
  tradeCount === 1
    ? `${player.name} NFL Trade Profile | TradeVerdicts`
    : `${player.name} NFL Trade History (${tradeCount} Trades) | TradeVerdicts`;

const description =
  tradeCount === 1
    ? `Review the recorded NFL trade involving ${player.name}, including the teams, assets, grades, and TradeVerdicts verdict.`
    : `Explore ${player.name}'s ${tradeCount} recorded NFL trades, with dates, teams, assets, grades, and TradeVerdicts verdicts.`;

const pageUrl = new URL(
  `/players/${player.slug}/`,
  Astro.site
).href;

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: `${player.name} NFL Trade Profile`,
  description,
  url: pageUrl,
  mainEntity: {
    "@type": "Person",
    name: player.name,
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: new URL("/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Players",
      item: new URL("/players/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: player.name,
      item: pageUrl,
    },
  ],
};

const tradeCards = relatedTrades.map(
  (trade, index) => ({
    trade,
    sequence: index + 1,
    teamSlugs: Array.isArray(trade.teams)
      ? trade.teams
      : [],
    teamLabel: Array.isArray(trade.teams) &&
      trade.teams.length > 0
      ? new Intl.ListFormat("en-US", {
          style: "long",
          type: "conjunction",
        }).format(
          trade.teams.map(formatTeamName)
        )
      : "NFL Trade",
    gradeEntries: getGradeEntries(trade),
    assetGroups: getAssetGroups(trade),
  })
);
---

<BaseLayout
  title={title}
  description={description}
  indexEligible={playerEligibility.indexEligible}
  adEligible={playerEligibility.adEligible}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(profileSchema)}
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <main class="player-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/players/">Players</a>
      <span aria-hidden="true">/</span>
      <span>{player.name}</span>
    </nav>

    <section class="player-hero">
      <p class="eyebrow">Verified NFL Trade Profile</p>
      <h1>{player.name}</h1>

      <p class="hero-summary">
        {tradeCount === 1 ? (
          <>
            TradeVerdicts connects {player.name} to one exact public
            NFL transaction involving {teamLabel}.
          </>
        ) : (
          <>
            TradeVerdicts connects {player.name} to {tradeCount} exact
            public NFL transactions involving {teamLabel}.
          </>
        )}
      </p>

      <div class="stat-grid">
        <div class="stat-card">
          <strong>{tradeCount}</strong>
          <span>Recorded trade{tradeCount === 1 ? "" : "s"}</span>
        </div>

        <div class="stat-card">
          <strong>{teamSlugs.length}</strong>
          <span>Team{teamSlugs.length === 1 ? "" : "s"} represented</span>
        </div>

        <div class="stat-card">
          <strong>{yearSpan}</strong>
          <span>Trade-history span</span>
        </div>
      </div>

      <div class="team-links">
        <span>Teams in this profile:</span>
        {teamSlugs.map((team) => (
          <a href={`/teams/${team}/`}>
            {formatTeamName(team)}
          </a>
        ))}
      </div>
    </section>

    <section class="profile-overview">
      <div>
        <p class="eyebrow">How to Read This Profile</p>
        <h2>Trade History Overview</h2>
      </div>

      <div class="overview-copy">
        <p>
          Every transaction below comes from an explicit player-to-trade
          relationship in the TradeVerdicts database. Name-only substring
          matching is not used.
        </p>

        <p>
          The cards summarize the date, teams, assets, grades, and verdict.
          Open the full trade page for the complete analysis and sourcing
          context. Grading standards are explained in the
          {" "}
          <a href="/methodology/">TradeVerdicts methodology</a>.
        </p>
      </div>
    </section>

    <section class="trade-history">
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            {tradeCount === 1 ? "Transaction Snapshot" : "Chronological Timeline"}
          </p>
          <h2>
            {tradeCount === 1
              ? "Recorded Trade"
              : `${tradeCount} Recorded Trades`}
          </h2>
        </div>

        <span class="record-count">
          Oldest to newest
        </span>
      </div>

      <div class="trade-list">
        {tradeCards.map((card) => (
          <article class="trade-card">
            <header class="trade-card-header">
              <div>
                <p class="eyebrow">
                  Trade {card.sequence} of {tradeCount}
                </p>
                <h3>{card.teamLabel}</h3>
              </div>

              <time datetime={card.trade.tradeDate}>
                {formatTradeDate(card.trade.tradeDate)}
              </time>
            </header>

            <div class="trade-meta">
              <span class="verdict">
                {card.trade.verdict}
              </span>

              {card.trade.tier && (
                <span>Tier: {card.trade.tier}</span>
              )}

              {card.trade.confidence && (
                <span>
                  Confidence: {card.trade.confidence}
                </span>
              )}
            </div>

            <p class="trade-summary">
              {card.trade.summary}
            </p>

            <div class="detail-grid">
              <section class="detail-panel">
                <h4>Assets Received</h4>

                <div class="asset-groups">
                  {card.assetGroups.map((group) => (
                    <div class="asset-group">
                      <h5>
                        <a href={`/teams/${group.team}/`}>
                          {formatTeamName(group.team)}
                        </a>
                      </h5>

                      <ul>
                        {group.items.map((item) => (
                          <li>
                            <span class="asset-type">
                              {formatAssetType(item.type)}
                            </span>
                            <span>{item.asset}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              </section>

              <section class="detail-panel">
                <h4>Team Grades</h4>

                <div class="grade-grid">
                  {card.gradeEntries.map((entry) => (
                    <div class="grade-row">
                      <a href={`/teams/${entry.team}/`}>
                        {formatTeamName(entry.team)}
                      </a>
                      <strong>{entry.grade}</strong>
                    </div>
                  ))}
                </div>
              </section>
            </div>

            {getTradeEligibility(
              card.trade,
              profileTradeEligibilityContext
            ).indexEligible ? (
              <a
                class="detail-link"
                href={`/trades/${card.trade.slug}/`}
              >
                Read the full trade verdict
                <span aria-hidden="true">&rarr;</span>
              </a>
            ) : (
              <span class="detail-link archive-record-label">
                Historical archive record
              </span>
            )}
          </article>
        ))}
      </div>
    </section>

    <aside class="directory-return">
      <div>
        <p class="eyebrow">Continue Browsing</p>
        <h2>Find Another Player</h2>
        <p>
          Return to the paginated player directory or search the verified
          public-player index.
        </p>
      </div>

      <a href="/players/">Open the player directory</a>
    </aside>
  </main>
</BaseLayout>

<style>
  .player-page {
    display: grid;
    gap: 24px;
    width: min(1120px, 100%);
    margin: 0 auto;
    padding: 42px 20px 80px;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .breadcrumbs a,
  .profile-overview a {
    color: var(--accent);
  }

  .player-hero,
  .profile-overview,
  .trade-history,
  .directory-return {
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--panel);
    padding: clamp(22px, 4vw, 38px);
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin-bottom: 9px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.8rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
    margin-bottom: 18px;
  }

  h2,
  h3,
  h4,
  h5 {
    line-height: 1.2;
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  h3 {
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  h4 {
    margin-bottom: 14px;
  }

  h5 {
    margin-bottom: 8px;
  }

  p {
    color: var(--muted);
    line-height: 1.7;
  }

  .hero-summary {
    max-width: 820px;
    font-size: 1.08rem;
  }

  .stat-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 26px;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    gap: 7px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--panel-2);
    padding: 17px;
  }

  .stat-card strong {
    color: white;
    font-size: 1.25rem;
  }

  .stat-card span {
    color: var(--muted);
    font-size: 0.88rem;
  }

  .team-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin-top: 22px;
    color: var(--muted);
  }

  .team-links a {
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text);
    padding: 7px 10px;
    text-decoration: none;
  }

  .team-links a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .profile-overview {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1.7fr);
    gap: 30px;
  }

  .overview-copy {
    display: grid;
    gap: 14px;
  }

  .section-heading,
  .trade-card-header,
  .directory-return {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  .record-count {
    color: var(--muted);
    white-space: nowrap;
  }

  .trade-list {
    display: grid;
    gap: 18px;
    margin-top: 22px;
  }

  .trade-card {
    border: 1px solid var(--border);
    border-radius: 15px;
    background: var(--panel-2);
    padding: clamp(18px, 3vw, 28px);
  }

  time {
    color: var(--muted);
    white-space: nowrap;
  }

  .trade-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin: 18px 0;
  }

  .trade-meta span {
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.84rem;
    padding: 7px 10px;
  }

  .trade-meta .verdict {
    border-color: rgba(78, 161, 255, 0.55);
    color: white;
  }

  .trade-summary {
    max-width: 900px;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(220px, 0.6fr);
    gap: 16px;
    margin-top: 20px;
  }

  .detail-panel {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 17px;
  }

  .asset-groups,
  .grade-grid {
    display: grid;
    gap: 14px;
  }

  .asset-group ul {
    display: grid;
    gap: 8px;
    list-style: none;
  }

  .asset-group li,
  .grade-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    color: var(--muted);
  }

  .asset-type {
    color: var(--accent);
    flex-shrink: 0;
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .grade-row strong {
    color: white;
  }

  .detail-link,
  .directory-return > a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    color: var(--accent);
    font-weight: 800;
  }

  .directory-return > a {
    margin-top: 0;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .stat-grid,
    .profile-overview,
    .detail-grid {
      grid-template-columns: 1fr;
    }

    .section-heading,
    .trade-card-header,
    .directory-return {
      flex-direction: column;
    }

    time,
    .record-count,
    .directory-return > a {
      white-space: normal;
    }
  }
</style>
