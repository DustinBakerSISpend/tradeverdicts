---
import BaseLayout from "../../layouts/BaseLayout.astro";
import players from "../../data/nfl/players.json";
import trades from "../../data/nfl/trades.json";
import {
  getPublicPlayerRecords,
  getPublicTrades,
} from "../../utils/publicRecords.js";

const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");

const getLastNameInitial = (name) => {
  const parts = String(name || "").trim().split(/\s+/).filter(Boolean);
  const last = parts[parts.length - 1] || "";
  const initial = last.replace(/[^A-Za-z]/g, "").charAt(0).toUpperCase();

  return /^[A-Z]$/.test(initial) ? initial : "";
};

const publicTrades = getPublicTrades(trades);

const sortedPlayers = getPublicPlayerRecords(
  players,
  publicTrades
)
  .filter((player) => getLastNameInitial(player.name))
  .filter((player) => !/^\d+$/.test(String(player.name || "").trim()))
  .filter((player) => !/^a\s+condi/i.test(String(player.name || "").trim()))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<BaseLayout title="NFL Players | TradeVerdicts">
  <main class="page-shell">
    <section class="hero">
      <p class="eyebrow">NFL Player Trade Index</p>
      <h1>Just Type a Player</h1>
      <p class="lede">
        Search every player currently connected to a TradeVerdicts NFL trade record.
      </p>

      <input
        id="playerSearch"
        type="search"
        placeholder="Search players — e.g. Randy Moss, Jerome Bettis, Minkah Fitzpatrick"
        class="player-search"
        autocomplete="off"
      />

      <p class="search-hint">Type a name to see all matching players. Press Enter only opens a single exact or unique match.</p>

      <div class="initial-browse" aria-label="Browse players by last name initial">
        <p>Or browse by last name initial</p>

        <div class="initial-grid">
          {alphabet.map((letter) => (
            <button type="button" class="initial-button" data-initial={letter} aria-pressed="false">
              {letter}
            </button>
          ))}
        </div>
      </div>
    </section>

    <section id="playerResultsCard" class="card" hidden>
      <div class="section-header">
        <h2>Matching Players</h2>
        <p><span id="visibleCount">0</span> matching player profiles</p>
      </div>

      <div class="player-grid">
        {sortedPlayers.map((player) => (
          <a
            class="player-card"
            href={`/players/${player.slug}/`}
            data-player-name={player.name.toLowerCase()}
            data-player-last-initial={getLastNameInitial(player.name)}
          >
            <strong>{player.name}</strong>
            <span>{player.tradeSlugs?.length || 0} related trade{player.tradeSlugs?.length === 1 ? "" : "s"}</span>
          </a>
        ))}
      </div>

      <p id="emptyState" class="empty-state" hidden>
        No player profiles match that search.
      </p>
    </section>
  </main>
</BaseLayout>

<script>
  const search = document.getElementById("playerSearch");
  const visibleCount = document.getElementById("visibleCount");
  const playerResultsCard = document.getElementById("playerResultsCard");
  const emptyState = document.getElementById("emptyState");
  const cards = Array.from(document.querySelectorAll(".player-card"));
  const initialButtons = Array.from(document.querySelectorAll(".initial-button"));
  let activeInitial = "";

  function normalizeName(value) {
    return String(value || "")
      .toLowerCase()
      .replace(/['']/g, "")
      .replace(/[^a-z0-9]+/g, " ")
      .trim();
  }

  function getVisiblePlayerCards() {
    return cards.filter((card) => card.style.display !== "none");
  }

  function filterPlayers() {
    const query = search?.value?.trim().toLowerCase() || "";
    let shown = 0;
    const hasActiveFilter = Boolean(query || activeInitial);

    cards.forEach((card) => {
      const text = card.textContent?.toLowerCase() || "";
      const playerName = card.getAttribute("data-player-name") || "";
      const lastInitial = card.getAttribute("data-player-last-initial") || "";
      const queryMatch = !query || text.includes(query) || playerName.includes(query);
      const initialMatch = !activeInitial || lastInitial === activeInitial;
      const isMatch = hasActiveFilter && queryMatch && initialMatch;

      card.style.display = isMatch ? "flex" : "none";
      if (isMatch) shown++;
    });

    if (playerResultsCard) playerResultsCard.hidden = !hasActiveFilter;
    if (visibleCount) visibleCount.textContent = String(shown);
    if (emptyState) emptyState.hidden = !hasActiveFilter || shown !== 0;

    return shown;
  }

  search?.addEventListener("input", filterPlayers);

  initialButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const initial = button.getAttribute("data-initial") || "";
      activeInitial = activeInitial === initial ? "" : initial;

      initialButtons.forEach((item) => {
        const isActive = item.getAttribute("data-initial") === activeInitial;
        item.classList.toggle("is-active", isActive);
        item.setAttribute("aria-pressed", String(isActive));
      });

      filterPlayers();
    });
  });

  search?.addEventListener("keydown", (event) => {
    if (event.key !== "Enter") return;

    event.preventDefault();

    const query = search?.value?.trim() || "";
    if (!query) return;

    filterPlayers();

    const normalizedQuery = normalizeName(query);
    const visibleCards = getVisiblePlayerCards();

    const exactMatches = visibleCards.filter((card) => (
      normalizeName(card.getAttribute("data-player-name")) === normalizedQuery
    ));

    if (exactMatches.length === 1) {
      window.location.href = exactMatches[0].getAttribute("href");
      return;
    }

    if (visibleCards.length === 1 && normalizedQuery.length >= 3) {
      window.location.href = visibleCards[0].getAttribute("href");
    }
  });

</script>

<style>
  .page-shell {
    max-width: 980px;
    margin: 0 auto;
    padding: 48px 20px 80px;
  }

  .hero {
    margin-bottom: 28px;
  }

  .eyebrow {
    color: #39a7ff;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 10px;
  }

  h1 {
    font-size: clamp(2.8rem, 7vw, 5rem);
    line-height: 0.95;
    margin: 0 0 16px;
    letter-spacing: -0.04em;
  }

  .lede {
    color: #9fb3c8;
    max-width: 720px;
    font-size: 1.05rem;
    margin-bottom: 22px;
  }

  .player-search {
    width: 100%;
    max-width: 720px;
    padding: 15px 16px;
    border-radius: 12px;
    border: 1px solid #2d425b;
    background: #0c131b;
    color: #eaf4ff;
    font-size: 1rem;
    outline: none;
  }

  .player-search:focus {
    border-color: #39a7ff;
    box-shadow: 0 0 0 3px rgba(57, 167, 255, 0.16);
  }

  .search-hint {
    margin: 10px 0 0;
    color: #6f849a;
    font-size: 0.86rem;
  }


  .initial-browse {
    max-width: 720px;
    margin-top: 18px;
  }

  .initial-browse p {
    margin: 0 0 10px;
    color: #eaf4ff;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .initial-grid {
    display: grid;
    grid-template-columns: repeat(13, minmax(44px, 1fr));
    gap: 10px;
  }

  .initial-button {
    min-height: 42px;
    border: 1px solid #2d425b;
    background: #0c131b;
    color: #cfe8ff;
    border-radius: 10px;
    padding: 10px 0;
    font-size: 1rem;
    font-weight: 900;
    cursor: pointer;
  }

  .initial-button:hover,
  .initial-button.is-active {
    border-color: #39a7ff;
    background: #39a7ff;
    color: #06111d;
  }


  .card {
    border: 1px solid #243447;
    background: #111923;
    border-radius: 12px;
    padding: 22px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: end;
    margin-bottom: 18px;
  }

  .section-header h2 {
    margin: 0;
  }

  .section-header p {
    margin: 0;
    color: #9fb3c8;
    font-size: 0.9rem;
  }

  .player-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 12px;
  }

  .player-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px;
    border: 1px solid #26384d;
    border-radius: 10px;
    background: #0c131b;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .player-card:hover {
    border-color: #39a7ff;
    transform: translateY(-1px);
  }

  .player-card strong {
    color: #eaf4ff;
  }

  .player-card span {
    color: #9fb3c8;
    font-size: 0.82rem;
  }

  .empty-state {
    color: #9fb3c8;
    padding: 18px 0 4px;
  }

  @media (max-width: 640px) {
    .section-header {
      align-items: start;
      flex-direction: column;
    }

    .player-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Mobile-safe A-Z player browse */
  .initial-browse {
    width: 100%;
    max-width: 720px;
  }

  .initial-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(42px, 1fr));
    gap: 10px;
  }

  .initial-button {
    min-height: 44px;
    min-width: 0;
    font-size: 1rem;
  }

  @media (max-width: 480px) {
    .page-shell {
      padding-left: 18px;
      padding-right: 18px;
    }

    .initial-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 9px;
    }

    .initial-button {
      min-height: 42px;
      padding: 9px 0;
    }
  }

</style>
