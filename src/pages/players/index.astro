---
import PlayerDirectoryPage from "../../components/PlayerDirectoryPage.astro";
import players from "../../data/nfl/players.json";
import trades from "../../data/nfl/trades.json";
import {
  createPlayerDirectoryRows,
  getPlayerDirectoryPage,
  getPlayerDirectoryTotalPages,
} from "../../utils/playerDirectory.js";

const directoryRows = createPlayerDirectoryRows(players, trades);
const totalPages = getPlayerDirectoryTotalPages(directoryRows);
const rows = getPlayerDirectoryPage(directoryRows, 1);
---

<PlayerDirectoryPage
  rows={rows}
  currentPage={1}
  totalPages={totalPages}
  totalPlayers={directoryRows.length}
/>
