---
import BaseLayout from "../layouts/BaseLayout.astro";
import trades from "../data/nfl/trades.json";
import { getPublicTrades } from "../utils/publicRecords.js";

const publicTrades = getPublicTrades(trades);

const validYears = publicTrades
  .map((trade) => Number(String(trade.tradeDate || "").slice(0, 4)))
  .filter((year) => Number.isInteger(year));

const firstYear = Math.min(...validYears);
const latestYear = Math.max(...validYears);

const yearCounts = new Map();

for (const trade of publicTrades) {
  const year = Number(String(trade.tradeDate || "").slice(0, 4));

  if (!Number.isInteger(year)) continue;

  yearCounts.set(year, (yearCounts.get(year) || 0) + 1);
}

const yearButtons = Array.from(
  { length: latestYear - firstYear + 1 },
  (_, index) => latestYear - index
).map((year) => ({
  year,
  count: yearCounts.get(year) || 0,
}));
---

<BaseLayout title="Browse NFL Trades by Year | TradeVerdicts">
  <main class="year-shell">
    <section class="year-hero">
      <p class="eyebrow">NFL Trade Database</p>
      <h1>Browse Trades by Year</h1>
      <p>
        Choose any season from {firstYear} through {latestYear} to explore every
        public NFL trade recorded in the TradeVerdicts archive.
      </p>
    </section>

    <section class="year-browser" aria-labelledby="year-browser-title">
      <div class="browser-heading">
        <div>
          <p class="panel-label">Complete Year Archive</p>
          <h2 id="year-browser-title">{firstYear}-{latestYear}</h2>
        </div>
        <p>Select a year to load its complete trade history.</p>
      </div>

      <div class="year-buttons" role="group" aria-label="NFL trade years">
        {yearButtons.map(({ year, count }) => (
          <button
            class="year-button"
            type="button"
            data-year-button={String(year)}
            aria-controls="yearResults"
            aria-pressed="false"
            disabled={count === 0}
          >
            <span>{year}</span>
            <strong>
              {count}
              <small>{count === 1 ? "trade" : "trades"}</small>
            </strong>
          </button>
        ))}
      </div>
    </section>

    <section
      id="yearResultsSection"
      class="year-results"
      aria-live="polite"
    >
      <div class="results-header">
        <div>
          <p class="panel-label">Selected Year</p>
          <h2 id="yearTitle">Select a year above.</h2>
        </div>
        <strong id="yearCount"></strong>
      </div>

      <div id="yearResults">
        <div class="placeholder-card">
          Choose a year to view its trades.
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const buttons = Array.from(
    document.querySelectorAll("[data-year-button]")
  );
  const title = document.getElementById("yearTitle");
  const count = document.getElementById("yearCount");
  const results = document.getElementById("yearResults");

  let yearIndexPromise;

  const escapeHtml = (value = "") =>
    String(value).replace(/[&<>"']/g, (character) => {
      const entities = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;",
      };

      return entities[character];
    });

  const formatTeamName = (slug = "") =>
    String(slug)
      .split("-")
      .filter(Boolean)
      .map((word) =>
        word === "49ers"
          ? "49ers"
          : word.charAt(0).toUpperCase() + word.slice(1)
      )
      .join(" ");

  const formatFullDate = (date = "") => {
    const parsed = new Date(`${date}T00:00:00`);

    if (Number.isNaN(parsed.getTime())) {
      return date || "Date unavailable";
    }

    return parsed.toLocaleDateString("en-US", {
      month: "long",
      day: "numeric",
      year: "numeric",
    });
  };

  const getAssetName = (asset = {}) =>
    asset.asset ||
    asset.name ||
    asset.description ||
    "Unspecified asset";

  const renderAssets = (trade, teamSlug) => {
    const assets = trade.assetsReceived?.[teamSlug] || [];

    if (!assets.length) {
      return '<p class="no-assets">No recorded return.</p>';
    }

    return `
      <ul>
        ${assets
          .map(
            (asset) =>
              `<li>${escapeHtml(getAssetName(asset))}</li>`
          )
          .join("")}
      </ul>
    `;
  };

  const renderTrade = (trade) => {
    const teams = trade.teams || [];
    const teamNames = teams.map(formatTeamName);

    return `
      <article class="trade-result">
        <div class="trade-topline">
          <div>
            <time datetime="${escapeHtml(trade.tradeDate)}">
              ${escapeHtml(formatFullDate(trade.tradeDate))}
            </time>
            <span>${escapeHtml(teamNames.join(" / "))}</span>
          </div>
          <strong>${escapeHtml(trade.verdict || "Verdict pending")}</strong>
        </div>

        <div class="grade-grid">
          ${teams
            .map(
              (team) => `
                <div>
                  <span>${escapeHtml(formatTeamName(team))}</span>
                  <strong>${escapeHtml(trade.grades?.[team] || "-")}</strong>
                </div>
              `
            )
            .join("")}
        </div>

        <div class="asset-grid">
          ${teams
            .map(
              (team) => `
                <section>
                  <h3>${escapeHtml(formatTeamName(team))} received</h3>
                  ${renderAssets(trade, team)}
                </section>
              `
            )
            .join("")}
        </div>

        <p class="trade-summary">
          ${escapeHtml(trade.summary || "Summary unavailable.")}
        </p>

        <a
          class="trade-link"
          href="/trades/${encodeURIComponent(trade.slug)}/"
        >
          View full trade verdict
        </a>
      </article>
    `;
  };

  const getYearIndex = () => {
    if (!yearIndexPromise) {
      yearIndexPromise = fetch("/api/trades-by-year.json", {
        headers: {
          Accept: "application/json",
        },
      }).then((response) => {
        if (!response.ok) {
          throw new Error(
            `Year archive request failed with status ${response.status}.`
          );
        }

        return response.json();
      });
    }

    return yearIndexPromise;
  };

  const setActiveButton = (year) => {
    for (const button of buttons) {
      const isActive = button.dataset.yearButton === year;
      button.classList.toggle("active", isActive);
      button.setAttribute("aria-pressed", String(isActive));
    }
  };

  const loadYear = async (year, updateUrl = true) => {
    setActiveButton(year);
    title.textContent = `${year} NFL Trade History`;
    count.textContent = "";
    results.innerHTML = '<div class="loading-card">Loading trades...</div>';

    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set("year", year);
      window.history.replaceState({}, "", url);
    }

    try {
      const yearIndex = await getYearIndex();
      const records = yearIndex[year] || [];

      count.textContent = `${records.length} ${
        records.length === 1 ? "trade" : "trades"
      }`;

      if (!records.length) {
        results.innerHTML = `
          <div class="placeholder-card">
            No public NFL trades were found for ${escapeHtml(year)}.
          </div>
        `;
        return;
      }

      results.innerHTML = records.map(renderTrade).join("");

      document
        .getElementById("yearResultsSection")
        ?.scrollIntoView({
          behavior: "smooth",
          block: "start",
        });
    } catch (error) {
      count.textContent = "Unavailable";
      results.innerHTML = `
        <div class="placeholder-card">
          This year could not be loaded. Please refresh and try again.
        </div>
      `;
      console.error(error);
    }
  };

  for (const button of buttons) {
    button.addEventListener("click", () => {
      loadYear(button.dataset.yearButton);
    });
  }

  const initialYear = new URL(window.location.href).searchParams.get("year");
  const validInitialButton = buttons.find(
    (button) =>
      !button.disabled &&
      button.dataset.yearButton === initialYear
  );

  if (validInitialButton) {
    loadYear(initialYear, false);
  }
</script>

<style>
  .year-shell {
    max-width: 1120px;
    margin: 0 auto;
    padding: 52px 20px 80px;
  }

  .year-hero {
    max-width: 820px;
    margin-bottom: 28px;
  }

  .eyebrow,
  .panel-label {
    margin: 0 0 9px;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .year-hero h1 {
    margin: 0 0 14px;
    font-size: clamp(2.4rem, 6vw, 4.7rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .year-hero > p:last-child,
  .browser-heading > p {
    color: var(--muted);
    line-height: 1.65;
  }

  .year-hero > p:last-child {
    max-width: 760px;
    margin: 0;
    font-size: 1.02rem;
  }

  .year-browser,
  .year-results {
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--panel);
    padding: 22px;
  }

  .browser-heading,
  .results-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
  }

  .browser-heading h2,
  .results-header h2 {
    margin: 0;
    letter-spacing: -0.03em;
  }

  .browser-heading > p {
    max-width: 420px;
    margin: 0;
    text-align: right;
  }

  .year-buttons {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 9px;
  }

  .year-button {
    min-height: 74px;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 11px 9px;
    background: rgba(255, 255, 255, 0.035);
    color: white;
    cursor: pointer;
    text-align: left;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .year-button:hover:not(:disabled),
  .year-button.active {
    border-color: var(--accent);
    background: rgba(78, 161, 255, 0.14);
    transform: translateY(-1px);
  }

  .year-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .year-button:disabled {
    cursor: not-allowed;
    opacity: 0.34;
  }

  .year-button > span {
    display: block;
    font-size: 1rem;
    font-weight: 900;
  }

  .year-button > strong {
    display: block;
    margin-top: 8px;
    color: var(--accent);
    font-size: 0.95rem;
  }

  .year-button small {
    margin-left: 3px;
    color: var(--muted);
    font-size: 0.62rem;
    font-weight: 700;
  }

  .year-results {
    margin-top: 22px;
    scroll-margin-top: 20px;
  }

  .results-header > strong {
    color: var(--accent);
  }

  @media (max-width: 980px) {
    .year-buttons {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .year-buttons {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .browser-heading,
    .results-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .browser-heading > p {
      text-align: left;
    }
  }

  @media (max-width: 520px) {
    .year-shell {
      padding: 34px 14px 64px;
    }

    .year-browser,
    .year-results {
      padding: 16px;
    }

    .year-buttons {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<style is:global id="browse-by-year-card-styles">
  #yearResults {
    display: grid;
    gap: 22px;
  }

  #yearResults .trade-result {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid rgba(78, 161, 255, 0.38);
    border-left: 5px solid var(--accent);
    border-radius: 20px;
    background:
      linear-gradient(180deg, rgba(19, 29, 42, 0.99), rgba(8, 13, 20, 0.99));
    box-shadow:
      0 18px 44px rgba(0, 0, 0, 0.34),
      inset 0 1px 0 rgba(255, 255, 255, 0.035);
    padding: 22px;
  }

  #yearResults .loading-card,
  #yearResults .placeholder-card {
    border: 1px solid rgba(78, 161, 255, 0.25);
    border-radius: 18px;
    background: rgba(8, 13, 20, 0.96);
    padding: 20px;
    color: var(--muted);
  }

  #yearResults .trade-topline {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  #yearResults .trade-topline time,
  #yearResults .trade-topline span {
    display: block;
  }

  #yearResults .trade-topline time {
    color: white;
    font-weight: 900;
  }

  #yearResults .trade-topline span {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.82rem;
  }

  #yearResults .trade-topline > strong {
    color: var(--accent);
    text-align: right;
  }

  #yearResults .grade-grid,
  #yearResults .asset-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  #yearResults .grade-grid {
    margin-bottom: 14px;
  }

  #yearResults .asset-grid {
    margin-bottom: 14px;
  }

  #yearResults .grade-grid > div,
  #yearResults .asset-grid > section {
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.045);
  }

  #yearResults .grade-grid > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px;
  }

  #yearResults .grade-grid span {
    color: var(--muted);
    font-size: 0.84rem;
  }

  #yearResults .grade-grid strong {
    color: white;
    font-size: 1.25rem;
  }

  #yearResults .asset-grid > section {
    padding: 14px;
  }

  #yearResults .asset-grid h3 {
    margin: 0 0 8px;
    color: white;
    font-size: 0.9rem;
  }

  #yearResults .asset-grid ul {
    margin: 0;
    padding-left: 18px;
    color: var(--muted);
  }

  #yearResults .asset-grid li + li {
    margin-top: 5px;
  }

  #yearResults .no-assets {
    margin: 0;
    color: var(--muted);
  }

  #yearResults .trade-summary {
    margin: 16px 0 18px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: #bfe0ff;
    line-height: 1.58;
  }

  #yearResults .trade-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    border: 1px solid rgba(78, 161, 255, 0.42);
    border-radius: 10px;
    padding: 8px 13px;
    background: rgba(78, 161, 255, 0.14);
    color: #d9ecff;
    font-size: 0.88rem;
    font-weight: 900;
    text-decoration: none;
    transition:
      background 0.15s ease,
      transform 0.15s ease,
      border-color 0.15s ease;
  }

  #yearResults .trade-link:hover {
    border-color: var(--accent);
    background: rgba(78, 161, 255, 0.24);
    transform: translateY(-1px);
    text-decoration: none;
  }

  @media (max-width: 820px) {
    #yearResults .trade-topline {
      align-items: flex-start;
      flex-direction: column;
    }

    #yearResults .trade-topline > strong {
      text-align: left;
    }
  }

  @media (max-width: 620px) {
    #yearResults .trade-result {
      border-left-width: 4px;
      border-radius: 16px;
      padding: 16px;
    }

    #yearResults .grade-grid,
    #yearResults .asset-grid {
      grid-template-columns: 1fr;
    }
  }
</style>