---
import BaseLayout from "../layouts/BaseLayout.astro";
import TradeCard from "../components/TradeCard.astro";
import trades from "../data/nfl/trades.json";
import players from "../data/nfl/players.json";

const teams = [...new Set(trades.flatMap((trade) => trade.teams || []))];

const formatTeamName = (slug) =>
  slug
    .split("-")
    .map((word) =>
      word === "49ers" ? "49ers" : word.charAt(0).toUpperCase() + word.slice(1)
    )
    .join(" ");

const searchItems = [
  ...players.map((player) => ({
    type: "Player",
    title: player.name,
    subtitle: `${player.tradeSlugs?.length || 0} trade record${player.tradeSlugs?.length === 1 ? "" : "s"}`,
    url: `/players/${player.slug}`,
  })),

  ...teams.map((team) => ({
    type: "Team",
    title: formatTeamName(team),
    subtitle: `${trades.filter((trade) => trade.teams?.includes(team)).length} trade record${trades.filter((trade) => trade.teams?.includes(team)).length === 1 ? "" : "s"}`,
    url: `/teams/${team}`,
  })),

  ...trades.map((trade) => ({
    type: "Trade",
    title: trade.verdict,
    subtitle: `${trade.tradeDate} • ${(trade.teams || []).map(formatTeamName).join(" ↔ ")}`,
    url: `/trades/${trade.slug}`,
  })),
];
---

<BaseLayout title="TradeVerdicts | Sports Trade Database">
  <main>
    <section class="hero">
      <div class="eyebrow">NFL • NBA • MLB • NHL</div>

      <h1>The Sports Trade Database.</h1>

      <p>
        The who, what, when, and where of every sports trade in history.
      </p>

      <form class="search" id="siteSearchForm">
  <input
    id="siteSearch"
    type="text"
    placeholder="Search players, teams, or trades..."
    autocomplete="off"
  />

  <div id="searchResults" class="search-results"></div>
</form>
    </section>

    <section class="league-grid">
      <div class="league-card active">
        <span>NFL</span>
        <strong>Vikings database in progress</strong>
      </div>

      <div class="league-card">
        <span>NBA</span>
        <strong>Coming soon</strong>
      </div>

      <div class="league-card">
        <span>MLB</span>
        <strong>Coming soon</strong>
      </div>

      <div class="league-card">
        <span>NHL</span>
        <strong>Coming soon</strong>
      </div>
    </section>

    <section class="featured">
      <div class="section-header">
        <h2>Featured Trade</h2>
        <a href="/trades">View all trades</a>
      </div>

      <TradeCard
        date="October 22, 2020"
        title="Yannick Ngakoue to Baltimore Ravens"
        summary="Minnesota acquired draft capital while Baltimore added a pass-rush specialist for a playoff push."
        verdict="Verdict: Ravens Win"
        gradeA="BAL: A"
        gradeB="MIN: D"
      />
    </section>
  </main>
</BaseLayout>

<script define:vars={{ searchItems }}>
  const input = document.getElementById("siteSearch");
  const results = document.getElementById("searchResults");

  function normalize(value) {
    return String(value || "").toLowerCase().trim();
  }

  function getMatches(query) {
    return searchItems.filter((item) =>
      normalize(`${item.title} ${item.subtitle} ${item.type}`).includes(query)
    );
  }

  function goToBestMatch() {
    const query = normalize(input.value);
    if (query.length < 2) return;

    const matches = getMatches(query);

    if (matches.length > 0) {
      window.location.assign(matches[0].url);
    }
  }

  input.addEventListener("input", () => {
    const query = normalize(input.value);

    if (query.length < 2) {
      results.innerHTML = "";
      results.classList.remove("active");
      return;
    }

    const matches = getMatches(query).slice(0, 8);

    if (!matches.length) {
      results.innerHTML = `<div class="search-empty">No results found.</div>`;
      results.classList.add("active");
      return;
    }

    results.innerHTML = matches
      .map(
        (item) => `
          <a class="search-result" href="${item.url}">
            <span>${item.type}</span>
            <strong>${item.title}</strong>
            <small>${item.subtitle}</small>
          </a>
        `
      )
      .join("");

    results.classList.add("active");
  });

  const form = document.getElementById("siteSearchForm");

form.addEventListener("submit", (event) => {
  event.preventDefault();

  const query = normalize(input.value);
  if (query.length < 2) return;

  const matches = getMatches(query);

  if (matches.length > 0) {
    window.location.href = matches[0].url;
  }
});
</script>

<style>
  .hero {
    text-align: center;
    margin-bottom: 44px;
  }

  .eyebrow {
    color: var(--accent);
    font-weight: 800;
    letter-spacing: 1px;
    margin-bottom: 16px;
    font-size: 0.9rem;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 5vw, 4.4rem);
    margin-bottom: 15px;
  }

  .hero p {
    color: var(--muted);
    margin-bottom: 30px;
    font-size: 1.1rem;
  }

  .search {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
  }

  .search input {
    width: 100%;
    padding: 17px;
    background: var(--panel);
    border: 1px solid var(--border);
    color: white;
    border-radius: 10px;
  }

  .search-results {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    z-index: 20;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    text-align: left;
  }

  .search-results.active {
    display: block;
  }

  .search-result {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }

  .search-result:hover {
    background: var(--panel-2);
  }

  .search-result span {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .search-result small {
    color: var(--muted);
  }

  .search-empty {
    padding: 16px;
    color: var(--muted);
  }

  .league-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 52px;
  }

  .league-card {
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px;
  }

  .league-card span {
    display: block;
    color: var(--accent);
    font-weight: 800;
    margin-bottom: 8px;
  }

  .league-card strong {
    font-size: 0.95rem;
    color: var(--muted);
  }

  .league-card.active {
    border-color: var(--accent);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
  }

  .section-header a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 700;
  }

  @media (max-width: 800px) {
    .league-grid {
      grid-template-columns: 1fr;
    }
  }
</style>