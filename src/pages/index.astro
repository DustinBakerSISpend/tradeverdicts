---
import BaseLayout from "../layouts/BaseLayout.astro";
import TradeCard from "../components/TradeCard.astro";
import trades from "../data/nfl/trades.json";
import players from "../data/nfl/players.json";

const teams = [...new Set(trades.flatMap((trade) => trade.teams || []))];

const formatTeamName = (slug = "") =>
  String(slug)
    .split("-")
    .filter(Boolean)
    .map((word) =>
      word === "49ers" ? "49ers" : word.charAt(0).toUpperCase() + word.slice(1)
    )
    .join(" ");

const totalTrades = trades.length;
const totalPlayers = players.length;
const totalTeams = teams.length;
const importedTeams = 16;
const nflTeamsTotal = 32;
const rolloutPercent = Math.round((importedTeams / nflTeamsTotal) * 100);

const recentlyAddedTeams = [
  { name: "Chicago Bears", slug: "chicago-bears" },
  { name: "Cleveland Browns", slug: "cleveland-browns" },
  { name: "Indianapolis Colts", slug: "indianapolis-colts" },
  { name: "New York Jets", slug: "new-york-jets" },
  { name: "Detroit Lions", slug: "detroit-lions" },
];

const tradeText = (trade) => JSON.stringify(trade || "").toLowerCase();

const findTrade = (matcher) => trades.find(matcher);

const featuredWalkerTrade = findTrade((trade) =>
  tradeText(trade).includes("herschel walker")
);

const biggestVerdicts = [
  {
    trade: featuredWalkerTrade,
    title: "Herschel Walker Trade",
    verdict: "Cowboys Win",
    summary:
      "One of the most consequential trades in NFL history and a franchise-altering victory for Dallas.",
  },
  {
    trade: findTrade(
      (trade) =>
        tradeText(trade).includes("eric dickerson") &&
        trade.tradeDate?.startsWith("1992") &&
        trade.teams?.includes("indianapolis-colts")
    ),
    title: "Eric Dickerson to the Colts",
    verdict: "Colts Win",
    summary: "Indianapolis squeezed useful value from the end of a legendary career.",
  },
  {
    trade: findTrade(
      (trade) =>
        tradeText(trade).includes("myles garrett") &&
        trade.teams?.includes("cleveland-browns") &&
        trade.teams?.includes("los-angeles-rams")
    ),
    title: "Myles Garrett to the Rams",
    verdict: "Even Trade",
    summary: "A modern blockbuster with future-pick value still unresolved.",
  },
  {
    trade: findTrade(
      (trade) =>
        tradeText(trade).includes("eric dickerson") &&
        trade.tradeDate?.startsWith("1993") &&
        trade.teams?.includes("atlanta-falcons")
    ),
    title: "Eric Dickerson to Atlanta",
    verdict: "Raiders Win",
    summary: "The Raiders moved off the aging star and came away with the better return.",
  },
]
  .filter((item) => item.trade)
  .map((item) => ({
    ...item,
    url: `/trades/${item.trade.slug}`,
  }));

const searchItems = [
  ...players.map((player) => ({
    type: "Player",
    title: player.name,
    subtitle: `${player.tradeSlugs?.length || 0} trade record${player.tradeSlugs?.length === 1 ? "" : "s"}`,
    url: `/players/${player.slug}`,
  })),

  ...teams.map((team) => {
    const teamTrades = trades
      .filter((trade) => trade.publishStatus !== "hold-conflict")
      .filter((trade) => trade.teams?.includes(team)).length;

    return {
      type: "Team",
      title: formatTeamName(team),
      subtitle: `${teamTrades} trade record${teamTrades === 1 ? "" : "s"}`,
      url: `/teams/${team}`,
    };
  }),

  ...trades.map((trade) => ({
    type: "Trade",
    title: trade.verdict,
    subtitle: `${trade.tradeDate} • ${(trade.teams || []).map(formatTeamName).join(" ↔ ")}`,
    url: `/trades/${trade.slug}`,
  })),
];
---

<BaseLayout title="TradeVerdicts | Sports Trade Database">
  <main>
    <section class="hero">
      <div class="hero-inner">
        <div class="eyebrow">NFL • NBA • MLB • NHL</div>
        <h1>The Sports Trade Database.</h1>
        <p>The who, what, when, and where of every sports trade in history.</p>

        <form class="search" id="siteSearchForm">
          <input id="siteSearch" type="text" placeholder="Search players, teams, or trades..." autocomplete="off" />
        </form>

        <div class="hero-stats" aria-label="TradeVerdicts database stats">
          <div class="stat-card"><strong>{totalTrades.toLocaleString()}</strong><span>NFL Trades</span></div>
          <div class="stat-card"><strong>{totalPlayers.toLocaleString()}</strong><span>Players</span></div>
          <div class="stat-card"><strong>{totalTeams.toLocaleString()}</strong><span>Teams</span></div>
          <div class="stat-card"><strong>{importedTeams}</strong><span>Teams Imported</span></div>
        </div>
      </div>
    </section>

    <section class="league-grid">
      <a class="league-card active" href="/teams"><span>Teams</span><strong>Browse every NFL team →</strong></a>
      <a class="league-card" href="/players"><span>Players</span><strong>Search player trade history →</strong></a>
      <a class="league-card" href="/trades"><span>Trades</span><strong>Explore all trade records →</strong></a>
      <a class="league-card" href="/trades"><span>Verdicts</span><strong>Find the biggest wins →</strong></a>
    </section>

    <section class="rollout-panel">
      <div>
        <p class="kicker">NFL Rollout</p>
        <h2>Halfway through the NFL trade archive.</h2>
        <p>TradeVerdicts is importing every NFL team first, with NBA, MLB, and NHL expansion planned after the football database is stable.</p>
      </div>
      <div class="progress-card">
        <div class="progress-top"><strong>{importedTeams} / {nflTeamsTotal}</strong><span>{rolloutPercent}% imported</span></div>
        <div class="progress-bar"><span style={`width: ${rolloutPercent}%`}></span></div>
        <small>Next up: Vikings rebuild, final NFL teams, full public NFL launch.</small>
      </div>
    </section>

    <section class="recent-teams">
      <div class="section-header"><h2>Recently Added Teams</h2><a href="/teams">Browse all teams</a></div>
      <div class="team-strip">
        {recentlyAddedTeams.map((team) => (
          <a href={`/teams/${team.slug}`} class="team-pill"><span>{team.name}</span><strong>View trades →</strong></a>
        ))}
      </div>
    </section>

    <section class="featured">
      <div class="section-header"><h2>Featured Trade</h2><a href="/trades">View all trades</a></div>
      <TradeCard
        date="October 12, 1989"
        title="Herschel Walker to Minnesota Vikings"
        summary="Dallas turned one star running back into a haul that helped build a dynasty. Minnesota paid heavily and never reached a Super Bowl."
        verdict="Verdict: Cowboys Win"
        gradeA="DAL: A+"
        gradeB="MIN: F"
      />
    </section>

    <section class="verdicts-section">
      <div class="section-header"><h2>Biggest Verdicts</h2><a href="/trades">Explore trades</a></div>
      <div class="verdict-grid">
        {biggestVerdicts.map((item) => (
          <a class="verdict-card" href={item.url}>
            <span>{item.verdict}</span>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="browse-section">
      <div class="section-header"><h2>Browse by Angle</h2></div>
      <div class="browse-grid">
        <a href="/trades">Team Wins</a>
        <a href="/trades">Partner Wins</a>
        <a href="/trades">Even Trades</a>
        <a href="/trades">Major Trades</a>
        <a href="/trades">High Confidence</a>
        <a href="/players">Player Trade Trees</a>
      </div>
    </section>

    <section class="method-panel">
      <div><p class="kicker">How verdicts work</p><h2>Every trade is graded with hindsight.</h2></div>
      <p>TradeVerdicts weighs player value, draft return, roster impact, championships, timing, and long-term outcome. The goal is simple: show who actually won the trade after the dust settled.</p>
    </section>

    <section class="coming-next">
      <div class="section-header"><h2>Coming Next</h2></div>
      <div class="next-grid">
        <div><span>NFL</span><strong>Full league rollout</strong><p>Final team imports, Vikings rebuild, and database QA are underway.</p></div>
        <div><span>NBA</span><strong>Late June build</strong><p>Basketball trades are next after the NFL archive is stable.</p></div>
        <div><span>MLB/NHL</span><strong>Future expansion</strong><p>Baseball and hockey will follow once the core sports framework is complete.</p></div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const input = document.getElementById("siteSearch");
  const form = document.getElementById("siteSearchForm");
  const results = document.getElementById("searchResults");

  if (results) {
    results.remove();
  }

  form.addEventListener("submit", (event) => {
    event.preventDefault();

    const query = String(input.value || "").trim();

    if (query.length < 2) return;

    window.location.href = `/search?q=${encodeURIComponent(query)}`;
  });
</script>

<style>
  .hero { position: relative; text-align: center; margin-bottom: 34px; padding: 54px 0 36px; overflow: hidden; border-radius: 0 0 28px 28px; }
  .hero::before { content: ""; position: absolute; inset: -18px 0 0; background-image: url("/tradeverdicts-hero-collage.png"); background-repeat: no-repeat; background-position: center top; background-size: min(1680px, 132vw) auto; opacity: 0.32; pointer-events: none; z-index: 0; }
  .hero::after { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 50% 18%, rgba(27, 64, 104, 0.18), transparent 42%), linear-gradient(180deg, rgba(5, 10, 16, 0.22) 0%, rgba(5, 10, 16, 0.58) 42%, rgba(5, 10, 16, 0.88) 100%); pointer-events: none; z-index: 0; }
  .hero-inner { position: relative; z-index: 1; max-width: 980px; margin: 0 auto; }
  .eyebrow, .kicker { color: var(--accent); font-weight: 800; letter-spacing: 1px; margin-bottom: 16px; font-size: 0.9rem; text-transform: uppercase; }
  .hero h1 { font-size: clamp(2.6rem, 5vw, 4.8rem); line-height: 0.98; letter-spacing: -0.045em; margin-bottom: 15px; text-shadow: 0 18px 54px rgba(0, 0, 0, 0.62); }
  .hero p { color: var(--muted); margin-bottom: 30px; font-size: 1.1rem; text-shadow: 0 10px 30px rgba(0, 0, 0, 0.7); }

  .search { position: relative; max-width: 760px; margin: 0 auto; }
  .search input { width: 100%; padding: 17px; background: rgba(17, 25, 35, 0.9); border: 1px solid var(--border); color: white; border-radius: 10px; outline: none; box-shadow: 0 18px 48px rgba(0,0,0,.28); backdrop-filter: blur(8px); }
  .search input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(57,167,255,.16), 0 18px 48px rgba(0,0,0,.28); }
  .search-results { display: none; position: absolute; top: calc(100% + 8px); left: 0; right: 0; z-index: 20; background: var(--panel); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; text-align: left; box-shadow: 0 22px 60px rgba(0,0,0,.36); }
  .search-results.active { display: block; }
  .search-result { display: grid; gap: 4px; padding: 14px 16px; color: inherit; text-decoration: none; border-bottom: 1px solid var(--border); }
  .search-result:hover { background: var(--panel-2); }
  .search-result span { color: var(--accent); font-size: .75rem; font-weight: 800; text-transform: uppercase; }
  .search-result small, .search-empty { color: var(--muted); }
  .search-empty { padding: 16px; }

  .hero-stats { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 14px; max-width: 860px; margin: 30px auto 0; }
  .stat-card { border: 1px solid rgba(80,160,255,.3); background: linear-gradient(180deg, rgba(24,37,54,.9), rgba(13,21,31,.92)); border-radius: 15px; padding: 17px 14px; text-align: center; box-shadow: 0 18px 40px rgba(0,0,0,.24); backdrop-filter: blur(8px); }
  .stat-card strong { display: block; color: #f5f7fb; font-size: 1.65rem; line-height: 1; letter-spacing: -.035em; }
  .stat-card span { display: block; margin-top: 8px; color: #9fc7ff; font-size: .76rem; font-weight: 800; text-transform: uppercase; letter-spacing: .09em; }

  .league-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 34px; }
  .league-card, .team-pill, .verdict-card, .browse-grid a, .next-grid div, .rollout-panel, .method-panel { background: var(--panel-2); border: 1px solid var(--border); border-radius: 12px; }
  .league-card, .team-pill, .verdict-card { display: block; padding: 18px; text-decoration: none; color: inherit; transition: transform .15s ease, border-color .15s ease, background .15s ease; }
  .league-card span, .team-pill strong, .verdict-card span, .next-grid span { color: var(--accent); font-size: .82rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
  .league-card strong { display: block; font-size: .95rem; color: var(--muted); line-height: 1.4; margin-top: 8px; }
  .league-card.active { border-color: var(--accent); }
  .league-card:hover, .team-pill:hover, .verdict-card:hover, .browse-grid a:hover { transform: translateY(-2px); border-color: var(--accent); background: rgba(57,167,255,.06); }

  .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
  .section-header a { color: var(--accent); text-decoration: none; font-weight: 700; }
  .rollout-panel, .method-panel { display: grid; grid-template-columns: 1.35fr 1fr; gap: 26px; padding: 26px; margin-bottom: 34px; }
  .rollout-panel h2, .method-panel h2, .section-header h2 { margin: 0; letter-spacing: -.03em; }
  .rollout-panel p, .method-panel p, .next-grid p, .verdict-card p { color: var(--muted); line-height: 1.6; }

  .progress-card { align-self: center; }
  .progress-top { display: flex; justify-content: space-between; margin-bottom: 12px; color: #f5f7fb; }
  .progress-top strong { font-size: 1.35rem; }
  .progress-top span, .progress-card small { color: #9fc7ff; font-weight: 800; }
  .progress-bar { width: 100%; height: 12px; border-radius: 99px; background: rgba(255,255,255,.08); overflow: hidden; margin-bottom: 12px; }
  .progress-bar span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--accent), #7cc7ff); }

  .recent-teams, .featured, .verdicts-section, .browse-section, .coming-next { margin-bottom: 42px; }
  .team-strip { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
  .verdict-grid, .next-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .team-pill span, .verdict-card h3, .next-grid strong { display: block; color: #f5f7fb; margin-bottom: 8px; }
  .verdict-card h3 { margin-top: 10px; letter-spacing: -.02em; }

  .browse-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }
  .browse-grid a { padding: 16px 14px; color: #f5f7fb; text-decoration: none; text-align: center; font-weight: 800; transition: transform .15s ease, border-color .15s ease, background .15s ease; }
  .next-grid div { padding: 20px; }

  @media (max-width: 1000px) {
    .team-strip, .browse-grid { grid-template-columns: repeat(2, 1fr); }
    .verdict-grid, .next-grid, .rollout-panel, .method-panel { grid-template-columns: 1fr; }
  }

  @media (max-width: 800px) {
    .hero { text-align: left; padding: 38px 0 30px; margin-bottom: 28px; border-radius: 0 0 22px 22px; }
    .hero::before { background-position: center top; background-size: 1180px auto; opacity: .12; }
    .hero h1 { font-size: clamp(2.45rem, 12vw, 3.4rem); }
    .search { max-width: none; }
    .hero-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 24px; }
    .stat-card { padding: 15px 12px; }
    .stat-card strong { font-size: 1.38rem; }
    .league-grid, .team-strip, .browse-grid { grid-template-columns: 1fr; }
    .section-header { align-items: flex-start; gap: 10px; flex-direction: column; }
  }
</style>