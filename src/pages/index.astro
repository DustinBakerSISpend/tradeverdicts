    max-width: 1240px;
    padding: 28px 20px 54px;
  }

  .home-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 18px;
    background:
      radial-gradient(circle at top left, rgba(78, 161, 255, 0.08), transparent 30%),
      var(--panel-2);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.28);
  }

  .sport-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    background: rgba(8, 12, 18, 0.45);
  }

  .sport-pill {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 7px 13px;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 800;
    text-decoration: none;
  }

  .sport-pill.active {
    border-color: var(--accent);
    background: rgba(78, 161, 255, 0.18);
    color: white;
  }

  .sport-pill.disabled {
    opacity: 0.55;
  }

  .sport-note {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .hero-panel {
    padding: 36px 28px 30px;
    border-bottom: 1px solid var(--border);
  }

  .hero-eyebrow {
    margin-bottom: 10px;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-panel h1 {
    max-width: 820px;
    margin-bottom: 10px;
    font-size: clamp(2.2rem, 5vw, 4.25rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .hero-copy {
    max-width: 760px;
    margin-bottom: 22px;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 720px;
    height: 48px;
    padding: 0 15px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: rgba(11, 15, 20, 0.86);
  }

  .search-bar span {
    color: var(--accent);
    font-size: 1.35rem;
    line-height: 1;
  }

  .search-bar input {
    flex: 1 1 auto;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    color: white;
    font-size: 0.95rem;
  }

  .search-bar input::placeholder {
    color: rgba(154, 167, 184, 0.8);
  }
  .search-submit {
    flex: 0 0 auto;
    min-height: 34px;
    border: 1px solid var(--accent);
    border-radius: 9px;
    padding: 6px 12px;
    background: rgba(78, 161, 255, 0.16);
    color: white;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 900;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .search-submit:hover {
    background: rgba(78, 161, 255, 0.26);
    transform: translateY(-1px);
  }

  .search-submit:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 14px;
  }

  .team-history-button,
  .on-this-day-button,
  .browse-by-year-button,
  .random-trade-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border: 1px solid var(--accent);
    border-radius: 12px;
    padding: 10px 16px;
    background: rgba(78, 161, 255, 0.14);
    color: white;
    font-size: 0.9rem;
    font-weight: 900;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .team-history-button:hover,
  .on-this-day-button:hover,
  .browse-by-year-button:hover,
  .random-trade-button:hover {
    background: rgba(78, 161, 255, 0.24);
    transform: translateY(-1px);
  }

  .stat-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: 1px solid var(--border);
    background: rgba(8, 12, 18, 0.38);
  }

  .stat-cell {
    padding: 15px 18px;
    border-right: 1px solid var(--border);
  }

  .stat-cell:last-child {
    border-right: none;
  }

  .stat-cell-wide {
    grid-column: 1 / -1;
    display: flex;
    align-items: baseline;
    gap: 8px;
    border-right: none;
  }

  .stat-cell-wide strong {
    margin-bottom: 0;
    font-size: 1rem;
    letter-spacing: -0.015em;
  }

  .stat-cell-wide span {
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
  }

  .stat-cell strong {
    display: block;
    margin-bottom: 4px;
    color: white;
    font-size: 1.45rem;
    letter-spacing: -0.04em;
  }

  .stat-cell .stat-highlight {
    color: var(--good);
  }

  .stat-cell span {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
  }

  .main-col {
    padding: 22px;
    border-right: 1px solid var(--border);
  }

  .side-col {
    padding: 22px;
  }

  .section-block {
    margin-bottom: 30px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
    margin-bottom: 14px;
  }

  .section-header h2,
  .side-section h2 {
    font-size: 0.83rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-header a {
    color: var(--accent);
    font-size: 0.86rem;
    font-weight: 800;
    text-decoration: none;
  }

  .featured-card,
  .recent-card,
  .angle-card,
  .player-list a,
  .player-list .player-row,
  .method-strip {
    border: 1px solid var(--border);
    background: rgba(20, 26, 34, 0.72);
  }

  .featured-card {
    display: block;
    padding: 18px;
    border-radius: 16px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }

  .featured-card:hover,
  .recent-card:hover,
  .angle-card:hover,
  .player-list a:hover {
    border-color: var(--accent);
    background: rgba(78, 161, 255, 0.07);
    transform: translateY(-2px);
  }

  .featured-topline {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 14px;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .featured-topline span {
    color: var(--accent);
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-teams {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .team-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 7px 10px;
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 900;
  }

  .team-chip.winner {
    border-color: rgba(51, 209, 122, 0.42);
    background: rgba(51, 209, 122, 0.1);
    color: #d9ffe9;
  }

  .team-chip.loser {
    border-color: rgba(255, 107, 107, 0.35);
    background: rgba(255, 107, 107, 0.08);
    color: #ffdada;
  }

  .featured-card h2 {
    margin-bottom: 9px;
    font-size: clamp(1.55rem, 3vw, 2.1rem);
    letter-spacing: -0.04em;
  }

  .featured-card p {
    max-width: 760px;
    margin-bottom: 18px;
    color: var(--muted);
    line-height: 1.62;
  }

  .grade-row {
    display: flex;
    align-items: end;
    gap: 14px;
    flex-wrap: wrap;
  }

  .grade-block {
    min-width: 78px;
  }

  .grade-block strong {
    display: block;
    font-size: 1.65rem;
    line-height: 1;
  }

  .grade-block span {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .grade-a {
    color: var(--good);
  }

  .grade-b {
    color: var(--accent);
  }

