---
import BaseLayout from "../layouts/BaseLayout.astro";
import trades from "../data/nfl/trades.json";
import players from "../data/nfl/players.json";
import tradeOverrides from "../data/nfl/trade-overrides.json";
import {
  getIndexEligibleTrades,
  getPublicTrades,
} from "../utils/publicRecords.js";
import {
  createPlayerEligibilityContext,
  getIndexEligiblePlayers,
} from "../utils/playerEligibility.js";

const publicTrades = getPublicTrades(trades);
const activeTrades = getIndexEligibleTrades(publicTrades);
const publicTradeCount = publicTrades.length;
const trackedPlayerCount = players.length;
const playerEligibilityContext = createPlayerEligibilityContext(
  players,
  publicTrades
);
const eligiblePlayers = getIndexEligiblePlayers(
  players,
  publicTrades,
  playerEligibilityContext
);
const eligiblePlayerSlugSet = new Set(
  eligiblePlayers.map((player) => player.slug)
);
const playerByNormalizedName = new Map(
  players
    .filter((player) => player?.name && player?.slug)
    .map((player) => [String(player.name).trim().toLowerCase(), player])
);

const getHomepagePlayerHref = (name, preferredSlug = "") => {
  const directSlug = String(preferredSlug || "").trim();
  if (directSlug && eligiblePlayerSlugSet.has(directSlug)) {
    return `/players/${directSlug}/`;
  }

  const matched = playerByNormalizedName.get(String(name || "").trim().toLowerCase());
  if (matched?.slug && eligiblePlayerSlugSet.has(matched.slug)) {
    return `/players/${matched.slug}/`;
  }

  return `/search/?q=${encodeURIComponent(String(name || "").trim())}`;
};

const formatTeamName = (slug = "") =>
  String(slug)
    .split("-")
    .filter(Boolean)
    .map((word) =>
      word === "49ers" ? "49ers" : word.charAt(0).toUpperCase() + word.slice(1)
    )
    .join(" ");

const formatDate = (date = "") => {
  if (!date) return "";
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return date;

  return parsed.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
};

const getTrade = (slug) => activeTrades.find((trade) => trade.slug === slug);

const currentNflTeamSlugs = [
  "arizona-cardinals",
  "atlanta-falcons",
  "baltimore-ravens",
  "buffalo-bills",
  "carolina-panthers",
  "chicago-bears",
  "cincinnati-bengals",
  "cleveland-browns",
  "dallas-cowboys",
  "denver-broncos",
  "detroit-lions",
  "green-bay-packers",
  "houston-texans",
  "indianapolis-colts",
  "jacksonville-jaguars",
  "kansas-city-chiefs",
  "las-vegas-raiders",
  "los-angeles-chargers",
  "los-angeles-rams",
  "miami-dolphins",
  "minnesota-vikings",
  "new-england-patriots",
  "new-orleans-saints",
  "new-york-giants",
  "new-york-jets",
  "philadelphia-eagles",
  "pittsburgh-steelers",
  "san-francisco-49ers",
  "seattle-seahawks",
  "tampa-bay-buccaneers",
  "tennessee-titans",
  "washington-commanders",
];
const currentNflTeamSlugSet = new Set(currentNflTeamSlugs);
const representedCurrentTeamSlugs = new Set(
  activeTrades
    .flatMap((trade) => trade.teams || [])
    .filter((team) => currentNflTeamSlugSet.has(team))
);
const nflTeamsTotal = currentNflTeamSlugs.length;
const coveragePercent = Math.round(
  (representedCurrentTeamSlugs.size / nflTeamsTotal) * 100
);
const randomTradeHref = activeTrades.length
  ? `/trades/${activeTrades[Math.floor(Math.random() * activeTrades.length)].slug}/`
  : "/trades/";

const getKeyNames = (trade) =>
  Array.from(
    new Set(
      Object.values(trade?.assetsReceived || {})
        .flat()
        .filter((asset) => asset?.type === "player")
        .map((asset) => String(asset?.asset || "").trim())
        .filter(Boolean)
    )
  );

const getGradeClass = (grade = "") => {
  const letter = String(grade).trim().charAt(0).toUpperCase();

  if (letter === "A") return "grade-a";
  if (letter === "B") return "grade-b";
  if (letter === "C") return "grade-c";
  if (letter === "D") return "grade-d";
  if (letter === "F") return "grade-f";

  return "grade-neutral";
};

const trimSummary = (summary = "", limit = 190) => {
  const clean = String(summary || "").replace(/\s+/g, " ").trim();

  if (clean.length <= limit) return clean;

  return `${clean.slice(0, limit).replace(/\s+\S*$/, "")}…`;
};

const getWinnerSlug = (trade) => {
  const verdict = String(trade?.verdict || "").toLowerCase();

  return (trade?.teams || []).find((team) =>
    verdict.includes(formatTeamName(team).toLowerCase())
  );
};

const getVerdictLabel = (trade) => trade?.verdict || "Verdict pending";

const getVisibleGrades = (trade) => {
  const grades = trade?.grades || {};
  const teams = trade?.teams || [];

  return teams
    .map((team) => ({
      team,
      teamName: formatTeamName(team),
      grade: grades[team],
    }))
    .filter((item) => item.grade)
    .slice(0, 2);
};

const tradeOverrideBySlug = new Map(
  tradeOverrides.map((item) => [item.slug, item])
);

const featuredTrade = getTrade("herschel-walker-dallas-cowboys-1989");

const recentVerdicts = [...activeTrades]
  .filter((trade) => trade.slug !== featuredTrade?.slug)
  .sort(
    (a, b) =>
      new Date(`${b.tradeDate || "1900-01-01"}T00:00:00`).getTime() -
      new Date(`${a.tradeDate || "1900-01-01"}T00:00:00`).getTime()
  )
  .slice(0, 6)
  .map((trade) => ({
    trade,
    label:
      tradeOverrideBySlug.get(trade.slug)?.headline ||
      `${formatTeamName(trade.teams?.[0] || "NFL")} trade verdict`,
    eyebrow: `NFL · ${String(trade.tradeDate || trade.season || "").slice(0, 4)}`,
    verdict: getVerdictLabel(trade),
    keyPlayers: getKeyNames(trade).map((name) => ({
      name,
      href: getHomepagePlayerHref(name),
    })),
  }));

const mostTradedPlayers = [
  { name: "Brandin Cooks", slug: "brandin-cooks", count: 4 },
  { name: "Eric Dickerson", slug: "eric-dickerson", count: 4 },
  { name: "Randy Moss", slug: "randy-moss", count: 3 },
  { name: "Brandon Marshall", slug: "brandon-marshall", count: 3 },
  { name: "Marshawn Lynch", slug: "marshawn-lynch", count: 2 },
  { name: "Ted Hendricks", slug: "ted-hendricks", count: 2 },
  { name: "Fran Tarkenton", slug: "fran-tarkenton", count: 2 },
  { name: "Percy Harvin", slug: "percy-harvin", count: 2 },
].map((player) => ({
  ...player,
  href: getHomepagePlayerHref(player.name, player.slug),
}));

const angleLinks = [
  {
    title: "Lopsided wins",
    subtitle: "Clear grade separation",
    href: "/trades/lopsided/",
  },
  {
    title: "Blockbusters",
    subtitle: "Franchise-changing deals",
    href: "/trades/blockbusters/",
  },
  {
    title: "Disasters",
    subtitle: "The costliest outcomes",
    href: "/trades/disasters/",
  },
];

const statCards = [
  {
    value: publicTradeCount.toLocaleString(),
    label: "NFL trades live",
  },
  {
    value: trackedPlayerCount.toLocaleString(),
    label: "Players tracked",
  },
  {
    value: `${representedCurrentTeamSlugs.size} / ${nflTeamsTotal}`,
    label: "Current teams covered",
  },
  {
    value: `${coveragePercent}%`,
    label: "NFL coverage complete",
    highlight: true,
  },
];


---

<BaseLayout
  title="NFL Trade History, Grades & Verdicts | TradeVerdicts"
  description="Explore NFL trade history with team grades, player and draft-pick outcomes, and verdicts on who actually won each deal."
>
  <main class="home-shell">
    <section class="home-card">
      <!-- nfl-nba-league-switch-v1 -->
      <div class="league-switch" aria-label="League selector">
        <a
          class="league-switch-link active"
          href="/"
          aria-current="page"
        >NFL</a>
        <a
          class="league-switch-link"
          href="/nba/"

        >NBA</a>
      </div>
      <!-- /nfl-nba-league-switch-v1 -->
      <section class="hero-panel">
        <p class="hero-eyebrow">Every NFL trade. Every verdict. Searchable.</p>
        <h1>The NFL trade database with a verdict on every deal.</h1>
        <p class="hero-copy">
          The who, what, when, and where of {publicTradeCount.toLocaleString()} NFL trades,
          graded by player value, draft return, timing, and long-term outcome.
        </p>

        <form class="search-bar" id="siteSearchForm" action="/search/" method="get">
          <span aria-hidden="true">⌕</span>
          <input
            id="siteSearch"
            name="q"
            type="text"
            placeholder="Search players, teams, or trades — e.g. Herschel Walker, Browns 2004..."
            autocomplete="off"
          />
          <button class="search-submit" type="submit">Search</button>
        </form>

        <div class="hero-actions">
          <a class="team-history-button" href="/team-to-team-trade-history/">
            Team-to-Team Trade History
          </a>
          <a class="on-this-day-button" href="/on-this-day/">
            On This Day
          </a>
          <a class="browse-by-year-button" href="/browse-by-year/">
            Browse by Year
          </a>
          <a class="random-trade-button" href={randomTradeHref}>
            Random Trade
          </a>
        </div>
      </section>

      <section class="stat-strip" aria-label="TradeVerdicts database stats">
        {statCards.map((stat) => (
          <div class="stat-cell">
            <strong class={stat.highlight ? "stat-highlight" : ""}>{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        ))}
      </section>

      <section class="content-grid">
        <div class="main-col">
          {featuredTrade && (
            <section class="section-block">
              <div class="section-header">
                <h2>Featured verdict</h2>
                <a href="/trades/">All trades →</a>
              </div>

              <a class="featured-card" href={`/trades/${featuredTrade.slug}/`}>
                <div class="featured-topline">
                  <span>Blockbuster · 1989</span>
                  <time datetime={featuredTrade.tradeDate}>{formatDate(featuredTrade.tradeDate)}</time>
                </div>

                <div class="featured-teams">
                  {(featuredTrade.teams || []).map((team) => {
                    const grade = featuredTrade.grades?.[team] || "";
                    const isWinner = team === getWinnerSlug(featuredTrade);

                    return (
                      <span class={isWinner ? "team-chip winner" : "team-chip loser"}>
                        {formatTeamName(team)}
                        {grade && <b>{grade}</b>}
                      </span>
                    );
                  })}
                </div>

                <h2>Herschel Walker to the Minnesota Vikings</h2>
                <p class="featured-summary">{trimSummary(featuredTrade.summary, 320)}</p>

                <div class="featured-home-summary">
                  <span>Why it matters</span>
                  <p>{tradeOverrideBySlug.get(featuredTrade.slug)?.dek || trimSummary(featuredTrade.analysis, 220)}</p>
                </div>

                <div class="grade-row">
                  {(featuredTrade.teams || []).map((team) => {
                    const grade = featuredTrade.grades?.[team] || "—";

                    return (
                      <div class="grade-block">
                        <strong class={getGradeClass(grade)}>{grade}</strong>
                        <span>{formatTeamName(team)}</span>
                      </div>
                    );
                  })}
                  <div class="verdict-pill">{getVerdictLabel(featuredTrade)}</div>
                </div>

                <div class="featured-read-more">
                  Read the full trade analysis <span aria-hidden="true">→</span>
                </div>
              </a>
            </section>
          )}

          <section class="section-block">
            <div class="section-header">
              <h2>Recent verdicts</h2>
              <a href="/trades/">View all →</a>
            </div>

            <div class="recent-grid">
              {recentVerdicts.map((item) => {
                const visibleGrades = getVisibleGrades(item.trade);

                return (
                  <article class="recent-card">
                    <div class="recent-topline">
                      <span>{item.eyebrow}</span>
                      <b>{item.verdict}</b>
                    </div>
                    <h3>
                      <a class="trade-title-link" href={`/trades/${item.trade.slug}/`}>
                        {item.label}
                      </a>
                    </h3>
                    <p>{trimSummary(item.trade.summary, 155)}</p>
                    {item.keyPlayers.length > 0 && (
                      <div class="recent-players">
                        <span>Key names</span>
                        <div class="recent-player-links">
                          {item.keyPlayers.slice(0, 3).map((player) => (
                            <a href={player.href}>{player.name}</a>
                          ))}
                        </div>
                      </div>
                    )}
                    <div class="recent-meta">
                      <time datetime={item.trade.tradeDate}>{formatDate(item.trade.tradeDate)}</time>
                      <div class="recent-card-actions">
                        <div class="mini-grades">
                          {visibleGrades.map((grade) => (
                            <b class={getGradeClass(grade.grade)} title={grade.teamName}>
                              {grade.grade}
                            </b>
                          ))}
                        </div>
                        <a class="recent-open-link" href={`/trades/${item.trade.slug}/`}>Trade →</a>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>

          <section class="method-strip">
            <div>
              <p>How verdicts work</p>
              <h2>Every trade is graded with hindsight.</h2>
            </div>
            <p>
              TradeVerdicts weighs player value, draft return, roster impact,
              timing, championships, and long-term outcome. The goal is simple:
              show who actually won after the dust settled.
            </p>
          </section>
        </div>

        <aside class="side-col">
          <section class="side-section">
            <h2>Browse by angle</h2>
            <p class="side-note">
              Curated views of the clearest wins, biggest swings, and costliest outcomes.
            </p>
            <div class="angle-grid">
              {angleLinks.map((angle) => (
                <a class="angle-card" href={angle.href}>
                  <strong>{angle.title}</strong>
                  <span>{angle.subtitle}</span>
                </a>
              ))}
            </div>

          </section>

          <section class="side-section">
            <h2>Most-traded NFL players</h2>
            <p class="side-note">
              The most frequently traded players in NFL history, ranked by career trades.
            </p>
            <div class="player-list">
              {mostTradedPlayers.map((player) => (
                player.href ? (
                  <a href={player.href}>
                    <span>
                      <b>{player.name}</b>
                      <small>{player.count} career trades</small>
                    </span>
                    <em>→</em>
                  </a>
                ) : (
                  <div class="player-row">
                    <span>
                      <b>{player.name}</b>
                      <small>{player.count} career trades</small>
                    </span>
                  </div>
                )
              ))}
            </div>
          </section>

          <section class="side-section">
            <h2>Database build progress</h2>
            <div class="progress-list">
              <div class="progress-item">
                <div><span>NFL</span><b>{coveragePercent}%</b></div>
                <i><span style={`width: ${coveragePercent}%`}></span></i>
              </div>
            </div>
          </section>

        </aside>
      </section>

      <footer class="home-footer">
        <span>{publicTradeCount.toLocaleString()} public NFL trades · {trades.length.toLocaleString()} records in the database · Free to browse</span>
        <a href="/trades/">Start exploring →</a>
      </footer>
    </section>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById("siteSearchForm");
  const input = document.getElementById("siteSearch");

  form?.addEventListener("submit", (event) => {
    const query = String(input?.value || "").trim();

    if (query.length < 2) {
      event.preventDefault();
      return;
    }
  });
</script>

<style>
  .home-shell {
    max-width: 1240px;
    padding: 28px 20px 54px;
  }

  .home-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 18px;
    background:
      radial-gradient(circle at top left, rgba(78, 161, 255, 0.08), transparent 30%),
      var(--panel-2);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.28);
  }

  .sport-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    background: rgba(8, 12, 18, 0.45);
  }

  .sport-pill {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 7px 13px;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 800;
    text-decoration: none;
  }

  .sport-pill.active {
    border-color: var(--accent);
    background: rgba(78, 161, 255, 0.18);
    color: white;
  }

  .sport-pill.disabled {
    opacity: 0.55;
  }

  .sport-note {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .hero-panel {
    padding: 36px 28px 30px;
    border-bottom: 1px solid var(--border);
  }

  .hero-eyebrow {
    margin-bottom: 10px;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-panel h1 {
    max-width: 820px;
    margin-bottom: 10px;
    font-size: clamp(2.2rem, 5vw, 4.25rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .hero-copy {
    max-width: 760px;
    margin-bottom: 22px;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 720px;
    height: 48px;
    padding: 0 15px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: rgba(11, 15, 20, 0.86);
  }

  .search-bar span {
    color: var(--accent);
    font-size: 1.35rem;
    line-height: 1;
  }

  .search-bar input {
    flex: 1 1 auto;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    color: white;
    font-size: 0.95rem;
  }

  .search-bar input::placeholder {
    color: rgba(154, 167, 184, 0.8);
  }
  .search-submit {
    flex: 0 0 auto;
    min-height: 34px;
    border: 1px solid var(--accent);
    border-radius: 9px;
    padding: 6px 12px;
    background: rgba(78, 161, 255, 0.16);
    color: white;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 900;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .search-submit:hover {
    background: rgba(78, 161, 255, 0.26);
    transform: translateY(-1px);
  }

  .search-submit:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 14px;
  }

  .team-history-button,
  .on-this-day-button,
  .browse-by-year-button,
  .random-trade-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border: 1px solid var(--accent);
    border-radius: 12px;
    padding: 10px 16px;
    background: rgba(78, 161, 255, 0.14);
    color: white;
    font-size: 0.9rem;
    font-weight: 900;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .team-history-button:hover,
  .on-this-day-button:hover,
  .browse-by-year-button:hover,
  .random-trade-button:hover {
    background: rgba(78, 161, 255, 0.24);
    transform: translateY(-1px);
  }

  .stat-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: 1px solid var(--border);
    background: rgba(8, 12, 18, 0.38);
  }

  .stat-cell {
    padding: 15px 18px;
    border-right: 1px solid var(--border);
  }

  .stat-cell:last-child {
    border-right: none;
  }

  .stat-cell strong {
    display: block;
    margin-bottom: 4px;
    color: white;
    font-size: 1.45rem;
    letter-spacing: -0.04em;
  }

  .stat-cell .stat-highlight {
    color: var(--good);
  }

  .stat-cell span {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
  }

  .main-col {
    padding: 22px;
    border-right: 1px solid var(--border);
  }

  .side-col {
    padding: 22px;
  }

  .section-block {
    margin-bottom: 30px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
    margin-bottom: 14px;
  }

  .section-header h2,
  .side-section h2 {
    font-size: 0.83rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-header a {
    color: var(--accent);
    font-size: 0.86rem;
    font-weight: 800;
    text-decoration: none;
  }

  .featured-card,
  .recent-card,
  .angle-card,
  .player-list a,
  .method-strip {
    border: 1px solid var(--border);
    background: rgba(20, 26, 34, 0.72);
  }

  .featured-card {
    display: block;
    padding: 18px;
    border-radius: 16px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }

  .featured-card:hover,
  .recent-card:hover,
  .angle-card:hover,
  .player-list a:hover {
    border-color: var(--accent);
    background: rgba(78, 161, 255, 0.07);
    transform: translateY(-2px);
  }

  .featured-topline {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 14px;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .featured-topline span {
    color: var(--accent);
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-teams {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .team-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 7px 10px;
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 900;
  }

  .team-chip.winner {
