---
import BaseLayout from "../layouts/BaseLayout.astro";
import trades from "../data/nfl/trades.json";
import players from "../data/nfl/players.json";
import tradeOverrides from "../data/nfl/trade-overrides.json";
import {
  getIndexEligibleTrades,
  getPublicTrades,
} from "../utils/publicRecords.js";
import {
  createPlayerEligibilityContext,
  getIndexEligiblePlayers,
} from "../utils/playerEligibility.js";

const publicTrades = getPublicTrades(trades);
const activeTrades = getIndexEligibleTrades(publicTrades);
const playerEligibilityContext = createPlayerEligibilityContext(
  players,
  publicTrades
);
const eligiblePlayers = getIndexEligiblePlayers(
  players,
  publicTrades,
  playerEligibilityContext
);
const eligiblePlayerSlugSet = new Set(
  eligiblePlayers.map((player) => player.slug)
);

const formatTeamName = (slug = "") =>
  String(slug)
    .split("-")
    .filter(Boolean)
    .map((word) =>
      word === "49ers" ? "49ers" : word.charAt(0).toUpperCase() + word.slice(1)
    )
    .join(" ");

const formatDate = (date = "") => {
  if (!date) return "";
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return date;

  return parsed.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
};

const getTrade = (slug) => activeTrades.find((trade) => trade.slug === slug);

const getGradeClass = (grade = "") => {
  const letter = String(grade).trim().charAt(0).toUpperCase();

  if (letter === "A") return "grade-a";
  if (letter === "B") return "grade-b";
  if (letter === "C") return "grade-c";
  if (letter === "D") return "grade-d";
  if (letter === "F") return "grade-f";

  return "grade-neutral";
};

const trimSummary = (summary = "", limit = 190) => {
  const clean = String(summary || "").replace(/\s+/g, " ").trim();

  if (clean.length <= limit) return clean;

  return `${clean.slice(0, limit).replace(/\s+\S*$/, "")}…`;
};

const getWinnerSlug = (trade) => {
  const verdict = String(trade?.verdict || "").toLowerCase();

  return (trade?.teams || []).find((team) =>
    verdict.includes(formatTeamName(team).toLowerCase())
  );
};

const getVerdictLabel = (trade) => trade?.verdict || "Verdict pending";

const getVisibleGrades = (trade) => {
  const grades = trade?.grades || {};
  const teams = trade?.teams || [];

  return teams
    .map((team) => ({
      team,
      teamName: formatTeamName(team),
      grade: grades[team],
    }))
    .filter((item) => item.grade)
    .slice(0, 2);
};

const tradeOverrideBySlug = new Map(
  tradeOverrides.map((item) => [item.slug, item])
);

const featuredTrade = getTrade("herschel-walker-dallas-cowboys-1989");

const recentVerdicts = [...activeTrades]
  .filter((trade) => trade.slug !== featuredTrade?.slug)
  .sort(
    (a, b) =>
      new Date(`${b.tradeDate || "1900-01-01"}T00:00:00`).getTime() -
      new Date(`${a.tradeDate || "1900-01-01"}T00:00:00`).getTime()
  )
  .slice(0, 4)
  .map((trade) => ({
    trade,
    label:
      tradeOverrideBySlug.get(trade.slug)?.headline ||
      `${formatTeamName(trade.teams?.[0] || "NFL")} trade verdict`,
    eyebrow: `NFL · ${String(trade.tradeDate || trade.season || "").slice(0, 4)}`,
  }));

const mostTradedPlayers = [
  { name: "Brandin Cooks", slug: "brandin-cooks", count: 4 },
  { name: "Eric Dickerson", slug: "eric-dickerson", count: 4 },
  { name: "Randy Moss", slug: "randy-moss", count: 3 },
  { name: "Brandon Marshall", slug: "brandon-marshall", count: 3 },
  { name: "Marshawn Lynch", slug: "marshawn-lynch", count: 2 },
  { name: "Ted Hendricks", slug: "ted-hendricks", count: 2 },
  { name: "Fran Tarkenton", slug: "fran-tarkenton", count: 2 },
  { name: "Percy Harvin", slug: "percy-harvin", count: 2 },
].map((player) => ({
  ...player,
  href: eligiblePlayerSlugSet.has(player.slug)
    ? `/players/${player.slug}/`
    : null,
}));

const angleLinks = [
  {
    title: "Lopsided wins",
    subtitle: "Clear A/F splits",
    href: "/trades/lopsided/",
  },
  {
    title: "Blockbusters",
    subtitle: "Franchise swings",
    href: "/trades/blockbusters/",
  },
  {
    title: "Disasters",
    subtitle: "Worst decisions",
    href: "/trades/disasters/",
  },
];


---

<BaseLayout
  title="NFL Trade History, Grades & Verdicts | TradeVerdicts"
  description="Explore NFL trade history with team grades, player and draft-pick outcomes, and verdicts on who actually won each deal."
>
  <main class="home-shell">
    <section class="home-card">
      <section class="hero-panel">
        <p class="hero-eyebrow">Every trade has two sides. History gets the last word.</p>
        <h1>Who won the trade?</h1>
        <p class="hero-copy">
          TradeVerdicts tracks NFL trades across league history, follows the players and picks
          that changed hands, and grades each deal by what happened next.
        </p>

        <form class="search-bar" id="siteSearchForm" action="/search/" method="get">
          <span aria-hidden="true">⌕</span>
          <input
            id="siteSearch"
            name="q"
            type="text"
            placeholder="Search players, teams, or trades — e.g. Herschel Walker, Browns 2004..."
            autocomplete="off"
          />
          <button class="search-submit" type="submit">Search</button>
        </form>

        <div class="hero-actions">
          <a class="team-history-button" href="/team-to-team-trade-history/">
            Team-to-Team Trade History
          </a>
          <a class="on-this-day-button" href="/on-this-day/">
            On This Day
          </a>
          <a class="browse-by-year-button" href="/browse-by-year/">
            Browse by Year
          </a>
          <a class="random-trade-button" href="/random-trade/">
            Random Trade
          </a>
        </div>
      </section>

      <section class="stat-strip" aria-label="What TradeVerdicts covers">
        <div class="stat-cell stat-cell-wide">
          <strong>The who, what, when, and where of NFL trades,</strong>
          <span>graded by player value, draft return, timing, and long-term outcome.</span>
        </div>
      </section>

      <section class="content-grid">
        <div class="main-col">
          {featuredTrade && (
            <section class="section-block">
              <div class="section-header">
                <h2>Featured verdict</h2>
                <a href="/trades/">All trades →</a>
              </div>

              <a class="featured-card" href={`/trades/${featuredTrade.slug}/`}>
                <div class="featured-topline">
                  <span>Blockbuster · 1989</span>
                  <time datetime={featuredTrade.tradeDate}>{formatDate(featuredTrade.tradeDate)}</time>
                </div>

                <div class="featured-teams">
                  {(featuredTrade.teams || []).map((team) => {
                    const grade = featuredTrade.grades?.[team] || "";
                    const isWinner = team === getWinnerSlug(featuredTrade);

                    return (
                      <span class={isWinner ? "team-chip winner" : "team-chip loser"}>
                        {formatTeamName(team)}
                        {grade && <b>{grade}</b>}
                      </span>
                    );
                  })}
                </div>

                <h2>Herschel Walker to the Minnesota Vikings</h2>
                <p>{trimSummary(featuredTrade.summary, 235)}</p>

                <div class="grade-row">
                  {(featuredTrade.teams || []).map((team) => {
                    const grade = featuredTrade.grades?.[team] || "—";

                    return (
                      <div class="grade-block">
                        <strong class={getGradeClass(grade)}>{grade}</strong>
                        <span>{formatTeamName(team)}</span>
                      </div>
                    );
                  })}
                  <div class="verdict-pill">{getVerdictLabel(featuredTrade)}</div>
                </div>
              </a>
            </section>
          )}

          <section class="section-block">
            <div class="section-header">
              <h2>Recent verdicts</h2>
              <a href="/trades/">View all →</a>
            </div>

            <div class="recent-grid">
              {recentVerdicts.map((item) => {
                const visibleGrades = getVisibleGrades(item.trade);

                return (
                  <a class="recent-card" href={`/trades/${item.trade.slug}/`}>
                    <span>{item.eyebrow}</span>
                    <h3>{item.label}</h3>
                    <p>{trimSummary(item.trade.summary, 130)}</p>
                    <div class="recent-meta">
                      <time datetime={item.trade.tradeDate}>{formatDate(item.trade.tradeDate)}</time>
                      <div class="mini-grades">
                        {visibleGrades.map((grade) => (
                          <b class={getGradeClass(grade.grade)} title={grade.teamName}>
                            {grade.grade}
                          </b>
                        ))}
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>

          <section class="method-strip">
            <div>
              <p>The TradeVerdicts standard</p>
              <h2>The trade is the record. The verdict is ours.</h2>
            </div>
            <p>
              We reconstruct what changed hands, follow the players and picks,
              weigh the football value each side ultimately received, and make
              the call: win, loss, or even.
            </p>
          </section>
        </div>

        <aside class="side-col">
          <section class="side-section">
            <h2>Browse by angle</h2>
            <div class="angle-grid">
              {angleLinks.map((angle) => (
                <a class="angle-card" href={angle.href}>
                  <strong>{angle.title}</strong>
                  <span>{angle.subtitle}</span>
                </a>
              ))}
            </div>

          </section>

          <section class="side-section">
            <h2>How we grade trades</h2>
            <p class="side-note">The verdict comes from what each side actually received when the deal played out.</p>
            <div class="player-list grade-guide">
              <div class="player-row">
                <span>
                  <b>Player value</b>
                  <small>Production, role, longevity, and impact after the trade.</small>
                </span>
              </div>
              <div class="player-row">
                <span>
                  <b>Draft return</b>
                  <small>What the acquired picks became, not just where they were selected.</small>
                </span>
              </div>
              <div class="player-row">
                <span>
                  <b>Timing</b>
                  <small>Roster fit, leverage, contention window, and when the move was made.</small>
                </span>
              </div>
              <div class="player-row">
                <span>
                  <b>Long-term result</b>
                  <small>Which team ultimately received more football value from the deal.</small>
                </span>
              </div>
            </div>
          </section>

        </aside>
      </section>

      <footer class="home-footer">
        <span>NFL trade history, graded with hindsight · Free to browse · No account required</span>
        <a href="/trades/">Start exploring →</a>
      </footer>
    </section>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById("siteSearchForm");
  const input = document.getElementById("siteSearch");

  form?.addEventListener("submit", (event) => {
    const query = String(input?.value || "").trim();

    if (query.length < 2) {
      event.preventDefault();
      return;
    }
  });
</script>

<style>
