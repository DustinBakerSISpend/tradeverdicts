---
import BaseLayout from "../layouts/BaseLayout.astro";
import trades from "../data/nfl/trades.json";
import players from "../data/nfl/players.json";
import { isPublicTrade } from "../utils/publicRecords.js";

const activeTrades = trades.filter(isPublicTrade);

const formatTeamName = (slug = "") =>
  String(slug)
    .split("-")
    .filter(Boolean)
    .map((word) =>
      word === "49ers" ? "49ers" : word.charAt(0).toUpperCase() + word.slice(1)
    )
    .join(" ");

const formatDate = (date = "") => {
  if (!date) return "";
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return date;

  return parsed.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
};

const getTrade = (slug) => activeTrades.find((trade) => trade.slug === slug);

const getGradeClass = (grade = "") => {
  const letter = String(grade).trim().charAt(0).toUpperCase();

  if (letter === "A") return "grade-a";
  if (letter === "B") return "grade-b";
  if (letter === "C") return "grade-c";
  if (letter === "D") return "grade-d";
  if (letter === "F") return "grade-f";

  return "grade-neutral";
};

const trimSummary = (summary = "", limit = 190) => {
  const clean = String(summary || "").replace(/\s+/g, " ").trim();

  if (clean.length <= limit) return clean;

  return `${clean.slice(0, limit).replace(/\s+\S*$/, "")}…`;
};

const getWinnerSlug = (trade) => {
  const verdict = String(trade?.verdict || "").toLowerCase();

  return (trade?.teams || []).find((team) =>
    verdict.includes(formatTeamName(team).toLowerCase())
  );
};

const getVerdictLabel = (trade) => trade?.verdict || "Verdict pending";

const getVisibleGrades = (trade) => {
  const grades = trade?.grades || {};
  const teams = trade?.teams || [];

  return teams
    .map((team) => ({
      team,
      teamName: formatTeamName(team),
      grade: grades[team],
    }))
    .filter((item) => item.grade)
    .slice(0, 2);
};

const teamSlugs = [...new Set(activeTrades.flatMap((trade) => trade.teams || []))]
  .filter((team) => team && !String(team).includes("unknown"));

const currentNflTeamSlugs = [
  "arizona-cardinals",
  "atlanta-falcons",
  "baltimore-ravens",
  "buffalo-bills",
  "carolina-panthers",
  "chicago-bears",
  "cincinnati-bengals",
  "cleveland-browns",
  "dallas-cowboys",
  "denver-broncos",
  "detroit-lions",
  "green-bay-packers",
  "houston-texans",
  "indianapolis-colts",
  "jacksonville-jaguars",
  "kansas-city-chiefs",
  "las-vegas-raiders",
  "los-angeles-chargers",
  "los-angeles-rams",
  "miami-dolphins",
  "minnesota-vikings",
  "new-england-patriots",
  "new-orleans-saints",
  "new-york-giants",
  "new-york-jets",
  "philadelphia-eagles",
  "pittsburgh-steelers",
  "san-francisco-49ers",
  "seattle-seahawks",
  "tampa-bay-buccaneers",
  "tennessee-titans",
  "washington-commanders",
];

const importedTeams = currentNflTeamSlugs.filter((team) => teamSlugs.includes(team)).length;
const nflTeamsTotal = 32;
const coveragePercent = Math.round((importedTeams / nflTeamsTotal) * 100);

const featuredTrade = getTrade("herschel-walker-dallas-cowboys-1989");

const recentVerdicts = [
  {
    slug: "myles-garrett-cleveland-browns-2026",
    label: "Myles Garrett to the Rams",
    eyebrow: "NFL · 2026",
  },
  {
    slug: "eagles-2026-06-01-new-england-patriots-0485",
    label: "A.J. Brown to the Patriots",
    eyebrow: "NFL · 2026",
  },
  {
    slug: "2026-1st-round-pick-10th-overall-francis-mauigoa-cincinnati-bengals-2026",
    label: "Dexter Lawrence to the Bengals",
    eyebrow: "NFL · 2026",
  },
  {
    slug: "draft-pick-trade-philadelphia-eagles-2026",
    label: "Jonathan Greenard to the Eagles",
    eyebrow: "NFL · 2026",
  },
]
  .map((item) => ({
    ...item,
    trade: getTrade(item.slug),
  }))
  .filter((item) => item.trade);

const mostTradedPlayers = [
  {
    name: "Brandin Cooks",
    slug: "brandin-cooks",
    count: 4,
    note: "Four-team trade trail"
  },
  {
    name: "Eric Dickerson",
    slug: "eric-dickerson",
    count: 4,
    note: "Hall of Fame RB"
  },
  {
    name: "Randy Moss",
    slug: "randy-moss",
    count: 3,
    note: "Vikings, Raiders, Patriots"
  },
  {
    name: "Brandon Marshall",
    slug: "brandon-marshall",
    count: 3,
    note: "Six-team receiver path"
  },
  {
    name: "Marshawn Lynch",
    slug: "marshawn-lynch",
    count: 2,
    note: "Bills to Seahawks"
  },
  {
    name: "Ted Hendricks",
    slug: "ted-hendricks",
    count: 2,
    note: "Colts, Packers, Raiders"
  },
  {
    name: "Fran Tarkenton",
    slug: "fran-tarkenton",
    count: 2,
    note: "Vikings-Giants-Vikings"
  },
  {
    name: "Percy Harvin",
    slug: "percy-harvin",
    count: 2,
    note: "Explosive multi-team WR"
  }
];

const angleLinks = [
  {
    title: "Lopsided wins",
    subtitle: "Clear A/F splits",
    href: "/trades/lopsided/",
  },
  {
    title: "Blockbusters",
    subtitle: "Franchise swings",
    href: "/trades/blockbusters/",
  },
  {
    title: "Disasters",
    subtitle: "Worst decisions",
    href: "/trades/disasters/",
  },
];


const statCards = [
  {
    value: activeTrades.length.toLocaleString(),
    label: "NFL trades live",
  },
  {
    value: players.length.toLocaleString(),
    label: "Players tracked",
  },
  {
    value: `${importedTeams} / ${nflTeamsTotal}`,
    label: "Current teams covered",
  },
  {
    value: `${coveragePercent}%`,
    label: "NFL coverage complete",
    highlight: true,
  },
];
---

<BaseLayout
  title="NFL Trade Database | Trade Verdicts"
  description="Explore thousands of NFL trades with team grades, verdicts, player histories, and searchable records from across league history."
>
  <main class="home-shell">
    <section class="home-card">
      <section class="hero-panel">
        <p class="hero-eyebrow">Every NFL trade. Every verdict. Searchable.</p>
        <h1>The NFL trade database with a verdict on every deal.</h1>
        <p class="hero-copy">
          The who, what, when, and where of {activeTrades.length.toLocaleString()} NFL trades,
          graded by player value, draft return, timing, and long-term outcome.
        </p>

        <form class="search-bar" id="siteSearchForm" action="/search/" method="get">
          <span aria-hidden="true">⌕</span>
          <input
            id="siteSearch"
            name="q"
            type="text"
            placeholder="Search players, teams, or trades — e.g. Herschel Walker, Browns 2004..."
            autocomplete="off"
          />
          <button class="search-submit" type="submit">Search</button>
        </form>

        <div class="hero-actions">
          <a class="team-history-button" href="/team-to-team-trade-history/">
            Team-to-Team Trade History
          </a>
          <a class="on-this-day-button" href="/on-this-day/">
            On This Day
          </a>
          <a class="browse-by-year-button" href="/browse-by-year/">
            Browse by Year
          </a>
          <a class="random-trade-button" href="/random-trade/">
            Random Trade
          </a>
        </div>
      </section>

      <section class="stat-strip" aria-label="TradeVerdicts database stats">
        {statCards.map((stat) => (
          <div class="stat-cell">
            <strong class={stat.highlight ? "stat-highlight" : ""}>{stat.value}</strong>
            <span>{stat.label}</span>
          </div>
        ))}
      </section>

      <section class="content-grid">
        <div class="main-col">
          {featuredTrade && (
            <section class="section-block">
              <div class="section-header">
                <h2>Featured verdict</h2>
                <a href="/trades/">All trades →</a>
              </div>

              <a class="featured-card" href={`/trades/${featuredTrade.slug}/`}>
                <div class="featured-topline">
                  <span>Blockbuster · 1989</span>
                  <time datetime={featuredTrade.tradeDate}>{formatDate(featuredTrade.tradeDate)}</time>
                </div>

                <div class="featured-teams">
                  {(featuredTrade.teams || []).map((team) => {
                    const grade = featuredTrade.grades?.[team] || "";
                    const isWinner = team === getWinnerSlug(featuredTrade);

                    return (
                      <span class={isWinner ? "team-chip winner" : "team-chip loser"}>
                        {formatTeamName(team)}
                        {grade && <b>{grade}</b>}
                      </span>
                    );
                  })}
                </div>

                <h2>Herschel Walker to the Minnesota Vikings</h2>
                <p>{trimSummary(featuredTrade.summary, 235)}</p>

                <div class="grade-row">
                  {(featuredTrade.teams || []).map((team) => {
                    const grade = featuredTrade.grades?.[team] || "—";

                    return (
                      <div class="grade-block">
                        <strong class={getGradeClass(grade)}>{grade}</strong>
                        <span>{formatTeamName(team)}</span>
                      </div>
                    );
                  })}
                  <div class="verdict-pill">{getVerdictLabel(featuredTrade)}</div>
                </div>
              </a>
            </section>
          )}

          <section class="section-block">
            <div class="section-header">
              <h2>Recent verdicts</h2>
              <a href="/trades/">View all →</a>
            </div>

            <div class="recent-grid">
              {recentVerdicts.map((item) => {
                const visibleGrades = getVisibleGrades(item.trade);

                return (
                  <a class="recent-card" href={`/trades/${item.trade.slug}/`}>
                    <span>{item.eyebrow}</span>
                    <h3>{item.label}</h3>
                    <p>{trimSummary(item.trade.summary, 130)}</p>
                    <div class="recent-meta">
                      <time datetime={item.trade.tradeDate}>{formatDate(item.trade.tradeDate)}</time>
                      <div class="mini-grades">
                        {visibleGrades.map((grade) => (
                          <b class={getGradeClass(grade.grade)} title={grade.teamName}>
                            {grade.grade}
                          </b>
                        ))}
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>

          <section class="method-strip">
            <div>
              <p>How verdicts work</p>
              <h2>Every trade is graded with hindsight.</h2>
            </div>
            <p>
              TradeVerdicts weighs player value, draft return, roster impact,
              timing, championships, and long-term outcome. The goal is simple:
              show who actually won after the dust settled.
            </p>
          </section>
        </div>

        <aside class="side-col">
          <section class="side-section">
            <h2>Browse by angle</h2>
            <div class="angle-grid">
              {angleLinks.map((angle) => (
                <a class="angle-card" href={angle.href}>
                  <strong>{angle.title}</strong>
                  <span>{angle.subtitle}</span>
                </a>
              ))}
            </div>

          </section>

          <section class="side-section">
            <h2>Most-traded NFL players</h2>
            <p class="side-note">Notable multi-stop NFL trade histories with TradeVerdicts player pages.</p>
            <div class="player-list">
              {mostTradedPlayers.map((player) => (
                <a href={`/players/${player.slug}/`}>
                  <span>
                    <b>{player.name}</b>
                    <small>{player.count} trades - {player.note}</small>
                  </span>
                  <em>→</em>
                </a>
              ))}
            </div>
          </section>

          <section class="side-section">
            <h2>Database build progress</h2>
            <div class="progress-list">
              <div class="progress-item">
                <div><span>NFL</span><b>100%</b></div>
                <i><span style="width: 100%"></span></i>
              </div>

            </div>
          </section>
        </aside>
      </section>

      <footer class="home-footer">
        <span>{activeTrades.length.toLocaleString()} NFL trades graded · Free to browse · No account required</span>
        <a href="/trades/">Start exploring →</a>
      </footer>
    </section>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById("siteSearchForm");
  const input = document.getElementById("siteSearch");

  form?.addEventListener("submit", (event) => {
    const query = String(input?.value || "").trim();

    if (query.length < 2) {
      event.preventDefault();
      return;
    }
  });
</script>

<style>
  .home-shell {
    max-width: 1240px;
    padding: 28px 20px 54px;
  }

  .home-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 18px;
    background:
      radial-gradient(circle at top left, rgba(78, 161, 255, 0.08), transparent 30%),
      var(--panel-2);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.28);
  }

  .sport-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    background: rgba(8, 12, 18, 0.45);
  }

  .sport-pill {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 7px 13px;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 800;
    text-decoration: none;
  }

  .sport-pill.active {
    border-color: var(--accent);
    background: rgba(78, 161, 255, 0.18);
    color: white;
  }

  .sport-pill.disabled {
    opacity: 0.55;
  }

  .sport-note {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .hero-panel {
    padding: 36px 28px 30px;
    border-bottom: 1px solid var(--border);
  }

  .hero-eyebrow {
    margin-bottom: 10px;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-panel h1 {
    max-width: 820px;
    margin-bottom: 10px;
    font-size: clamp(2.2rem, 5vw, 4.25rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .hero-copy {
    max-width: 760px;
    margin-bottom: 22px;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 720px;
    height: 48px;
    padding: 0 15px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: rgba(11, 15, 20, 0.86);
  }

  .search-bar span {
    color: var(--accent);
    font-size: 1.35rem;
    line-height: 1;
  }

  .search-bar input {
    flex: 1 1 auto;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    color: white;
    font-size: 0.95rem;
  }

  .search-bar input::placeholder {
    color: rgba(154, 167, 184, 0.8);
  }
  .search-submit {
    flex: 0 0 auto;
    min-height: 34px;
    border: 1px solid var(--accent);
    border-radius: 9px;
    padding: 6px 12px;
    background: rgba(78, 161, 255, 0.16);
    color: white;
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 900;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .search-submit:hover {
    background: rgba(78, 161, 255, 0.26);
    transform: translateY(-1px);
  }

  .search-submit:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 14px;
  }

  .team-history-button,
  .on-this-day-button,
  .browse-by-year-button,
  .random-trade-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border: 1px solid var(--accent);
    border-radius: 12px;
    padding: 10px 16px;
    background: rgba(78, 161, 255, 0.14);
    color: white;
    font-size: 0.9rem;
    font-weight: 900;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .team-history-button:hover,
  .on-this-day-button:hover,
  .browse-by-year-button:hover,
  .random-trade-button:hover {
    background: rgba(78, 161, 255, 0.24);
    transform: translateY(-1px);
  }

  .stat-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: 1px solid var(--border);
    background: rgba(8, 12, 18, 0.38);
  }

  .stat-cell {
    padding: 15px 18px;
    border-right: 1px solid var(--border);
  }

  .stat-cell:last-child {
    border-right: none;
  }

  .stat-cell strong {
    display: block;
    margin-bottom: 4px;
    color: white;
    font-size: 1.45rem;
    letter-spacing: -0.04em;
  }

  .stat-cell .stat-highlight {
    color: var(--good);
  }

  .stat-cell span {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
  }

  .main-col {
    padding: 22px;
    border-right: 1px solid var(--border);
  }

  .side-col {
    padding: 22px;
  }

  .section-block {
    margin-bottom: 30px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
    margin-bottom: 14px;
  }

  .section-header h2,
  .side-section h2 {
    font-size: 0.83rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-header a {
    color: var(--accent);
    font-size: 0.86rem;
    font-weight: 800;
    text-decoration: none;
  }

  .featured-card,
  .recent-card,
  .angle-card,
  .player-list a,
  .method-strip {
    border: 1px solid var(--border);
    background: rgba(20, 26, 34, 0.72);
  }

  .featured-card {
    display: block;
    padding: 18px;
    border-radius: 16px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }

  .featured-card:hover,
  .recent-card:hover,
  .angle-card:hover,
  .player-list a:hover {
    border-color: var(--accent);
    background: rgba(78, 161, 255, 0.07);
    transform: translateY(-2px);
  }

  .featured-topline {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 14px;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .featured-topline span {
    color: var(--accent);
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-teams {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .team-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 7px 10px;
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 900;
  }

  .team-chip.winner {
    border-color: rgba(51, 209, 122, 0.42);
    background: rgba(51, 209, 122, 0.1);
    color: #d9ffe9;
  }

  .team-chip.loser {
    border-color: rgba(255, 107, 107, 0.35);
    background: rgba(255, 107, 107, 0.08);
    color: #ffdada;
  }

  .featured-card h2 {
    margin-bottom: 9px;
    font-size: clamp(1.55rem, 3vw, 2.1rem);
    letter-spacing: -0.04em;
  }

  .featured-card p {
    max-width: 760px;
    margin-bottom: 18px;
    color: var(--muted);
    line-height: 1.62;
  }

  .grade-row {
    display: flex;
    align-items: end;
    gap: 14px;
    flex-wrap: wrap;
  }

  .grade-block {
    min-width: 78px;
  }

  .grade-block strong {
    display: block;
    font-size: 1.65rem;
    line-height: 1;
  }

  .grade-block span {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .grade-a {
    color: var(--good);
  }

  .grade-b {
    color: var(--accent);
  }

  .grade-c {
    color: var(--gold);
  }

  .grade-d,
  .grade-f {
    color: var(--bad);
  }

  .grade-neutral {
    color: var(--muted);
  }

  .verdict-pill {
    margin-left: auto;
    border-radius: 999px;
    padding: 8px 12px;
    background: rgba(78, 161, 255, 0.12);
    color: white;
    font-size: 0.84rem;
    font-weight: 900;
  }

  .recent-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .recent-card {
    display: grid;
    min-height: 196px;
    padding: 15px;
    border-radius: 14px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }

  .recent-card > span {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .recent-card h3 {
    margin-top: 8px;
    font-size: 1.07rem;
    letter-spacing: -0.025em;
  }

  .recent-card p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.48;
  }

  .recent-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: auto;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .mini-grades {
    display: flex;
    gap: 8px;
    font-size: 0.92rem;
  }

  .method-strip {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 20px;
    border-radius: 16px;
    padding: 18px;
  }

