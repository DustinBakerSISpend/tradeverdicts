    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .method-strip h2 {
    letter-spacing: -0.035em;
  }

  .method-strip > p {
    color: var(--muted);
    line-height: 1.62;
  }

  .side-section {
    margin-bottom: 28px;
  }

  .side-section h2 {
    margin-bottom: 12px;
  }

  .angle-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 9px;
  }

  .angle-card {
    display: block;
    min-height: 84px;
    padding: 12px;
    border-radius: 12px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }

  .angle-card strong {
    display: block;
    margin-bottom: 5px;
    color: white;
    font-size: 0.92rem;
  }

  .angle-card span {
    color: var(--muted);
    font-size: 0.78rem;
  }



  .player-list {
    display: grid;
    gap: 7px;
  }

  .player-list a,
  .player-list .player-row {
    display: flex;
