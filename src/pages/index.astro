---
import BaseLayout from "../layouts/BaseLayout.astro";
import TradeCard from "../components/TradeCard.astro";
import trades from "../data/nfl/trades.json";
import players from "../data/nfl/players.json";

const teams = [...new Set(trades.flatMap((trade) => trade.teams || []))];

const formatTeamName = (slug) =>
  slug
    .split("-")
    .map((word) =>
      word === "49ers" ? "49ers" : word.charAt(0).toUpperCase() + word.slice(1)
    )
    .join(" ");

const totalTrades = trades.length;
const totalPlayers = players.length;
const totalTeams = teams.length;
const importedTeams = 16;

const searchItems = [
  ...players.map((player) => ({
    type: "Player",
    title: player.name,
    subtitle: `${player.tradeSlugs?.length || 0} trade record${player.tradeSlugs?.length === 1 ? "" : "s"}`,
    url: `/players/${player.slug}`,
  })),

  ...teams.map((team) => {
    const teamTrades = trades
  .filter((trade) => trade.publishStatus !== "hold-conflict")
  .filter((trade) => trade.teams?.includes(team)).length;

    return {
      type: "Team",
      title: formatTeamName(team),
      subtitle: `${teamTrades} trade record${teamTrades === 1 ? "" : "s"}`,
      url: `/teams/${team}`,
    };
  }),

  ...trades.map((trade) => ({
    type: "Trade",
    title: trade.verdict,
    subtitle: `${trade.tradeDate} • ${(trade.teams || []).map(formatTeamName).join(" ↔ ")}`,
    url: `/trades/${trade.slug}`,
  })),
];
---

<BaseLayout title="TradeVerdicts | Sports Trade Database">
  <main>
    <section class="hero">
      <div class="hero-inner">
        <div class="eyebrow">NFL • NBA • MLB • NHL</div>

        <h1>The Sports Trade Database.</h1>

        <p>The who, what, when, and where of every sports trade in history.</p>

        <form class="search" id="siteSearchForm">
          <input
            id="siteSearch"
            type="text"
            placeholder="Search players, teams, or trades..."
            autocomplete="off"
          />

          <div id="searchResults" class="search-results"></div>
        </form>

        <div class="hero-stats" aria-label="TradeVerdicts database stats">
          <div class="stat-card">
            <strong>{totalTrades.toLocaleString()}</strong>
            <span>NFL Trades</span>
          </div>

          <div class="stat-card">
            <strong>{totalPlayers.toLocaleString()}</strong>
            <span>Players</span>
          </div>

          <div class="stat-card">
            <strong>{totalTeams.toLocaleString()}</strong>
            <span>Teams</span>
          </div>

          <div class="stat-card">
            <strong>{importedTeams}</strong>
            <span>Teams Imported</span>
          </div>
        </div>
      </div>
    </section>

    <section class="league-grid">
      <a class="league-card active" href="/teams">
        <span>Teams</span>
        <strong>Browse every NFL team →</strong>
      </a>

      <a class="league-card" href="/players">
        <span>Players</span>
        <strong>Search player trade history →</strong>
      </a>

      <a class="league-card" href="/trades">
        <span>Trades</span>
        <strong>Explore all trade records →</strong>
      </a>

      <a class="league-card" href="/trades">
        <span>Verdicts</span>
        <strong>Find the biggest wins →</strong>
      </a>
    </section>

    <section class="featured">
      <div class="section-header">
        <h2>Featured Trade</h2>
        <a href="/trades">View all trades</a>
      </div>

      <TradeCard
        date="October 22, 2020"
        title="Yannick Ngakoue to Baltimore Ravens"
        summary="Minnesota acquired draft capital while Baltimore added a pass-rush specialist for a playoff push."
        verdict="Verdict: Ravens Win"
        gradeA="BAL: A"
        gradeB="MIN: D"
      />
    </section>
  </main>
</BaseLayout>

<script define:vars={{ searchItems }}>
  const input = document.getElementById("siteSearch");
  const results = document.getElementById("searchResults");
  const form = document.getElementById("siteSearchForm");

  function normalize(value) {
    return String(value || "").toLowerCase().trim();
  }

  function getMatches(query) {
    return searchItems.filter((item) =>
      normalize(`${item.title} ${item.subtitle} ${item.type}`).includes(query)
    );
  }

  input.addEventListener("input", () => {
    const query = normalize(input.value);

    if (query.length < 2) {
      results.innerHTML = "";
      results.classList.remove("active");
      return;
    }

    const matches = getMatches(query).slice(0, 8);

    if (!matches.length) {
      results.innerHTML = `<div class="search-empty">No results found.</div>`;
      results.classList.add("active");
      return;
    }

    results.innerHTML = matches
      .map(
        (item) => `
          <a class="search-result" href="${item.url}">
            <span>${item.type}</span>
            <strong>${item.title}</strong>
            <small>${item.subtitle}</small>
          </a>
        `
      )
      .join("");

    results.classList.add("active");
  });

  form.addEventListener("submit", (event) => {
    event.preventDefault();

    const query = normalize(input.value);
    if (query.length < 2) return;

    const matches = getMatches(query);

    if (matches.length > 0) {
      window.location.href = matches[0].url;
    }
  });
</script>

<style>
  .hero {
    position: relative;
    text-align: center;
    margin-bottom: 34px;
    padding: 54px 0 36px;
    overflow: hidden;
    border-radius: 0 0 28px 28px;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: -18px 0 0;
    background-image: url("/tradeverdicts-hero-collage.png");
    background-repeat: no-repeat;
    background-position: center top;
    background-size: min(1680px, 132vw) auto;
    opacity: 0.18;
    pointer-events: none;
    z-index: 0;
  }

  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 18%, rgba(27, 64, 104, 0.18), transparent 42%),
      linear-gradient(
        180deg,
        rgba(5, 10, 16, 0.22) 0%,
        rgba(5, 10, 16, 0.58) 42%,
        rgba(5, 10, 16, 0.98) 100%
      );
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 980px;
    margin: 0 auto;
  }

  .eyebrow {
    color: var(--accent);
    font-weight: 800;
    letter-spacing: 1px;
    margin-bottom: 16px;
    font-size: 0.9rem;
  }

  .hero h1 {
    font-size: clamp(2.6rem, 5vw, 4.8rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
    margin-bottom: 15px;
    text-shadow: 0 18px 54px rgba(0, 0, 0, 0.62);
  }

  .hero p {
    color: var(--muted);
    margin-bottom: 30px;
    font-size: 1.1rem;
    text-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
  }

  .search {
    position: relative;
    max-width: 760px;
    margin: 0 auto;
  }

  .search input {
    width: 100%;
    padding: 17px;
    background: rgba(17, 25, 35, 0.9);
    border: 1px solid var(--border);
    color: white;
    border-radius: 10px;
    outline: none;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.28);
    backdrop-filter: blur(8px);
  }

  .search input:focus {
    border-color: var(--accent);
    box-shadow:
      0 0 0 3px rgba(57, 167, 255, 0.16),
      0 18px 48px rgba(0, 0, 0, 0.28);
  }

  .search-results {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    z-index: 20;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    text-align: left;
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.36);
  }

  .search-results.active {
    display: block;
  }

  .search-result {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }

  .search-result:hover {
    background: var(--panel-2);
  }

  .search-result span {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .search-result small {
    color: var(--muted);
  }

  .search-empty {
    padding: 16px;
    color: var(--muted);
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    max-width: 860px;
    margin: 30px auto 0;
  }

  .stat-card {
    border: 1px solid rgba(80, 160, 255, 0.3);
    background:
      linear-gradient(180deg, rgba(24, 37, 54, 0.9), rgba(13, 21, 31, 0.92));
    border-radius: 15px;
    padding: 17px 14px;
    text-align: center;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.24);
    backdrop-filter: blur(8px);
  }

  .stat-card strong {
    display: block;
    color: #f5f7fb;
    font-size: 1.65rem;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .stat-card span {
    display: block;
    margin-top: 8px;
    color: #9fc7ff;
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.09em;
  }

  .league-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 52px;
  }

  .league-card {
    display: block;
    background: var(--panel-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .league-card span {
    display: block;
    color: var(--accent);
    font-weight: 800;
    margin-bottom: 8px;
  }

  .league-card strong {
    display: block;
    font-size: 0.95rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .league-card.active {
    border-color: var(--accent);
  }

  .league-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    background: rgba(57, 167, 255, 0.06);
  }

  a.league-card.active:hover {
    background: rgba(57, 167, 255, 0.08);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
  }

  .section-header a {
    color: var(--accent);
    text-decoration: none;
    font-weight: 700;
  }

  @media (max-width: 800px) {
    .hero {
      text-align: left;
      padding: 38px 0 30px;
      margin-bottom: 28px;
      border-radius: 0 0 22px 22px;
    }

    .hero::before {
      background-position: center top;
      background-size: 1180px auto;
      opacity: 0.12;
    }

    .hero h1 {
      font-size: clamp(2.45rem, 12vw, 3.4rem);
    }

    .search {
      max-width: none;
    }

    .hero-stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 24px;
    }

    .stat-card {
      padding: 15px 12px;
    }

    .stat-card strong {
      font-size: 1.38rem;
    }

    .league-grid {
      grid-template-columns: 1fr;
      margin-bottom: 42px;
    }

    .section-header {
      align-items: flex-start;
      gap: 10px;
      flex-direction: column;
    }
  }
</style>