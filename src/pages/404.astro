---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | TradeVerdicts"
  description="The requested TradeVerdicts page could not be found. Browse NFL trades, players, and teams from the main archive."
  indexEligible={false}
  adEligible={false}
>
  <main class="not-found-shell">
    <section class="not-found-card">
      <p class="eyebrow">404 error</p>
      <h1>That page could not be found.</h1>
      <p>
        The URL may be outdated, mistyped, or connected to a record that moved.
        Continue with the searchable NFL trade archive instead.
      </p>
      <div class="not-found-actions">
        <a class="primary" href="/">Return home</a>
        <a href="/trades/">Browse trades</a>
        <a href="/players/">Browse players</a>
        <a href="/teams/">Browse teams</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .not-found-shell {
    min-height: 62vh;
    display: grid;
    place-items: center;
    padding: 3rem 1rem;
  }

  .not-found-card {
    width: min(720px, 100%);
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid rgba(148, 163, 184, 0.24);
    border-radius: 20px;
    background: rgba(15, 23, 42, 0.78);
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    color: #f59e0b;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 6vw, 3.6rem);
  }

  .not-found-card > p:not(.eyebrow) {
    max-width: 580px;
    margin: 1rem auto 0;
    color: #cbd5e1;
    line-height: 1.7;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .not-found-actions a {
    padding: 0.72rem 1rem;
    border: 1px solid rgba(148, 163, 184, 0.3);
    border-radius: 999px;
    color: #e2e8f0;
    text-decoration: none;
    font-weight: 700;
  }

  .not-found-actions a.primary {
    border-color: #f59e0b;
    background: #f59e0b;
    color: #111827;
  }

  .not-found-actions a:hover,
  .not-found-actions a:focus-visible {
    border-color: #fbbf24;
    transform: translateY(-1px);
  }
</style>
