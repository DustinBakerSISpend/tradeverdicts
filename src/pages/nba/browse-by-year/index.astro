---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getNbaRoutePolicy } from "../../../lib/nba/launch-controls.mjs";
import trades from "../../../data/nba/trades.json";

const clean = (value = "") => String(value ?? "").trim();
const yearCounts = new Map();

for (const trade of trades) {
  const date = clean(trade?.tradeDate || trade?.date);
  if (!/^\d{4}/u.test(date)) continue;

  const year = date.slice(0, 4);
  yearCounts.set(year, (yearCounts.get(year) ?? 0) + 1);
}

const years = [...yearCounts.entries()]
  .map(([year, count]) => ({ year, count }))
  .sort((left, right) => right.year.localeCompare(left.year));
const launchPolicy = getNbaRoutePolicy({
  path: Astro.url.pathname,
  routeType: "browse_by_year_index",
});
const publicFacing = launchPolicy.publicFacing;

---

<BaseLayout
  title="Browse NBA Trades by Year | Trade Verdicts"
  description={publicFacing ? "Browse every canonical NBA trade record by transaction year." : "Browse every canonical private NBA trade record by transaction year."}
  indexEligible={launchPolicy.indexEligible}
  adEligible={launchPolicy.adEligible}
  robots={launchPolicy.robots}
  navigationContext="nba"
>
  <main class="tool-page">
    {!publicFacing && (
      <div class="guard">
        Private local NBA preview - not authorized for publication
      </div>
    )}

    <nav class="tool-nav" aria-label="NBA trade tools">
      <a href="/nba/">NBA home</a>
      <a href="/nba/team-to-team-trade-history/">Team-to-Team</a>
      <a href="/nba/on-this-day/">On This Day</a>
      <a aria-current="page" href="/nba/browse-by-year/">Browse by Year</a>
    </nav>

    <p class="eyebrow">NBA TRADE TOOLS</p>
    <h1>Browse NBA Trades by Year</h1>
    <p class="intro">
      Browse {trades.length.toLocaleString()} canonical NBA trades across
      {years.length.toLocaleString()} represented transaction years.
    </p>

    <div class="year-grid" aria-label="Browse NBA trades by year">
      {years.map((group) => (
        <a
          href={`/nba/browse-by-year/${group.year}/`}
          aria-label={`Browse ${group.count} NBA trades from ${group.year}`}
        >
          <span>{group.year}</span>
          <strong>{group.count}</strong>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 50% -8rem, rgba(55, 82, 112, 0.18), transparent 44rem),
      linear-gradient(180deg, #0b1118 0%, #080d12 52%, #060a0e 100%);
  }

  .tool-page {
    width: min(1080px, calc(100% - 32px));
    margin: 0 auto;
    padding: 30px 0 72px;
  }

  .guard {
    border: 1px solid #d7aa3e;
    background: rgba(215, 170, 62, 0.08);
    color: #f0cd72;
    border-radius: 11px;
    padding: 10px 13px;
    font-weight: 800;
  }

  .tool-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin: 18px 0 34px;
  }

  .tool-nav a {
    border: 1px solid #6b5420;
    border-radius: 9px;
    padding: 9px 12px;
    color: #f0cd72;
    text-decoration: none;
    font-weight: 800;
    background: rgba(215, 170, 62, 0.055);
  }

  .tool-nav a:hover,
  .tool-nav a:focus-visible,
  .tool-nav a[aria-current="page"] {
    background: rgba(215, 170, 62, 0.15);
    outline: none;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: #d7aa3e;
    font-size: 0.76rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  h1 {
    margin: 0;
    max-width: 850px;
    font-size: clamp(2.3rem, 7vw, 4.8rem);
    line-height: 0.98;
  }

  .intro {
    max-width: 760px;
    color: #a9c9e8;
    line-height: 1.65;
  }

  .year-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
    gap: 8px;
    margin: 30px 0 0;
  }

  .year-grid a {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    border: 1px solid #344557;
    border-radius: 10px;
    padding: 10px 11px;
    background: rgba(21, 29, 38, 0.96);
    color: #fff;
    text-decoration: none;
  }

  .year-grid a:hover,
  .year-grid a:focus-visible {
    border-color: #d7aa3e;
    background: rgba(215, 170, 62, 0.055);
    outline: none;
  }

  .year-grid span {
    color: #f0cd72;
    font-weight: 900;
  }

  .year-grid strong {
    color: #70869a;
  }
</style>