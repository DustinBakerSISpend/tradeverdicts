---
import trades from "../../../data/nba/trades.json";
import players from "../../../data/nba/players.json";
import teams from "../../../data/nba/teams.json";
import NbaPlayerDirectoryPage from "../../../lib/nba/NbaPlayerDirectoryPage.astro";
import {
  createNbaPlayerDirectoryRows,
  getNbaPlayerDirectoryPage,
  getNbaPlayerDirectoryTotalPages,
} from "../../../lib/nba/player-directory.mjs";

const directoryRows = createNbaPlayerDirectoryRows({
  players,
  trades,
  teams,
});
const totalPages =
  getNbaPlayerDirectoryTotalPages(directoryRows);
const rows = getNbaPlayerDirectoryPage(directoryRows, 1);
---

<NbaPlayerDirectoryPage
  rows={rows}
  currentPage={1}
  totalPages={totalPages}
  totalPlayers={directoryRows.length}
/>
