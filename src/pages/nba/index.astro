    flex: 1 1 auto;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    color: white;
    font-size: 0.95rem;
  }

  .search-bar input::placeholder {
    color: rgba(154, 167, 184, 0.8);
  }
  .search-submit {
    flex: 0 0 auto;
    min-height: 34px;
    border: 1px solid var(--accent);
