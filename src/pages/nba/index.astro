    align-items: center;
    justify-content: center;
    min-height: 44px;
    border: 1px solid var(--accent);
    border-radius: 12px;
    padding: 10px 16px;
    background: rgba(78, 161, 255, 0.14);
    color: white;
    font-size: 0.9rem;
    font-weight: 900;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
  }

