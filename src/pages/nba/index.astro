---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getNbaRoutePolicy } from "../../lib/nba/launch-controls.mjs";
import trades from "../../data/nba/trades.json";
import players from "../../data/nba/players.json";
import teams from "../../data/nba/teams.json";
import {
  buildNbaHomepageModel,
  formatNbaTeamName,
} from "../../lib/nba/build-homepage-model.mjs";

const homepage = buildNbaHomepageModel({ trades, players, teams });
const activeTrades = trades;
const featuredTrade = homepage.recentVerdicts?.[0] || homepage.featuredTrade;
const recentVerdicts = [homepage.featuredTrade, ...homepage.recentVerdicts]
  .filter(Boolean)
  .filter((item, index, all) =>
    all.findIndex((candidate) => candidate.slug === item.slug) === index
  )
  .filter((item) => item.slug !== featuredTrade?.slug)
  .sort((left, right) =>
    right.tradeDate.localeCompare(left.tradeDate) ||
    left.slug.localeCompare(right.slug)
  )
  .slice(0, 6);
const mostTradedPlayers = homepage.mostTradedPlayers;
const angleLinks = homepage.angleLinks;
const importedTeams = homepage.importedTeams;
const nbaTeamsTotal = homepage.currentTeamsTotal;
const coveragePercent = homepage.coveragePercent;
const randomTradeHref = homepage.randomTrade
  ? `/nba/trades/${homepage.randomTrade.slug}/`
  : "/nba/trades/";

const formatTeamName = (slug = "") => formatNbaTeamName(slug, teams);

const formatDate = (date = "") => {
  if (!date) return "";
  const parsed = new Date(`${date}T00:00:00`);
  if (Number.isNaN(parsed.getTime())) return date;

  return parsed.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
};

const getGradeClass = (grade = "") => {
  const letter = String(grade).trim().charAt(0).toUpperCase();

  if (letter === "A") return "grade-a";
  if (letter === "B") return "grade-b";
  if (letter === "C") return "grade-c";
  if (letter === "D") return "grade-d";
  if (letter === "F") return "grade-f";

  return "grade-neutral";
};

const trimSummary = (summary = "", limit = 190) => {
  const clean = String(summary || "").replace(/\s+/g, " ").trim();

  if (clean.length <= limit) return clean;

  return `${clean.slice(0, limit).replace(/\s+\S*$/, "")}\u2026`;
};

const gradeRank = (grade = "") => {
  const normalized = String(grade).trim().toUpperCase();
  const order = [
    "F", "D-", "D", "D+", "C-", "C", "C+",
    "B-", "B", "B+", "A-", "A", "A+",
  ];
  return order.indexOf(normalized);
};

const getWinnerSlug = (trade) => {
  const ranked = trade.teams
    .map((team) => ({ team, rank: gradeRank(trade.grades?.[team]) }))
    .filter((item) => item.rank >= 0)
    .sort((left, right) => right.rank - left.rank);

  if (ranked.length >= 2 && ranked[0].rank > ranked[1].rank) {
    return ranked[0].team;
  }

  return null;
};

const getVerdictLabel = (trade) => trade?.verdict || "Verdict pending";

const getVisibleGrades = (trade) => trade.teams
  .map((team) => ({
    team,
    teamName: formatTeamName(team),
    grade: trade.grades?.[team],
  }))
  .filter((item) => item.grade)
  .slice(0, 2);

const launchPolicy = getNbaRoutePolicy({
  path: "/nba/",
  routeType: "nba_root_index",
});

---

<BaseLayout
  title="NBA Trade Database | Trade Verdicts"
  description="Explore thousands of NBA trades with team grades, verdicts, player histories, and searchable records from across league history."
  indexEligible={launchPolicy.indexEligible}
  adEligible={launchPolicy.adEligible}
  robots={launchPolicy.robots}
  navigationContext="nba"
>
  <main class="home-shell">
    <section class="home-card">
      <!-- nfl-nba-league-switch-v1 -->
      <div class="league-switch" aria-label="League selector">
        <a
          class="league-switch-link"
          href="/"

        >NFL</a>
        <a
          class="league-switch-link active"
          href="/nba/"
          aria-current="page"
        >NBA</a>
      </div>
      <!-- /nfl-nba-league-switch-v1 -->
      <section class="hero-panel">
        <p class="hero-eyebrow">Every NBA trade. Every verdict. Searchable.</p>
        <h1>The NBA trade database with a verdict on every deal.</h1>
        <p class="hero-copy">
          The who, what, when, and where of {activeTrades.length.toLocaleString()} NBA trades,
          graded by player value, draft return, timing, and long-term outcome.
        </p>

        <form class="search-bar" id="siteSearchForm" action="/nba/trades/" method="get">
          <span aria-hidden="true">⌕</span>
          <input
            id="siteSearch"
            name="q"
            type="text"
            placeholder="Search NBA players, teams, or trades, e.g. Kareem Abdul-Jabbar, Lakers, 1975..."
            autocomplete="off"
          />
          <button class="search-submit" type="submit">Search</button>
        </form>

        <div class="hero-actions">
          <a
            class="team-history-button"
            href="/nba/team-to-team-trade-history/"
          >
            Team-to-Team Trade History
          </a>
          <a class="on-this-day-button" href="/nba/on-this-day/">
            On This Day
          </a>
          <a class="browse-by-year-button" href="/nba/browse-by-year/">
            Browse by Year
          </a>
          <a class="random-trade-button" href={randomTradeHref}>
            Random Trade
          </a>
        </div>
      </section>

      <section class="stat-strip" aria-label="Explore the NBA trade database">
        <a class="stat-action" href="/nba/trades/">
          <span>
            <strong>{homepage.canonicalTradeCount.toLocaleString()}</strong>
            <small>NBA trades live</small>
          </span>
          <em>Browse trades <b aria-hidden="true">→</b></em>
        </a>
        <a class="stat-action" href="/nba/players/">
          <span>
            <strong>{homepage.canonicalPlayerCount.toLocaleString()}</strong>
            <small>Players tracked</small>
          </span>
          <em>Browse players <b aria-hidden="true">→</b></em>
        </a>
        <a class="stat-action" href="/nba/teams/">
          <span>
            <strong>{importedTeams} / {nbaTeamsTotal}</strong>
            <small>Current teams covered</small>
          </span>
          <em>Browse teams <b aria-hidden="true">→</b></em>
        </a>
      </section>

      <section class="content-grid">
        <div class="main-col">
          {featuredTrade && (
            <section class="section-block">
              <div class="section-header">
                <h2>Featured verdict</h2>
                <a href="/nba/trades/">All trades →</a>
              </div>

              <a class="featured-card" href={`/nba/trades/${featuredTrade.slug}/`}>
                <div class="featured-topline">
                  <span>Latest · {String(featuredTrade.tradeDate || "NBA").slice(0, 4)}</span>
                  <time datetime={featuredTrade.tradeDate}>{formatDate(featuredTrade.tradeDate)}</time>
                </div>

                <div class="featured-teams">
                  {(featuredTrade.teams || []).map((team) => {
                    const grade = featuredTrade.grades?.[team] || "";
                    const isWinner = team === getWinnerSlug(featuredTrade);

                    return (
                      <span class={isWinner ? "team-chip winner" : "team-chip loser"}>
                        {formatTeamName(team)}
                        {grade && <b>{grade}</b>}
                      </span>
                    );
                  })}
                </div>

                <h2>{featuredTrade.title}</h2>
                <p class="featured-summary">
                  {trimSummary(featuredTrade.summary, 320)}
                </p>

                <div class="featured-home-summary">
                  <span>Why it matters</span>
                  <p>{featuredTrade.featuredContext || trimSummary(featuredTrade.summary, 220)}</p>
                </div>

                <div class="grade-row">
                  {(featuredTrade.teams || []).map((team) => {
                    const grade = featuredTrade.grades?.[team] || "—";

                    return (
                      <div class="grade-block">
                        <strong class={getGradeClass(grade)}>{grade}</strong>
                        <span>{formatTeamName(team)}</span>
                      </div>
                    );
                  })}
                  <div class="verdict-pill">
                    {featuredTrade.featuredVerdictLabel || getVerdictLabel(featuredTrade)}
                  </div>
                </div>

                <div class="featured-read-more">
                  Read the full trade analysis <span aria-hidden="true">→</span>
                </div>
              </a>
            </section>
          )}

          <section class="section-block">
            <div class="section-header">
              <h2>Recent verdicts</h2>
              <a href="/nba/trades/">View all →</a>
            </div>

            <div class="recent-grid">
              {recentVerdicts.map((item) => {
                const visibleGrades = getVisibleGrades(item);

                return (
                  <a class="recent-card" href={`/nba/trades/${item.slug}/`}>
                    <div class="recent-topline">
                      <span>{item.eyebrow}</span>
                      <b>{item.verdict}</b>
                    </div>
                    <h3>{item.title}</h3>
                    <p>{trimSummary(item.summary, 155)}</p>
                    {item.keyPlayers.length > 0 && (
                      <p class="recent-players">
                        <span>Key names</span>
                        {item.keyPlayers.slice(0, 3).join(", ")}
                      </p>
                    )}
                    <div class="recent-meta">
                      <time datetime={item.tradeDate}>{formatDate(item.tradeDate)}</time>
                      <div class="mini-grades">
                        {visibleGrades.map((grade) => (
                          <b class={getGradeClass(grade.grade)} title={grade.teamName}>
                            {grade.grade}
                          </b>
                        ))}
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>

          <section class="method-strip">
            <div>
              <p>How verdicts work</p>
              <h2>Every trade is graded with hindsight.</h2>
            </div>
            <p>
              TradeVerdicts weighs player value, draft return, roster impact,
              timing, championships, and long-term outcome. The goal is simple:
              show who actually won after the dust settled.
            </p>
          </section>
        </div>

        <aside class="side-col">
          <section class="side-section">
            <h2>Browse by angle</h2>
            <p class="side-note">
              Curated views of the clearest wins, biggest swings, and costliest outcomes.
            </p>
            <div class="angle-grid">
              {angleLinks.map((angle) => (
                <a class="angle-card" href={angle.href}>
                  <strong>{angle.title}</strong>
                  <span>{angle.subtitle}</span>
                </a>
              ))}
            </div>

          </section>

          <section class="side-section">
            <h2>Most-traded NBA players</h2>
            <p class="side-note">
              The most frequently traded players in NBA history, ranked by career trades.
            </p>
            <div class="player-list">
              {mostTradedPlayers.map((player) => (
                <a href={`/nba/players/${player.slug}/`}>
                  <span>
                    <b>{player.name}</b>
                    <small>{player.count} career trades</small>
                  </span>
                  <em>→</em>
                </a>
              ))}
            </div>
          </section>

          <section class="side-section">
            <h2>Database build progress</h2>
            <div class="progress-list">
              <div class="progress-item">
                <div><span>NBA</span><b>{coveragePercent}%</b></div>
                <i><span style={`width: ${coveragePercent}%`}></span></i>
              </div>

            </div>
          </section>
        </aside>
      </section>

      <footer class="home-footer">
        <span>{activeTrades.length.toLocaleString()} NBA trades graded · Free to browse · No account required</span>
        <a href="/nba/trades/">Start exploring →</a>
      </footer>
    </section>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById("siteSearchForm");
  const input = document.getElementById("siteSearch");

  form?.addEventListener("submit", (event) => {
    const query = String(input?.value || "").trim();

    if (query.length < 2) {
      event.preventDefault();
      return;
    }
  });
</script>

<style>
  .home-shell {
    max-width: 1240px;
    padding: 28px 20px 54px;
  }

  .home-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 18px;
    background:
      radial-gradient(circle at top left, rgba(75, 167, 255, 0.08), transparent 30%),
      var(--panel-2);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.28);
  }

  .sport-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    background: rgba(8, 12, 18, 0.45);
  }

  .sport-pill {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 7px 13px;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 800;
    text-decoration: none;
  }

  .sport-pill.active {
    border-color: var(--accent);
    background: rgba(78, 161, 255, 0.18);
    color: white;
  }

  .sport-pill.disabled {
    opacity: 0.55;
  }

  .sport-note {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .hero-panel {
    padding: 36px 28px 30px;
    border-bottom: 1px solid var(--border);
  }

  .hero-eyebrow {
    margin-bottom: 10px;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-panel h1 {
    max-width: 820px;
    margin-bottom: 10px;
    font-size: clamp(2.2rem, 5vw, 4.25rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .hero-copy {
    max-width: 760px;
    margin-bottom: 22px;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 720px;
    height: 48px;
    padding: 0 15px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: rgba(11, 15, 20, 0.86);
  }

  .search-bar span {
    color: var(--accent);
    font-size: 1.35rem;
    line-height: 1;
  }

  .search-bar input {
    flex: 1 1 auto;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    color: white;
    font-size: 0.95rem;
  }

  .search-bar input::placeholder {
    color: rgba(154, 167, 184, 0.8);
  }
  .search-submit {
    flex: 0 0 auto;
    min-height: 34px;
    border: 1px solid var(--accent);
    border-radius: 9px;
    padding: 6px 12px;
