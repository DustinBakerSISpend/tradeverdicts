    color: #d9ffe9;
  }

  .team-chip.loser {
    border-color: rgba(255, 107, 107, 0.35);
    background: rgba(255, 107, 107, 0.08);
    color: #ffdada;
  }

  .featured-card h2 {
    margin-bottom: 9px;
    font-size: clamp(1.55rem, 3vw, 2.1rem);
    letter-spacing: -0.04em;
  }

  .featured-summary {
    max-width: 820px;
    margin-bottom: 20px;
    color: var(--muted);
    line-height: 1.68;
  }

  .featured-home-summary {
    margin: 0 0 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 13px 15px;
    background: rgba(8, 13, 18, 0.5);
  }

  .featured-home-summary span,
  .recent-players span {
    display: block;
    margin-bottom: 6px;
    color: var(--gold);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .featured-home-summary p {
    max-width: 760px;
    margin: 0;
    color: #c5d5e4;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .featured-read-more {
    margin-top: 18px;
    border-top: 1px solid var(--border);
    padding-top: 14px;
    color: var(--gold);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.02em;
  }

  .featured-read-more span {
    display: inline;
    margin-left: 4px;
    font-size: 1rem;
  }

  .grade-row {
    display: flex;
    align-items: end;
    gap: 14px;
    flex-wrap: wrap;
  }

  .grade-block {
    min-width: 78px;
  }

  .grade-block strong {
    display: block;
    font-size: 1.65rem;
    line-height: 1;
  }

  .grade-block span {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .grade-a {
    color: var(--good);
  }

  .grade-b {
    color: var(--accent);
  }

