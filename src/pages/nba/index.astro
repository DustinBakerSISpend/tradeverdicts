    font-weight: 900;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .search-submit:hover {
    background: rgba(78, 161, 255, 0.26);
    transform: translateY(-1px);
  }

  .search-submit:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 14px;
  }

  .team-history-button,
  .on-this-day-button,
  .browse-by-year-button,
  .random-trade-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border: 1px solid var(--accent);
    border-radius: 12px;
    padding: 10px 16px;
    background: rgba(78, 161, 255, 0.14);
    color: white;
    font-size: 0.9rem;
    font-weight: 900;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .team-history-button:hover,
  .on-this-day-button:hover,
  .browse-by-year-button:hover,
  .random-trade-button:hover {
    background: rgba(78, 161, 255, 0.24);
    transform: translateY(-1px);
  }

  .stat-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-bottom: 1px solid var(--border);
    background: rgba(8, 12, 18, 0.38);
  }

  .stat-cell {
    padding: 15px 18px;
    border-right: 1px solid var(--border);
  }

  .stat-cell:last-child {
    border-right: none;
  }

  .stat-cell strong {
    display: block;
    margin-bottom: 4px;
    color: white;
    font-size: 1.45rem;
    letter-spacing: -0.04em;
  }

  .stat-cell .stat-highlight {
    color: var(--good);
  }

  .stat-cell span {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
  }

  .main-col {
    padding: 22px;
    border-right: 1px solid var(--border);
  }

  .side-col {
    padding: 22px;
  }

  .section-block {
    margin-bottom: 30px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
    margin-bottom: 14px;
  }

  .section-header h2,
  .side-section h2 {
    font-size: 0.83rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-header a {
    color: var(--accent);
    font-size: 0.86rem;
    font-weight: 800;
    text-decoration: none;
  }

  .featured-card,
  .recent-card,
  .angle-card,
  .player-list a,
  .method-strip {
    border: 1px solid var(--border);
    background: rgba(20, 26, 34, 0.72);
  }

  .featured-card {
    display: block;
    padding: 18px;
    border-radius: 16px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }

  .featured-card:hover,
  .recent-card:hover,
  .angle-card:hover,
  .player-list a:hover {
    border-color: var(--accent);
    background: rgba(78, 161, 255, 0.07);
    transform: translateY(-2px);
  }

  .featured-topline {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 14px;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .featured-topline span {
    color: var(--accent);
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-teams {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .team-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 7px 10px;
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 900;
  }

  .team-chip.winner {
    border-color: rgba(51, 209, 122, 0.42);
    background: rgba(51, 209, 122, 0.1);
    color: #d9ffe9;
  }

  .team-chip.loser {
    border-color: rgba(255, 107, 107, 0.35);
    background: rgba(255, 107, 107, 0.08);
    color: #ffdada;
  }

  .featured-card h2 {
    margin-bottom: 9px;
    font-size: clamp(1.55rem, 3vw, 2.1rem);
    letter-spacing: -0.04em;
  }

  .featured-summary {
    max-width: 820px;
    margin-bottom: 20px;
    color: var(--muted);
    line-height: 1.68;
  }

  .featured-home-summary {
    margin: 0 0 18px;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 13px 15px;
    background: rgba(8, 13, 18, 0.5);
  }

  .featured-home-summary span,
  .recent-players span {
    display: block;
    margin-bottom: 6px;
    color: var(--gold);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .featured-home-summary p {
    max-width: 760px;
    margin: 0;
    color: #c5d5e4;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .featured-read-more {
    margin-top: 18px;
    border-top: 1px solid var(--border);
    padding-top: 14px;
    color: var(--gold);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.02em;
  }

  .featured-read-more span {
    display: inline;
    margin-left: 4px;
    font-size: 1rem;
  }

  .grade-row {
    display: flex;
    align-items: end;
    gap: 14px;
    flex-wrap: wrap;
  }

  .grade-block {
    min-width: 78px;
  }

  .grade-block strong {
    display: block;
    font-size: 1.65rem;
    line-height: 1;
  }

  .grade-block span {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .grade-a {
    color: var(--good);
  }

  .grade-b {
    color: var(--accent);
  }

  .grade-c {
    color: var(--gold);
  }

  .grade-d,
  .grade-f {
    color: var(--bad);
  }

  .grade-neutral {
    color: var(--muted);
  }

  .verdict-pill {
    margin-left: auto;
    border-radius: 999px;
    padding: 8px 12px;
    background: rgba(78, 161, 255, 0.12);
    color: white;
    font-size: 0.84rem;
    font-weight: 900;
  }

  .recent-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .recent-card {
    display: grid;
    min-height: 240px;
    padding: 15px;
    border-radius: 14px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }

  .recent-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }

  .recent-topline > span {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .recent-topline > b {
    max-width: 54%;
    border: 1px solid rgba(215, 170, 62, 0.4);
    border-radius: 999px;
    padding: 4px 7px;
    color: var(--gold);
    font-size: 0.68rem;
    line-height: 1.2;
    text-align: right;
  }

  .recent-card h3 {
    margin-top: 8px;
    font-size: 1.07rem;
    letter-spacing: -0.025em;
  }

  .recent-card p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.48;
  }

  .recent-card .recent-players {
