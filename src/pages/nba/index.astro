    opacity: 0.55;
  }

  .sport-note {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .hero-panel {
    padding: 36px 28px 30px;
    border-bottom: 1px solid var(--border);
  }

  .hero-eyebrow {
