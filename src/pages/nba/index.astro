    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-panel h1 {
    max-width: 820px;
    margin-bottom: 10px;
    font-size: clamp(2.2rem, 5vw, 4.25rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .hero-copy {
    max-width: 760px;
    margin-bottom: 22px;
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .search-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 720px;
    height: 48px;
    padding: 0 15px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: rgba(11, 15, 20, 0.86);
  }

  .search-bar span {
    color: var(--accent);
    font-size: 1.35rem;
    line-height: 1;
  }

