  .stat-cell {
    padding: 15px 18px;
    border-right: 1px solid var(--border);
  }

  .stat-cell:last-child {
    border-right: none;
  }

  .stat-cell strong {
    display: block;
    margin-bottom: 4px;
    color: white;
    font-size: 1.45rem;
    letter-spacing: -0.04em;
  }

  .stat-cell .stat-highlight {
    color: var(--good);
  }

  .stat-cell span {
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 330px;
  }

  .main-col {
    padding: 22px;
    border-right: 1px solid var(--border);
  }

  .side-col {
    padding: 22px;
  }

  .section-block {
    margin-bottom: 30px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
    margin-bottom: 14px;
  }

  .section-header h2,
  .side-section h2 {
    font-size: 0.83rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-header a {
    color: var(--accent);
    font-size: 0.86rem;
    font-weight: 800;
    text-decoration: none;
  }

  .featured-card,
  .recent-card,
  .angle-card,
  .player-list a,
  .method-strip {
    border: 1px solid var(--border);
    background: rgba(20, 26, 34, 0.72);
  }

  .featured-card {
    display: block;
    padding: 18px;
    border-radius: 16px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }

  .featured-card:hover,
  .recent-card:hover,
  .angle-card:hover,
  .player-list a:hover {
    border-color: var(--accent);
    background: rgba(78, 161, 255, 0.07);
    transform: translateY(-2px);
  }

  .featured-topline {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 14px;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .featured-topline span {
    color: var(--accent);
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-teams {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .team-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 7px 10px;
    color: var(--muted);
    font-size: 0.84rem;
    font-weight: 900;
  }

