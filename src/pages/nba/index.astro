  }

  .verdict-pill {
    margin-left: auto;
    border-radius: 999px;
    padding: 8px 12px;
    background: rgba(78, 161, 255, 0.12);
    color: white;
    font-size: 0.84rem;
    font-weight: 900;
  }

  .recent-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .recent-card {
    display: grid;
    min-height: 240px;
    padding: 15px;
    border-radius: 14px;
    color: inherit;
    text-decoration: none;
