    gap: 8px;
    font-size: 0.92rem;
  }

  .method-strip {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 20px;
    border-radius: 16px;
    padding: 18px;
  }

  .method-strip > div p {
    margin-bottom: 6px;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .method-strip h2 {
    letter-spacing: -0.035em;
  }

  .method-strip > p {
    color: var(--muted);
    line-height: 1.62;
  }

  .side-section {
    margin-bottom: 28px;
  }

  .side-section h2 {
    margin-bottom: 12px;
  }

  .angle-grid {
