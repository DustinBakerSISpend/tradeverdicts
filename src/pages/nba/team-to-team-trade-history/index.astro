---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import trades from "../../../data/nba/trades.json";
import teams from "../../../data/nba/teams.json";
import { formatNbaTeamName } from "../../../lib/nba/build-homepage-model.mjs";

const clean = (value = "") => String(value ?? "").trim();
const uniqueSorted = (values) =>
  [...new Set(values.filter(Boolean))].sort((left, right) =>
    left.localeCompare(right, "en"),
  );
const trimSummary = (value = "", length = 116) => {
  const text = clean(value).replace(/\s+/gu, " ");
  return text.length > length
    ? `${text.slice(0, length - 1).trimEnd()}...`
    : text;
};
const teamName = (slug) => formatNbaTeamName(slug, teams);
const pairsByKey = new Map();

for (const trade of trades) {
  const tradeTeams = uniqueSorted(
    (Array.isArray(trade?.teams) ? trade.teams : []).map(clean),
  );

  for (let left = 0; left < tradeTeams.length; left += 1) {
    for (let right = left + 1; right < tradeTeams.length; right += 1) {
      const first = tradeTeams[left];
      const second = tradeTeams[right];
      const key = `${first}::${second}`;
      const pair = pairsByKey.get(key) ?? {
        key,
        first,
        second,
        firstName: teamName(first),
        secondName: teamName(second),
        trades: [],
      };

      pair.trades.push({
        slug: clean(trade?.slug),
        date: clean(trade?.tradeDate || trade?.date),
        summary: trimSummary(trade?.summary),
      });
      pairsByKey.set(key, pair);
    }
  }
}

const pairs = [...pairsByKey.values()]
  .map((pair) => ({
    ...pair,
    trades: pair.trades
      .filter((trade) => trade.slug)
      .sort((left, right) =>
        right.date.localeCompare(left.date) ||
        left.slug.localeCompare(right.slug),
      ),
  }))
  .sort((left, right) =>
    right.trades.length - left.trades.length ||
    left.firstName.localeCompare(right.firstName, "en") ||
    left.secondName.localeCompare(right.secondName, "en"),
  );
---

<BaseLayout
  title="NBA Team-to-Team Trade History | Trade Verdicts"
  description="Browse every represented NBA team pairing and open the underlying private trade records."
  indexEligible={false}
  adEligible={false}
  robots="noindex,nofollow"
>
  <main class="tool-page">
    <div class="guard">
      Private local NBA preview - not authorized for publication
    </div>

    <nav class="tool-nav" aria-label="NBA trade tools">
      <a href="/nba/">NBA home</a>
      <a aria-current="page" href="/nba/team-to-team-trade-history/">
        Team-to-Team
      </a>
      <a href="/nba/on-this-day/">On This Day</a>
      <a href="/nba/browse-by-year/">Browse by Year</a>
    </nav>

    <p class="eyebrow">NBA TRADE TOOLS</p>
    <h1>Team-to-Team Trade History</h1>
    <p class="intro">
      Search {pairs.length.toLocaleString()} represented NBA team pairings.
      Open any pairing to browse its underlying private trade-detail pages.
    </p>

    <label class="search-label" for="pair-search">
      Filter by either team
    </label>
    <input
      id="pair-search"
      class="search-input"
      type="search"
      placeholder="Try Lakers, Celtics, Bulls..."
      autocomplete="off"
    />
    <p id="pair-count" class="result-count">
      Showing all {pairs.length.toLocaleString()} pairings
    </p>

    <section id="pair-grid" class="pair-grid">
      {pairs.map((pair) => (
        <article
          class="pair-card"
          data-pair-card
          data-search={`${pair.firstName} ${pair.secondName} ${pair.first} ${pair.second}`.toLowerCase()}
        >
          <div class="pair-heading">
            <h2>{pair.firstName} / {pair.secondName}</h2>
            <strong>{pair.trades.length} trade{pair.trades.length === 1 ? "" : "s"}</strong>
          </div>
          <details>
            <summary>Browse trade records</summary>
            <ul>
              {pair.trades.map((trade) => (
                <li>
                  <a href={`/nba/trades/${trade.slug}/`}>
                    <time datetime={trade.date}>{trade.date || "Date unavailable"}</time>
                    <span>{trade.summary || "Open private NBA trade record"}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>

<script is:inline>
  const input = document.querySelector("#pair-search");
  const count = document.querySelector("#pair-count");
  const cards = [...document.querySelectorAll("[data-pair-card]")];

  const render = () => {
    const query = String(input?.value ?? "").trim().toLowerCase();
    let visible = 0;

    for (const card of cards) {
      const matches = !query || card.dataset.search.includes(query);
      card.hidden = !matches;
      if (matches) visible += 1;
    }

    if (count) {
      count.textContent =
        `Showing ${visible.toLocaleString()} of ${cards.length.toLocaleString()} pairings`;
    }
  };

  input?.addEventListener("input", render);
</script>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 50% -8rem, rgba(108, 13, 40, 0.24), transparent 44rem),
      linear-gradient(180deg, #070103 0%, #040102 52%, #020101 100%);
  }
  .tool-page { width: min(1180px, calc(100% - 32px)); margin: 0 auto; padding: 30px 0 72px; }
  .guard { border: 1px solid #d7aa3e; background: rgba(215, 170, 62, 0.08); color: #f0cd72; border-radius: 11px; padding: 10px 13px; font-weight: 800; }
  .tool-nav { display: flex; flex-wrap: wrap; gap: 9px; margin: 18px 0 34px; }
  .tool-nav a { border: 1px solid #5a3e1b; border-radius: 9px; padding: 9px 12px; color: #f0cd72; text-decoration: none; font-weight: 800; background: rgba(215, 170, 62, 0.055); }
  .tool-nav a:hover, .tool-nav a:focus-visible, .tool-nav a[aria-current="page"] { background: rgba(215, 170, 62, 0.15); outline: none; }
  .eyebrow { margin: 0 0 8px; color: #d7aa3e; font-size: 0.76rem; font-weight: 900; letter-spacing: 0.08em; }
  h1 { margin: 0; max-width: 850px; font-size: clamp(2.3rem, 7vw, 4.8rem); line-height: 0.98; }
  .intro { max-width: 760px; color: #c4adb5; line-height: 1.65; }
  .search-label { display: block; margin: 28px 0 8px; color: #f0cd72; font-weight: 800; }
  .search-input { width: min(650px, 100%); border: 1px solid #4d202d; border-radius: 10px; padding: 13px 14px; background: #0b0205; color: #fff9ed; font: inherit; }
  .search-input:focus { border-color: #d7aa3e; outline: 2px solid rgba(215, 170, 62, 0.16); }
  .result-count { color: #9f858e; }
  .pair-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 13px; margin-top: 22px; }
  .pair-card { border: 1px solid #2b1018; border-radius: 13px; padding: 16px; background: rgba(14, 3, 7, 0.92); }
  .pair-heading { display: flex; justify-content: space-between; gap: 18px; align-items: start; }
  .pair-heading h2 { margin: 0; font-size: 1rem; }
  .pair-heading strong { flex: none; color: #f0cd72; font-size: 0.82rem; }
  details { margin-top: 13px; }
  summary { cursor: pointer; color: #d7aa3e; font-weight: 800; }
  ul { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 8px; }
  li a { display: grid; gap: 4px; border: 1px solid #2b1018; border-radius: 9px; padding: 10px; color: #f7edf0; text-decoration: none; background: #080204; }
  li a:hover, li a:focus-visible { border-color: #d7aa3e; outline: none; }
  time { color: #f0cd72; font-size: 0.78rem; font-weight: 800; }
  li span { color: #c4adb5; line-height: 1.45; }
  [hidden] { display: none !important; }
  @media (max-width: 760px) { .pair-grid { grid-template-columns: 1fr; } }
</style>
