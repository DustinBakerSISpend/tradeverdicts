---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import trades from "../../../data/nba/trades.json";
import teams from "../../../data/nba/teams.json";

const clean = (value = "") => String(value ?? "").trim();
const unique = (values) => [...new Set(values.filter(Boolean))];
const formatDate = (value = "") => {
  const raw = clean(value);
  if (!/^\d{4}-\d{2}-\d{2}$/u.test(raw)) return raw || "Date unavailable";

  const [year, month, day] = raw.split("-").map(Number);
  return new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(Date.UTC(year, month - 1, day)));
};
const trimSummary = (value = "", length = 240) => {
  const text = clean(value).replace(/\s+/gu, " ");
  return text.length > length
    ? `${text.slice(0, length - 1).trimEnd()}...`
    : text;
};

const teamBySlug = new Map(
  teams.map((team) => [clean(team?.slug), team]),
);
const activeTeams = teams
  .filter((team) => team?.active === true && clean(team?.slug))
  .map((team) => ({
    slug: clean(team.slug),
    name: clean(team.name),
    abbreviation: clean(team.abbreviation),
  }))
  .sort((left, right) => left.name.localeCompare(right.name, "en"));
const activeTeamSlugs = new Set(activeTeams.map((team) => team.slug));
const activeNameBySlug = new Map(
  activeTeams.map((team) => [team.slug, team.name]),
);

const normalizeToCurrentFranchise = (slug) => {
  const cleanSlug = clean(slug);
  const team = teamBySlug.get(cleanSlug);

  if (!team) return "";
  if (team.active === true && activeTeamSlugs.has(cleanSlug)) {
    return cleanSlug;
  }

  const lineageTeam = clean(team.lineageTeam);
  return activeTeamSlugs.has(lineageTeam) ? lineageTeam : "";
};

const pairsByKey = new Map();

for (const trade of trades) {
  const normalizedTeams = unique(
    (Array.isArray(trade?.teams) ? trade.teams : [])
      .map(normalizeToCurrentFranchise),
  ).sort((left, right) => left.localeCompare(right, "en"));

  for (let left = 0; left < normalizedTeams.length; left += 1) {
    for (
      let right = left + 1;
      right < normalizedTeams.length;
      right += 1
    ) {
      const first = normalizedTeams[left];
      const second = normalizedTeams[right];
      const key = `${first}::${second}`;
      const pair = pairsByKey.get(key) ?? {
        key,
        first,
        second,
        firstName: activeNameBySlug.get(first) ?? first,
        secondName: activeNameBySlug.get(second) ?? second,
        trades: [],
      };

      const date = clean(trade?.tradeDate || trade?.date);
      pair.trades.push({
        slug: clean(trade?.slug),
        date,
        formattedDate: formatDate(date),
        summary: trimSummary(trade?.summary),
        verdict: clean(trade?.verdict),
        sourceTradeId: clean(trade?.sourceTradeId),
      });
      pairsByKey.set(key, pair);
    }
  }
}

const pairs = [...pairsByKey.values()]
  .map((pair) => ({
    ...pair,
    trades: pair.trades
      .filter((trade) => trade.slug)
      .sort((left, right) =>
        right.date.localeCompare(left.date) ||
        left.slug.localeCompare(right.slug),
      ),
  }))
  .sort((left, right) =>
    left.firstName.localeCompare(right.firstName, "en") ||
    left.secondName.localeCompare(right.secondName, "en"),
  );
---

<BaseLayout
  title="NBA Team-to-Team Trade History | Trade Verdicts"
  description="Select two current NBA franchises and browse every recorded trade between them."
  indexEligible={false}
  adEligible={false}
  robots="noindex,nofollow"
  navigationContext="nba"
>
  <main class="matchup-page">
    <div class="guard">
      Private local NBA preview - not authorized for publication
    </div>

    <p class="eyebrow">NBA TRADE DATABASE</p>
    <h1>Team-to-Team Trade History</h1>
    <p class="intro">
      Select two current NBA franchises to see every recorded trade between
      them. Confirmed franchise-lineage identities are normalized to the
      current franchise; defunct clubs remain separate historical archives.
    </p>

    <section class="matchup-search" aria-labelledby="matchup-search-title">
      <p class="panel-label">MATCHUP SEARCH</p>
      <h2 id="matchup-search-title">Choose two teams</h2>

      <div class="matchup-controls">
        <label>
          <span>First team</span>
          <select id="first-team" name="first">
            <option value="">Select a team</option>
            {activeTeams.map((team) => (
              <option value={team.slug}>{team.name}</option>
            ))}
          </select>
        </label>

        <span class="versus" aria-hidden="true">VS.</span>

        <label>
          <span>Second team</span>
          <select id="second-team" name="second">
            <option value="">Select a team</option>
            {activeTeams.map((team) => (
              <option value={team.slug}>{team.name}</option>
            ))}
          </select>
        </label>

        <button id="view-history" type="button" disabled>
          View Trade History
        </button>
      </div>

      <p class="matchup-note">
        Multi-team trades are included whenever both selected franchises
        participated.
      </p>
    </section>

    <section
      id="matchup-result"
      class="matchup-result"
      aria-live="polite"
      aria-busy="false"
    >
      <div id="empty-result" class="empty-result">
        <h2>Select two teams to begin</h2>
        <p>The complete matchup archive will appear here.</p>
      </div>

      <div id="no-result" class="empty-result" hidden>
        <h2>No recorded trades found</h2>
        <p id="no-result-copy">
          No canonical NBA trades currently match this pairing.
        </p>
      </div>

      <div id="pair-results">
        {pairs.map((pair) => (
          <article
            class="pair-result"
            data-pair-result
            data-pair-key={pair.key}
            data-first-name={pair.firstName}
            data-second-name={pair.secondName}
            hidden
          >
            <div class="result-heading">
              <div>
                <p class="panel-label">MATCHUP ARCHIVE</p>
                <h2>{pair.firstName} vs. {pair.secondName}</h2>
                <p>
                  {pair.trades.length.toLocaleString()} recorded trade{
                    pair.trades.length === 1 ? "" : "s"
                  }, newest first.
                </p>
              </div>
              <strong>
                {pair.trades.length.toLocaleString()} trade{
                  pair.trades.length === 1 ? "" : "s"
                }
              </strong>
            </div>

            <ol class="trade-list">
              {pair.trades.map((trade) => (
                <li>
                  <a href={`/nba/trades/${trade.slug}/`}>
                    <div class="trade-meta">
                      <time datetime={trade.date}>
                        {trade.formattedDate}
                      </time>
                      {trade.verdict && <span>{trade.verdict}</span>}
                    </div>
                    <h3>
                      {pair.firstName} / {pair.secondName} Trade
                    </h3>
                    <p>
                      {trade.summary || "Open the private NBA trade record."}
                    </p>
                    {trade.sourceTradeId && (
                      <small>Source ID: {trade.sourceTradeId}</small>
                    )}
                  </a>
                </li>
              ))}
            </ol>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  (() => {
    const firstSelect = document.querySelector("#first-team");
    const secondSelect = document.querySelector("#second-team");
    const button = document.querySelector("#view-history");
    const emptyResult = document.querySelector("#empty-result");
    const noResult = document.querySelector("#no-result");
    const noResultCopy = document.querySelector("#no-result-copy");
    const pairResults = [
      ...document.querySelectorAll("[data-pair-result]"),
    ];
    const resultByKey = new Map(
      pairResults.map((result) => [
        String(result.dataset.pairKey ?? ""),
        result,
      ]),
    );

    if (!firstSelect || !secondSelect || !button) {
      return;
    }

    const sortedPairKey = (first, second) =>
      [String(first), String(second)]
        .sort((left, right) => left.localeCompare(right))
        .join("::");

    const optionText = (select) =>
      select.options[select.selectedIndex]?.textContent?.trim() || "";

    const updateDisabledOptions = () => {
      const firstValue = String(firstSelect.value ?? "");
      const secondValue = String(secondSelect.value ?? "");

      for (const option of firstSelect.options) {
        option.disabled =
          Boolean(option.value) && option.value === secondValue;
      }

      for (const option of secondSelect.options) {
        option.disabled =
          Boolean(option.value) && option.value === firstValue;
      }

      button.disabled =
        !firstValue ||
        !secondValue ||
        firstValue === secondValue;
    };

    const hideResults = () => {
      for (const result of pairResults) {
        result.hidden = true;
      }
      emptyResult.hidden = true;
      noResult.hidden = true;
    };

    const syncUrl = (first, second) => {
      const url = new URL(window.location.href);

      if (first && second) {
        url.searchParams.set("first", first);
        url.searchParams.set("second", second);
      } else {
        url.searchParams.delete("first");
        url.searchParams.delete("second");
      }

      window.history.replaceState(
        {},
        "",
        `${url.pathname}${url.search}${url.hash}`,
      );
    };

    const showSelectedPair = () => {
      const first = String(firstSelect.value ?? "");
      const second = String(secondSelect.value ?? "");

      updateDisabledOptions();

      if (!first || !second || first === second) {
        hideResults();
        emptyResult.hidden = false;
        syncUrl("", "");
        return;
      }

      hideResults();
      const key = sortedPairKey(first, second);
      const result = resultByKey.get(key);

      if (result) {
        result.hidden = false;
      } else {
        const firstName = optionText(firstSelect);
        const secondName = optionText(secondSelect);
        noResultCopy.textContent =
          `No canonical NBA trades are recorded between ${firstName} and ${secondName}.`;
        noResult.hidden = false;
      }

      syncUrl(first, second);
    };

    const restoreFromUrl = () => {
      const params = new URLSearchParams(window.location.search);
      const first = params.get("first") || "";
      const second = params.get("second") || "";

      if (
        first &&
        [...firstSelect.options].some((option) => option.value === first)
      ) {
        firstSelect.value = first;
      }

      if (
        second &&
        [...secondSelect.options].some((option) => option.value === second)
      ) {
        secondSelect.value = second;
      }

      updateDisabledOptions();

      if (firstSelect.value && secondSelect.value) {
        showSelectedPair();
      }
    };

    firstSelect.addEventListener("change", updateDisabledOptions);
    secondSelect.addEventListener("change", updateDisabledOptions);
    button.addEventListener("click", showSelectedPair);

    restoreFromUrl();
  })();
</script>

<style>
  :global(body) {
    background: #080d12;
  }

  .matchup-page {
    width: min(900px, calc(100% - 32px));
    margin: 0 auto;
    padding: 42px 0 76px;
  }

  .guard {
    margin-bottom: 32px;
    border: 1px solid #d7aa3e;
    border-radius: 10px;
    padding: 10px 13px;
    background: rgba(215, 170, 62, 0.08);
    color: #f0cd72;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .eyebrow,
  .panel-label {
    margin: 0 0 8px;
    color: #d7aa3e;
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.07em;
  }

  h1 {
    max-width: 760px;
    margin: 0;
    color: #f2f4f8;
    font-size: clamp(3rem, 7vw, 5.35rem);
    line-height: 0.96;
    letter-spacing: -0.045em;
  }

  .intro {
    max-width: 700px;
    margin: 20px 0 30px;
    color: #a9c9e8;
    font-size: 1rem;
    line-height: 1.7;
  }

  .matchup-search,
  .matchup-result {
    border: 1px solid #344557;
    border-radius: 14px;
    background: #151d26;
  }

  .matchup-search {
    padding: 24px;
  }

  .matchup-search h2,
  .matchup-result h2 {
    margin: 0;
    color: #f2f4f8;
    font-size: 1.35rem;
  }

  .matchup-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto;
    gap: 12px;
    align-items: end;
    margin-top: 22px;
  }

  .matchup-controls label {
    display: grid;
    gap: 8px;
  }

  .matchup-controls label > span {
    color: #f2f4f8;
    font-size: 0.82rem;
    font-weight: 800;
  }

  select,
  button {
    min-height: 48px;
    border: 1px solid #40546a;
    border-radius: 10px;
    font: inherit;
  }

  select {
    width: 100%;
    padding: 0 42px 0 14px;
    background: #0b1118;
    color: #f2f4f8;
    font-weight: 700;
  }

  select:focus-visible {
    border-color: #d7aa3e;
    outline: 2px solid rgba(215, 170, 62, 0.16);
  }

  .versus {
    align-self: end;
    padding-bottom: 15px;
    color: #91b5d8;
    font-weight: 900;
  }

  button {
    padding: 0 20px;
    border-color: #6b5420;
    background: #d7aa3e;
    color: #0a0d11;
    font-weight: 900;
    cursor: pointer;
    white-space: nowrap;
  }

  button:hover:not(:disabled),
  button:focus-visible:not(:disabled) {
    background: #f0cd72;
  }

  button:disabled {
    border-color: #344557;
    background: #263342;
    color: #91a3b5;
    cursor: not-allowed;
  }

  .matchup-note {
    margin: 14px 0 0;
    color: #91b5d8;
    font-size: 0.82rem;
  }

  .matchup-result {
    min-height: 124px;
    margin-top: 22px;
    padding: 28px;
  }

  .empty-result {
    display: grid;
    place-items: center;
    min-height: 70px;
    text-align: center;
  }

  .empty-result p {
    margin: 8px 0 0;
    color: #a9c9e8;
  }

  .result-heading {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    align-items: end;
    margin-bottom: 22px;
  }

  .result-heading p:not(.panel-label) {
    margin: 8px 0 0;
    color: #a9c9e8;
  }

  .result-heading > strong {
    color: #f0cd72;
    white-space: nowrap;
  }

  .trade-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trade-list a {
    display: block;
    border: 1px solid #344557;
    border-radius: 11px;
    padding: 17px 18px;
    background: #0d141c;
    color: #f2f4f8;
    text-decoration: none;
  }

  .trade-list a:hover,
  .trade-list a:focus-visible {
    border-color: #d7aa3e;
    background: #111b25;
    outline: none;
  }

  .trade-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
  }

  .trade-meta time,
  .trade-meta span {
    border: 1px solid #40546a;
    border-radius: 999px;
    padding: 4px 8px;
    color: #a9c9e8;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .trade-meta span {
    border-color: #6b5420;
    color: #f0cd72;
  }

  .trade-list h3 {
    margin: 12px 0 7px;
    font-size: 1rem;
  }

  .trade-list p {
    margin: 0;
    color: #a9c9e8;
    line-height: 1.55;
  }

  .trade-list small {
    display: block;
    margin-top: 9px;
    color: #70869a;
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 760px) {
    .matchup-controls {
      grid-template-columns: 1fr;
    }

    .versus {
      justify-self: center;
      padding: 0;
    }

    button {
      width: 100%;
    }

    .result-heading {
      align-items: start;
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
