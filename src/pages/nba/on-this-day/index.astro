---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import trades from "../../../data/nba/trades.json";
import teams from "../../../data/nba/teams.json";
import { formatNbaTeamName } from "../../../lib/nba/build-homepage-model.mjs";

const clean = (value = "") => String(value ?? "").trim();
const monthNames = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December",
];
const dayGroups = new Map();

for (const trade of trades) {
  const date = clean(trade?.tradeDate || trade?.date);
  if (!/^\d{4}-\d{2}-\d{2}$/u.test(date)) continue;

  const key = date.slice(5);
  const [month, day] = key.split("-").map(Number);
  const label = `${monthNames[month - 1]} ${day}`;
  const group = dayGroups.get(key) ?? { key, label, trades: [] };
  const names = (Array.isArray(trade?.teams) ? trade.teams : [])
    .map((slug) => formatNbaTeamName(slug, teams))
    .join(" / ");

  group.trades.push({
    slug: clean(trade?.slug),
    date,
    year: date.slice(0, 4),
    names,
    summary: clean(trade?.summary),
  });
  dayGroups.set(key, group);
}

const days = [...dayGroups.values()]
  .map((group) => ({
    ...group,
    trades: group.trades
      .filter((trade) => trade.slug)
      .sort((left, right) =>
        right.date.localeCompare(left.date) ||
        left.slug.localeCompare(right.slug),
      ),
  }))
  .sort((left, right) => left.key.localeCompare(right.key));
---

<BaseLayout
  title="On This Day in NBA Trade History | Trade Verdicts"
  description="Select a calendar date and browse the private NBA trades completed on that day across league history."
  indexEligible={false}
  adEligible={false}
  robots="noindex,nofollow"
  navigationContext="nba"
>
  <main class="tool-page">
    <div class="guard">
      Private local NBA preview - not authorized for publication
    </div>

    <nav class="tool-nav" aria-label="NBA trade tools">
      <a href="/nba/">NBA home</a>
      <a href="/nba/team-to-team-trade-history/">Team-to-Team</a>
      <a aria-current="page" href="/nba/on-this-day/">On This Day</a>
      <a href="/nba/browse-by-year/">Browse by Year</a>
    </nav>

    <p class="eyebrow">NBA TRADE TOOLS</p>
    <h1>On This Day in NBA Trade History</h1>
    <p class="intro">
      Choose a date to browse every canonical NBA trade in the private archive
      that occurred on that calendar day.
    </p>

    <label class="select-label" for="day-select">Calendar date</label>
    <select id="day-select" class="day-select">
      {days.map((day) => (
        <option value={day.key}>
          {day.label} - {day.trades.length} trade{day.trades.length === 1 ? "" : "s"}
        </option>
      ))}
    </select>

    <div class="day-sections">
      {days.map((day) => (
        <section class="day-section" data-day-section={day.key} hidden>
          <div class="section-heading">
            <h2>{day.label}</h2>
            <strong>
              {day.trades.length} trade{day.trades.length === 1 ? "" : "s"}
            </strong>
          </div>
          <div class="trade-list">
            {day.trades.map((trade) => (
              <a class="trade-card" href={`/nba/trades/${trade.slug}/`}>
                <div>
                  <span class="year">{trade.year}</span>
                  <h3>{trade.names || "NBA trade"}</h3>
                </div>
                <p>{trade.summary || "Open private NBA trade record."}</p>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>

<script is:inline>
  const select = document.querySelector("#day-select");
  const sections = [...document.querySelectorAll("[data-day-section]")];

  const render = () => {
    const selected = select?.value;

    for (const section of sections) {
      section.hidden = section.dataset.daySection !== selected;
    }
  };

  const now = new Date();
  const today =
    `${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;
  const todayOption = [...(select?.options ?? [])].find(
    (option) => option.value === today,
  );

  if (select && todayOption) select.value = today;
  select?.addEventListener("change", render);
  render();
</script>

<style>
  :global(body) {
    background:
      radial-gradient(circle at 50% -8rem, rgba(55, 82, 112, 0.18), transparent 44rem),
      linear-gradient(180deg, #0b1118 0%, #080d12 52%, #060a0e 100%);
  }
  .tool-page { width: min(1040px, calc(100% - 32px)); margin: 0 auto; padding: 30px 0 72px; }
  .guard { border: 1px solid #d7aa3e; background: rgba(215, 170, 62, 0.08); color: #f0cd72; border-radius: 11px; padding: 10px 13px; font-weight: 800; }
  .tool-nav { display: flex; flex-wrap: wrap; gap: 9px; margin: 18px 0 34px; }
  .tool-nav a { border: 1px solid #6b5420; border-radius: 9px; padding: 9px 12px; color: #f0cd72; text-decoration: none; font-weight: 800; background: rgba(215, 170, 62, 0.055); }
  .tool-nav a:hover, .tool-nav a:focus-visible, .tool-nav a[aria-current="page"] { background: rgba(215, 170, 62, 0.15); outline: none; }
  .eyebrow { margin: 0 0 8px; color: #d7aa3e; font-size: 0.76rem; font-weight: 900; letter-spacing: 0.08em; }
  h1 { margin: 0; max-width: 850px; font-size: clamp(2.3rem, 7vw, 4.8rem); line-height: 0.98; }
  .intro { max-width: 760px; color: #a9c9e8; line-height: 1.65; }
  .select-label { display: block; margin: 28px 0 8px; color: #f0cd72; font-weight: 800; }
  .day-select { width: min(440px, 100%); border: 1px solid #40546a; border-radius: 10px; padding: 13px 14px; background: #0b1118; color: #f2f4f8; font: inherit; }
  .day-select:focus { border-color: #d7aa3e; outline: 2px solid rgba(215, 170, 62, 0.16); }
  .day-section { margin-top: 34px; }
  .section-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 18px; border-bottom: 1px solid #344557; padding-bottom: 12px; }
  .section-heading h2 { margin: 0; font-size: 1.7rem; }
  .section-heading strong { color: #f0cd72; }
  .trade-list { display: grid; gap: 11px; margin-top: 15px; }
  .trade-card { display: grid; grid-template-columns: minmax(180px, 0.45fr) 1fr; gap: 18px; border: 1px solid #344557; border-radius: 12px; padding: 15px; background: rgba(21, 29, 38, 0.96); color: #fff; text-decoration: none; }
  .trade-card:hover, .trade-card:focus-visible { border-color: #d7aa3e; background: rgba(215, 170, 62, 0.055); outline: none; }
  .year { color: #d7aa3e; font-weight: 900; }
  h3 { margin: 5px 0 0; font-size: 1rem; }
  .trade-card p { margin: 0; color: #a9c9e8; line-height: 1.5; }
  [hidden] { display: none !important; }
  @media (max-width: 650px) { .trade-card { grid-template-columns: 1fr; } }
</style>
