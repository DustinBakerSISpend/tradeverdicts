---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CURRENT_NFL_TEAMS } from "../utils/teamRegistry.js";

const teamOptions = CURRENT_NFL_TEAMS.map(
  ({ name, slug }) => [name, slug]
);
---

<BaseLayout
  title="Team-to-Team NFL Trade History | TradeVerdicts"
  indexEligible={false}
  adEligible={false}
>
  <main class="history-shell">
    <section class="history-hero">
      <p class="eyebrow">NFL Trade Database</p>
      <h1>Team-to-Team Trade History</h1>
      <p>
        Select two current NFL franchises to see every recorded trade between them.
        Confirmed franchise-lineage identities are normalized to the current franchise; defunct clubs remain separate historical archives.
      </p>
    </section>

    <section class="selector-panel" aria-labelledby="selector-title">
      <div>
        <p class="panel-label">Matchup search</p>
        <h2 id="selector-title">Choose two teams</h2>
      </div>

      <form id="teamHistoryForm">
        <label>
          First team
          <select id="teamA" name="teamA" required>
            <option value="">Select a team</option>
            {teamOptions.map(([name, slug]) => (
              <option value={slug}>{name}</option>
            ))}
          </select>
        </label>

        <span class="versus" aria-hidden="true">vs.</span>

        <label>
          Second team
          <select id="teamB" name="teamB" required>
            <option value="">Select a team</option>
            {teamOptions.map(([name, slug]) => (
              <option value={slug}>{name}</option>
            ))}
          </select>
        </label>

        <button id="viewHistoryButton" type="submit" disabled>
          View Trade History
        </button>
      </form>

      <p class="selector-note">
        Multi-team trades are included whenever both selected franchises participated.
      </p>
    </section>

    <section
      id="resultsSection"
      class="results-section"
      aria-live="polite"
      hidden
    >
      <div class="results-header">
        <div>
          <p class="panel-label">Matchup archive</p>
          <h2 id="resultsTitle"></h2>
        </div>
        <strong id="resultsCount"></strong>
      </div>

      <div id="resultsList" class="results-list"></div>
    </section>

    <section id="emptyState" class="empty-state">
      <h2>Select two teams to begin.</h2>
      <p>The complete matchup archive will appear here.</p>
    </section>
  </main>
</BaseLayout>

<script define:vars={{ teamOptions }}>
  const form = document.getElementById("teamHistoryForm");
  const teamASelect = document.getElementById("teamA");
  const teamBSelect = document.getElementById("teamB");
  const submitButton = document.getElementById("viewHistoryButton");
  const resultsSection = document.getElementById("resultsSection");
  const resultsTitle = document.getElementById("resultsTitle");
  const resultsCount = document.getElementById("resultsCount");
  const resultsList = document.getElementById("resultsList");
  const emptyState = document.getElementById("emptyState");

  const teamNameBySlug = new Map(
    teamOptions.map(([name, slug]) => [slug, name])
  );

  let pairIndexPromise;

  const escapeHtml = (value = "") =>
    String(value).replace(/[&<>"']/g, (character) => {
      const entities = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#039;",
      };

      return entities[character];
    });

  const getPairKey = (teamA, teamB) =>
    [teamA, teamB].sort().join("__");

  const formatDate = (date = "") => {
    if (!date) return "Date unavailable";

    const parsed = new Date(`${date}T00:00:00`);

    if (Number.isNaN(parsed.getTime())) {
      return date;
    }

    return parsed.toLocaleDateString("en-US", {
      month: "long",
      day: "numeric",
      year: "numeric",
    });
  };

  const getAssetName = (asset = {}) =>
    asset.asset ||
    asset.name ||
    asset.description ||
    "Unspecified asset";

  const renderAssets = (trade, teamSlug) => {
    const assets = trade.assetsReceived?.[teamSlug] || [];

    if (!assets.length) {
      return '<p class="no-assets">No recorded return.</p>';
    }

    return `
      <ul>
        ${assets
          .map(
            (asset) =>
              `<li>${escapeHtml(getAssetName(asset))}</li>`
          )
          .join("")}
      </ul>
    `;
  };

  const loadPairIndex = () => {
    if (!pairIndexPromise) {
      pairIndexPromise = fetch("/api/team-trade-history.json", {
        headers: {
          Accept: "application/json",
        },
      }).then((response) => {
        if (!response.ok) {
          throw new Error(
            `Trade-history request failed with status ${response.status}.`
          );
        }

        return response.json();
      });
    }

    return pairIndexPromise;
  };

  const syncSelectionState = () => {
    const teamA = teamASelect.value;
    const teamB = teamBSelect.value;

    for (const option of teamASelect.options) {
      option.disabled = Boolean(teamB) && option.value === teamB;
    }

    for (const option of teamBSelect.options) {
      option.disabled = Boolean(teamA) && option.value === teamA;
    }

    submitButton.disabled =
      !teamA ||
      !teamB ||
      teamA === teamB;
  };

  const updateUrl = (teamA, teamB) => {
    const url = new URL(window.location.href);
    url.searchParams.set("teamA", teamA);
    url.searchParams.set("teamB", teamB);
    window.history.replaceState({}, "", url);
  };

  const renderResults = async (teamA, teamB) => {
    const teamAName = teamNameBySlug.get(teamA) || teamA;
    const teamBName = teamNameBySlug.get(teamB) || teamB;

    emptyState.hidden = true;
    resultsSection.hidden = false;
    resultsTitle.textContent = `${teamAName} vs. ${teamBName}`;
    resultsCount.textContent = "Loading...";
    resultsList.innerHTML =
      '<div class="loading-card">Loading trade history...</div>';

    try {
      const pairIndex = await loadPairIndex();
      const records = pairIndex[getPairKey(teamA, teamB)] || [];

      resultsCount.textContent = `${records.length} ${
        records.length === 1 ? "trade" : "trades"
      }`;

      if (!records.length) {
        resultsList.innerHTML = `
          <div class="no-results-card">
            <h3>No recorded trades found.</h3>
            <p>TradeVerdicts does not currently have a public trade between these franchises.</p>
          </div>
        `;
        return;
      }

      resultsList.innerHTML = records
        .map((trade) => {
          const participatingTeams = (trade.teams || [])
            .map((team) => teamNameBySlug.get(team) || team)
            .join(" · ");

          const gradeA = trade.grades?.[teamA] || "—";
          const gradeB = trade.grades?.[teamB] || "—";

          return `
            <article class="trade-result">
              <div class="trade-topline">
                <div>
                  <time datetime="${escapeHtml(trade.tradeDate)}">
                    ${escapeHtml(formatDate(trade.tradeDate))}
                  </time>
                  <span>${escapeHtml(participatingTeams)}</span>
                </div>
                <strong>${escapeHtml(trade.verdict || "Verdict pending")}</strong>
              </div>

              <div class="grade-grid">
                <div>
                  <span>${escapeHtml(teamAName)}</span>
                  <strong>${escapeHtml(gradeA)}</strong>
                </div>
                <div>
                  <span>${escapeHtml(teamBName)}</span>
                  <strong>${escapeHtml(gradeB)}</strong>
                </div>
              </div>

              <div class="asset-grid">
                <section>
                  <h3>${escapeHtml(teamAName)} received</h3>
                  ${renderAssets(trade, teamA)}
                </section>
                <section>
                  <h3>${escapeHtml(teamBName)} received</h3>
                  ${renderAssets(trade, teamB)}
                </section>
              </div>

              <p class="trade-summary">
                ${escapeHtml(trade.summary || "Summary unavailable.")}
              </p>

              <a class="trade-link" href="/trades/${encodeURIComponent(
                trade.slug
              )}/">
                View full trade verdict
              </a>
            </article>
          `;
        })
        .join("");
    } catch (error) {
      resultsCount.textContent = "Unavailable";
      resultsList.innerHTML = `
        <div class="no-results-card">
          <h3>Trade history could not be loaded.</h3>
          <p>Please refresh the page and try again.</p>
        </div>
      `;
      console.error(error);
    }
  };

  teamASelect.addEventListener("change", syncSelectionState);
  teamBSelect.addEventListener("change", syncSelectionState);

  form.addEventListener("submit", (event) => {
    event.preventDefault();

    const teamA = teamASelect.value;
    const teamB = teamBSelect.value;

    if (!teamA || !teamB || teamA === teamB) {
      return;
    }

    updateUrl(teamA, teamB);
    renderResults(teamA, teamB);
  });

  const initialUrl = new URL(window.location.href);
  const initialTeamA = initialUrl.searchParams.get("teamA") || "";
  const initialTeamB = initialUrl.searchParams.get("teamB") || "";

  if (
    teamNameBySlug.has(initialTeamA) &&
    teamNameBySlug.has(initialTeamB) &&
    initialTeamA !== initialTeamB
  ) {
    teamASelect.value = initialTeamA;
    teamBSelect.value = initialTeamB;
    syncSelectionState();
    renderResults(initialTeamA, initialTeamB);
  } else {
    syncSelectionState();
  }
</script>

<style>
  .history-shell {
    max-width: 1120px;
    margin: 0 auto;
    padding: 52px 20px 80px;
  }

  .history-hero {
    max-width: 780px;
    margin-bottom: 28px;
  }

  .eyebrow,
  .panel-label {
    margin: 0 0 9px;
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .history-hero h1 {
    margin: 0 0 14px;
    font-size: clamp(2.4rem, 6vw, 4.7rem);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .history-hero > p:last-child {
    max-width: 720px;
    margin: 0;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .selector-panel,
  .results-section,
  .empty-state {
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--panel);
  }

  .selector-panel {
    padding: 22px;
  }

  .selector-panel h2,
  .results-header h2,
  .empty-state h2 {
    margin: 0;
    letter-spacing: -0.03em;
  }

  #teamHistoryForm {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto;
    gap: 14px;
    align-items: end;
    margin-top: 20px;
  }

  label {
    display: grid;
    gap: 8px;
    color: white;
    font-size: 0.85rem;
    font-weight: 800;
  }

  select,
  button {
    min-height: 48px;
    border-radius: 12px;
    font: inherit;
  }

  select {
    width: 100%;
    border: 1px solid var(--border);
    padding: 0 13px;
    background: rgba(8, 12, 18, 0.88);
    color: white;
  }

  select:focus,
  button:focus-visible,
  .trade-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .versus {
    padding-bottom: 14px;
    color: var(--muted);
    font-weight: 900;
  }

  button {
    border: 1px solid var(--accent);
    padding: 0 18px;
    background: var(--accent);
    color: #07111f;
    cursor: pointer;
    font-weight: 900;
  }

  button:disabled {
    border-color: var(--border);
    background: rgba(255, 255, 255, 0.08);
    color: var(--muted);
    cursor: not-allowed;
  }

  .selector-note {
    margin: 14px 0 0;
    color: var(--muted);
    font-size: 0.86rem;
  }

  .results-section {
    margin-top: 24px;
    padding: 22px;
  }

  .results-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
  }

  .results-header > strong {
    color: var(--accent);
  }

  .results-list {
    display: grid;
    gap: 22px;
  }

  .trade-result {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid rgba(78, 161, 255, 0.32);
    border-left: 4px solid var(--accent);
    border-radius: 20px;
    background: linear-gradient(180deg, rgba(18, 26, 38, 0.98), rgba(8, 12, 18, 0.98));
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.3);
    padding: 22px;
  }

  .loading-card,
  .no-results-card {
    border: 1px solid rgba(78, 161, 255, 0.22);
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(18, 26, 38, 0.96), rgba(10, 16, 24, 0.96));
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.24);
    padding: 20px;
  }

  .trade-topline {
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .trade-topline time,
  .trade-topline span {
    display: block;
  }

  .trade-topline time {
    color: white;
    font-weight: 900;
  }

  .trade-topline span {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .trade-topline > strong {
    color: var(--accent);
    text-align: right;
  }

  .grade-grid,
  .asset-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .grade-grid {
    margin-bottom: 14px;
  }

  .asset-grid {
    margin-bottom: 14px;
  }

  .grade-grid > div,
  .asset-grid > section {
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
  }

  .grade-grid > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 12px;
  }

  .grade-grid span {
    color: var(--muted);
    font-size: 0.84rem;
  }

  .grade-grid strong {
    color: white;
    font-size: 1.25rem;
  }

  .asset-grid > section {
    padding: 13px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .asset-grid h3 {
    margin: 0 0 8px;
    color: white;
    font-size: 0.9rem;
  }

  .asset-grid ul {
    margin: 0;
    padding-left: 18px;
    color: var(--muted);
  }

  .asset-grid li + li {
    margin-top: 5px;
  }

  .no-assets {
    margin: 0;
    color: var(--muted);
  }

  .trade-summary {
    margin: 16px 0 18px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: #bfe0ff;
    line-height: 1.58;
  }

  .trade-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    border: 1px solid rgba(78, 161, 255, 0.35);
    border-radius: 10px;
    padding: 8px 12px;
    background: rgba(78, 161, 255, 0.12);
    color: #d9ecff;
    font-size: 0.88rem;
    font-weight: 900;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }

  .trade-link:hover {
    border-color: var(--accent);
    background: rgba(78, 161, 255, 0.2);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .empty-state {
    margin-top: 24px;
    padding: 34px 22px;
    text-align: center;
  }

  .empty-state p,
  .no-results-card p {
    margin: 8px 0 0;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    #teamHistoryForm {
      grid-template-columns: 1fr;
    }

    .versus {
      display: none;
    }

    .results-header,
    .trade-topline {
      align-items: flex-start;
      flex-direction: column;
    }

    .trade-topline > strong {
      text-align: left;
    }
  }

  @media (max-width: 620px) {
    .history-shell {
      padding: 34px 14px 64px;
    }

    .selector-panel,
    .results-section {
      padding: 16px;
    }

    .grade-grid,
    .asset-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
