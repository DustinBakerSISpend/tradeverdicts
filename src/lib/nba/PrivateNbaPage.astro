---
import trades from "../../data/nba/trades.json";
import teamEditorialCoverage from "../../data/nba/team-editorial-coverage.json";
import tradeEditorialCoverage from "../../data/nba/trade-editorial-coverage.json";
import { buildPrivateTradeDetailView } from "./build-private-trade-detail-view.mjs";

const { model, models } = Astro.props;
const privateLinkingEnabled =
  model?.privacy?.access === "private-local-only" &&
  model?.privacy?.publishStatus === "private" &&
  model?.privacy?.indexEligible === false &&
  model?.privacy?.adEligible === false;
const allModels = Array.isArray(models) ? models : [];

const modelByPath = new Map(
  allModels.map((entry) => [
    entry.path,
    entry,
  ]),
);

const unsortedRenderedLinks =
  privateLinkingEnabled && Array.isArray(model.links)
    ? model.links
    : [];

const renderedLinks =
  model.routeType === "trade_index"
    ? [...unsortedRenderedLinks].sort((left, right) => {
        const leftModel = modelByPath.get(left.path);
        const rightModel = modelByPath.get(right.path);
        const leftDate = String(leftModel?.tradeDate ?? "");
        const rightDate = String(rightModel?.tradeDate ?? "");

        return (
          rightDate.localeCompare(leftDate) ||
          String(rightModel?.title ?? "").localeCompare(
            String(leftModel?.title ?? ""),
          )
        );
      })
    : unsortedRenderedLinks;

const titleByPath = new Map(
  allModels.map((entry) => [
    entry.path,
    entry.title,
  ]),
);

const searchTextByPath = new Map(
  allModels
    .filter((entry) => entry.routeType === "trade_detail")
    .map((entry) => [
      entry.path,
      [
        entry.title,
        entry.description,
        entry.tradeDate,
        entry.verdict,
        entry.sourceTradeId,
        ...(Array.isArray(entry.teams)
          ? entry.teams.flatMap((team) => [
              team.name,
              team.abbreviation,
              team.slug,
            ])
          : []),
        ...(Array.isArray(entry.players)
          ? entry.players.flatMap((player) => [
              player.name,
              ...(Array.isArray(player.aliases)
                ? player.aliases
                : []),
            ])
          : []),
      ]
        .filter(Boolean)
        .join(" "),
    ]),
);
const relationLabel = (relation = "") => {
  const labels = {
    section_index: "Browse",
    trade_detail: "Trade",
    player_detail: "Player",
    team_detail: "Team",
  };

  return labels[relation] ?? "Record";
};
const canonicalTrade =
  model.routeType === "trade_detail"
    ? trades.find((trade) => trade.id === model.entityId)
    : null;
const tradeView = buildPrivateTradeDetailView({
  trade: canonicalTrade,
  model,
});
const tradeEditorial =
  model.routeType === "trade_detail"
    ? tradeEditorialCoverage.find(
        (entry) => entry.tradeSlug === canonicalTrade?.slug,
      ) ?? null
    : null;
const teamCoverage =
  model.routeType === "team_detail"
    ? teamEditorialCoverage.find(
        (entry) => entry.teamSlug === model.entityId,
      ) ?? null
    : null;
const details = [];
const careerTradeHistory =
  model.routeType === "player_detail" &&
  Array.isArray(model.careerTradeHistory)
    ? model.careerTradeHistory
    : [];
const hasCareerTradeHistory = careerTradeHistory.length > 0;

if (model.routeType === "player_detail") {
  details.push(["Canonical name", model.name]);
  details.push([
    "Aliases",
    model.aliases.length ? model.aliases.join(", ") : "None",
  ]);

  if (hasCareerTradeHistory) {
    details.push(["Career trades", String(model.careerTradeCount)]);
    details.push([
      "Canonical archive coverage",
      `${model.careerArchiveLinkedCount ?? model.linkedTradeCount} of ${model.careerTradeCount}`,
    ]);
    details.push([
      "Archive gaps",
      model.archiveGapCount
        ? `${model.archiveGapCount} historical trade${model.archiveGapCount === 1 ? "" : "s"} not yet represented`
        : "None",
    ]);
  } else {
    details.push(["Reference types", model.referenceTypes.join(", ")]);
    details.push(["Linked trades", String(model.linkedTradeCount)]);

    if (
      Number.isInteger(model.careerTradeCount) &&
      model.careerTradeCount > 0
    ) {
      details.push(["Career trades", String(model.careerTradeCount)]);
    }
  }
} else if (model.routeType === "team_detail") {
  details.push(["Team", model.team.name]);
  details.push(["Abbreviation", model.team.abbreviation]);
  details.push(["Linked trades", String(model.linkedTradeCount)]);
}

const isIndex = model.routeType.endsWith("_index");
const recordHeading = isIndex
  ? "Browse private records"
  : "Connected NBA records";
const showFilter = renderedLinks.length > 16;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="googlebot" content="noindex,nofollow" />
    <meta name="bingbot" content="noindex,nofollow" />
    <meta name="description" content={model.description} />
    <title>{model.title}</title>
  </head>
  <body
    data-nba-private="true"
    data-private-linking-enabled={privateLinkingEnabled ? "true" : "false"}
    data-index-eligible="false"
    data-ad-eligible="false"
    data-publication-ready="false"
    data-route-type={model.routeType}
    data-link-count={renderedLinks.length}
    data-nfl-trade-detail-presentation-parity={
      tradeView.available ? "true" : "false"
    }
  >
    <header class="site-header">
      <a class="brand" href="/nba/">Trade Verdicts</a>
      <nav aria-label="NBA primary navigation">
        <a href="/nba/">Home</a>
        <a href="/nba/teams/">Teams</a>
        <a href="/nba/players/">Players</a>
        <a href="/nba/search/">Search</a>
      </nav>
      <span class="privacy-chip">Private NBA Preview</span>
    </header>

    <main>
      <div class="guard">
        Private local NBA preview - not authorized for publication
      </div>

      {tradeView.available ? (
        <>
          <section class="trade-hero">
            <div class="eyebrow">NBA Trade Verdict</div>
            <h1>{tradeView.heroTitle}</h1>
            <p>{tradeView.summary}</p>

            <div class="badges">
              <span>{tradeView.formattedTradeDate}</span>
              <span>{tradeView.teamLabel}</span>
              <span>Record confidence: {tradeView.confidence}</span>
              <span class="feature-badge">Private Preview</span>
            </div>
          </section>

          <section class="trade-assets">
            {tradeView.teamCards.map((team) => (
              <div class="asset-panel">
                <h2>
                  <a href={team.path}>{team.name}</a> Received
                </h2>

                {team.assets.length > 0 ? (
                  <ul>
                    {team.assets.map((asset) => (
                      <li>
                        <span class="asset-type">{asset.type}</span>
                        {asset.parts.map((part) =>
                          part.type === "player" ? (
                            <a class="player-link" href={part.path}>
                              {part.value}
                            </a>
                          ) : (
                            <span>{part.value}</span>
                          )
                        )}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="empty-panel">
                    No itemized assets are available in the canonical record.
                  </p>
                )}
              </div>
            ))}
          </section>

          {tradeView.gradePanels.length > 0 && (
            <section class="scoreboard">
              {tradeView.gradePanels.map((panel) => (
                <div class="team-panel">
                  <h2>
                    {panel.path ? (
                      <a href={panel.path}>{panel.name}</a>
                    ) : (
                      panel.name
                    )}
                  </h2>
                  {panel.subtitle && (
                    <p class="grade-scope">{panel.subtitle}</p>
                  )}
                  <div class={`grade grade-${panel.gradeTone}`}>
                    {panel.grade}
                  </div>
                </div>
              ))}
            </section>
          )}

          {tradeView.gradeCoverageNote && (
            <p class="grade-note">
              {tradeView.gradeCoverageNote}
            </p>
          )}

          {Astro.url.pathname.includes("/nba/trades/boston-celtics-2026-07-06-80b6858fc2d0") ? (
            <section
              class="analysis featured-trade-deep-dive"
              data-featured-trade-deep-dive="boston-celtics-2026-07-06-80b6858fc2d0"
            >
              <div class="featured-deep-dive-heading">
                <div>
                  <span>Homepage Featured Trade</span>
                  <h2>Trade Analysis</h2>
                </div>
                <strong>76ers Win</strong>
              </div>

              <p class="featured-deep-dive-intro">
                Philadelphia acquired the younger championship star. Boston accepted
                more age and short-term risk in Paul George, but also collected four
                future draft assets that keep the long-term value of this blockbuster
                unsettled.
              </p>

              <div class="analysis-sections featured-analysis-sections">
                <article class="analysis-perspective">
                  <h3 class="analysis-perspective-title">The Deal</h3>
                  <p>
                    Philadelphia acquired Jaylen Brown. Boston received Paul George,
                    first-round picks in 2028 and 2031, plus conditional second-round
                    picks in 2028 and 2030. The unusual part is the structure: this is
                    a star-for-star exchange in which the future draft control is
                    nearly as important as the headline names.
                  </p>
                </article>

                <article class="analysis-perspective">
                  <h3 class="analysis-perspective-title">Boston's Bet</h3>
                  <p>
                    Boston chose a broader package instead of simply keeping Brown.
                    George preserves high-end veteran talent in the immediate lineup,
                    while two first-rounders and two conditional seconds give the
                    Celtics additional paths to replenish, trade or reshape the roster
                    later. That flexibility keeps the return strong, but moving Brown
                    creates enough long-term risk to hold Boston at a B.
                  </p>
                </article>

                <article class="analysis-perspective">
                  <h3 class="analysis-perspective-title">Philadelphia's Bet</h3>
                  <p>
                    Philadelphia paid the premium to consolidate George and four draft
                    assets into Brown, a championship-proven centerpiece who was
                    already central to Boston's 2024 title. The 76ers surrendered
                    meaningful future control, but they came away with the most
                    valuable long-term player in the transaction. That clearer
                    top-end outcome earns Philadelphia the B+.
                  </p>
                </article>

                <article class="analysis-perspective">
                  <h3 class="analysis-perspective-title">The Swing Factor</h3>
                  <p>
                    The 2028 and 2031 first-round picks prevent this from becoming an
                    easy Philadelphia win. Their eventual position and what Boston
                    does with them could materially change the retrospective grade.
                    For now, Brown's value outweighs the uncertainty attached to those
                    future assets.
                  </p>
                </article>
              </div>

              <div class="featured-deep-dive-verdict">
                <span>Final Verdict</span>
                <strong>76ers Win — Slight Philadelphia Edge</strong>
                <p>
                  Philadelphia gets the B+ and the early win because Brown is the
                  younger, championship-proven centerpiece. Boston earns a B because
                  George plus four draft assets provides real present and future
                  value, but the Celtics assume more age risk and need the picks to
                  develop well for the deal to swing back in their direction.
                </p>
              </div>
            </section>
          ) : tradeEditorial ? (
            <section
              class="trade-editorial-coverage"
              data-trade-editorial={tradeEditorial.tradeSlug}
            >
              <section class="analysis trade-editorial-analysis">
                <h2>Trade Analysis</h2>

                <div class="trade-editorial-sections">
                  {tradeEditorial.tradeAnalysis.sections.map((section) => (
                    <article>
                      <h3>{section.heading}</h3>
                      <p>{section.body}</p>
                    </article>
                  ))}

                  <article class="trade-editorial-verdict">
                    <h3>{tradeEditorial.tradeAnalysis.finalVerdict.heading}</h3>
                    <p>{tradeEditorial.tradeAnalysis.finalVerdict.body}</p>
                  </article>
                </div>
              </section>

              <section class="analysis trade-expanded-analysis">
                <div class="expanded-label">
                  {tradeEditorial.featuredDeepDive.label}
                </div>

                <h2>{tradeEditorial.featuredDeepDive.heading}</h2>
                <p class="trade-expanded-intro">
                  {tradeEditorial.featuredDeepDive.intro}
                </p>

                <div class="trade-expanded-sections">
                  {tradeEditorial.featuredDeepDive.sections.map((section) => (
                    <article>
                      <h3>{section.heading}</h3>
                      <p>{section.body}</p>
                    </article>
                  ))}

                  <article class="trade-editorial-verdict">
                    <h3>{tradeEditorial.featuredDeepDive.finalVerdict.heading}</h3>
                    <p>{tradeEditorial.featuredDeepDive.finalVerdict.body}</p>
                  </article>
                </div>
              </section>

              <details class="analysis trade-editorial-sources">
                <summary>
                  Research sources ({tradeEditorial.sources.length})
                </summary>
                <ul>
                  {tradeEditorial.sources.map((source) => (
                    <li>
                      <a
                        href={source.url}
                        target="_blank"
                        rel="noreferrer"
                      >
                        {source.publisher}: {source.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </section>
          ) : (
            tradeView.analysisSections.length > 0 && (
              <section class="analysis">
                <h2>Trade Analysis</h2>
                <div class="analysis-sections">
                  {tradeView.analysisSections.map((section) => (
                    <section class="analysis-perspective">
                      {section.heading && (
                        <h3 class="analysis-perspective-title">
                          {section.heading}
                        </h3>
                      )}
                      {section.blocks.map((block) =>
                        block.type === "heading" ? (
                          <h4 class="analysis-subhead">{block.text}</h4>
                        ) : (
                          <p>{block.text}</p>
                        )
                      )}
                    </section>
                  ))}
                </div>
              </section>
            )
          )}

          {tradeView.unmatchedPlayers.length > 0 && (
            <section class="related-players">
              <h2>Related Player Records</h2>
              <div>
                {tradeView.unmatchedPlayers.map((player) => (
                  <a href={player.path}>{player.name}</a>
                ))}
              </div>
            </section>
          )}
        </>
      ) : (
        <>
          <nav class="site-nav" aria-label="Private NBA navigation">
            <a href="/nba/">NBA home</a>
            <a href="/nba/search/">Search</a>
            <a href="/nba/trades/">All trades</a>
            <a href="/nba/players/">All players</a>
            <a href="/nba/teams/">All teams</a>
            <a href="/nba/team-to-team-trade-history/">Team-to-Team</a>
            <a href="/nba/on-this-day/">On This Day</a>
            <a href="/nba/browse-by-year/">Browse by Year</a>
          </nav>

          <p class="route-label">{model.routeType.replaceAll("_", " ")}</p>
          <h1>{model.title}</h1>
          <p class="description">{model.description}</p>

          {details.length > 0 && (
            <dl>
              {details.map(([label, value]) => (
                <>
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </>
              ))}
            </dl>
          )}

          {hasCareerTradeHistory && (
            <section class="career-trade-history">
              <div class="career-history-heading">
                <div>
                  <p class="section-label">SOURCED CAREER HISTORY</p>
                  <h2>Career trade history</h2>
                </div>
                <strong>{model.careerTradeCount} trades</strong>
              </div>

              <p class="career-history-intro">
                Career totals come from historical transaction research.
                TradeVerdicts links each event to a canonical record when that
                transaction is already represented in the archive; unresolved
                gaps stay visible rather than being silently omitted.
              </p>

              <ol class="career-history-list">
                {careerTradeHistory.map((event) => (
                  <li class={event.path ? "linked" : "pending"}>
                    {event.path ? (
                      <a href={event.path}>
                        <span class="career-history-number">
                          #{event.number}
                        </span>
                        <span class="career-history-copy">
                          <time datetime={event.date}>{event.date}</time>
                          <strong>Traded to {event.destination}</strong>
                        </span>
                        <span class="career-history-status">
                          Canonical record →
                        </span>
                      </a>
                    ) : (
                      <div>
                        <span class="career-history-number">
                          #{event.number}
                        </span>
                        <span class="career-history-copy">
                          <time datetime={event.date}>{event.date}</time>
                          <strong>Traded to {event.destination}</strong>
                        </span>
                        <span class="career-history-status">
                          Canonical record pending
                        </span>
                      </div>
                    )}
                  </li>
                ))}
              </ol>

              {Array.isArray(model.careerTradeSources) &&
                model.careerTradeSources.length > 0 && (
                  <div class="career-history-sources">
                    <span>Research:</span>
                    {model.careerTradeSources.map((source) => (
                      <a
                        href={source.url}
                        target="_blank"
                        rel="noreferrer"
                      >
                        {source.label}
                      </a>
                    ))}
                  </div>
                )}
            </section>
          )}

          {teamCoverage && (
            <section
              class="team-coverage"
              data-team-coverage={teamCoverage.teamCode}
              data-research-source-count={teamCoverage.sources.length}
            >
              <section class="team-analysis-panel">
                <h2>Trade Analysis</h2>
                <p class="team-coverage-intro">{teamCoverage.intro}</p>

                <div class="team-analysis-sections">
                  {teamCoverage.tradeAnalysis.map((section) => (
                    <article>
                      <h3>
                        {section.tradeSlug ? (
                          <a href={`/nba/trades/${section.tradeSlug}/`}>
                            {section.heading}
                          </a>
                        ) : (
                          section.heading
                        )}
                      </h3>
                      <p>{section.body}</p>
                    </article>
                  ))}
                </div>
              </section>

              <section class="team-expanded-analysis">
                <div class="expanded-label">Featured Deep Dive</div>

                {teamCoverage.featuredDeepDive.map((section) => (
                  <article>
                    <h2>
                      {section.tradeSlug ? (
                        <a href={`/nba/trades/${section.tradeSlug}/`}>
                          {section.heading}
                        </a>
                      ) : (
                        section.heading
                      )}
                    </h2>
                    <p>{section.body}</p>
                  </article>
                ))}
              </section>

              <section class="team-final-verdict">
                <h2>{teamCoverage.finalVerdict.heading}</h2>
                <p>{teamCoverage.finalVerdict.body}</p>
              </section>

              <details class="coverage-sources">
                <summary>Research sources ({teamCoverage.sources.length})</summary>
                <ul>
                  {teamCoverage.sources.map((source) => (
                    <li>
                      <a
                        href={source.url}
                        target="_blank"
                        rel="noreferrer"
                      >
                        {source.publisher}: {source.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </section>
          )}

          {!hasCareerTradeHistory && (
            <section class="records">
              <div class="records-heading">
              <div>
                <p class="section-label">
                  {isIndex
                    ? "PRIVATE NBA DIRECTORY"
                    : "INTERNAL LINK GRAPH"}
                </p>
                <h2>{recordHeading}</h2>
              </div>
              <strong>
                {renderedLinks.length.toLocaleString()} record{
                  renderedLinks.length === 1 ? "" : "s"
                }
              </strong>
            </div>

            {showFilter && (
              <div class="filter-wrap">
                <label for="record-filter">Filter these records</label>
                <input
                  id="record-filter"
                  type="search"
                  placeholder="Search names, teams, dates, or record types..."
                  autocomplete="off"
                />
                <p id="record-count">
                  Showing all {renderedLinks.length.toLocaleString()} records
                </p>
              </div>
            )}

            {renderedLinks.length ? (
              <ul class="record-grid">
                {renderedLinks.map((entry) => {
                  const title = titleByPath.get(entry.path) ?? entry.path;
                  const label = relationLabel(entry.relation);
                  const searchableText =
                    searchTextByPath.get(entry.path) ?? "";

                  return (
                    <li
                      data-link-item
                      data-link-search={`${title} ${label} ${entry.path} ${searchableText}`.toLowerCase()}
                    >
                      <a href={entry.path}>
                        <span class={`relation relation-${entry.relation}`}>
                          {label}
                        </span>
                        <strong>{title}</strong>
                      </a>
                    </li>
                  );
                })}
              </ul>
              ) : (
                <p class="empty">No linked records.</p>
              )}
            </section>
          )}
        </>
      )}
    </main>
  <script is:inline>
    (() => {
      const normalizeSearchText = (value) =>
        String(value ?? "")
          .normalize("NFKD")
          .replace(/[\u0300-\u036f]/g, "")
          .toLowerCase()
          .trim();

      const initializeTradeFilter = () => {
        const input = document.querySelector("#record-filter");
        const count = document.querySelector("#record-count");
        const items = [
          ...document.querySelectorAll("[data-link-item]"),
        ];

        if (!input || items.length === 0) {
          return;
        }

        if (input.dataset.filterReady === "true") {
          return;
        }

        const queryFromUrl = new URLSearchParams(
          window.location.search,
        ).get("q");

        if (queryFromUrl !== null) {
          input.value = queryFromUrl;
        }

        const applyFilter = () => {
          const rawQuery = String(input.value ?? "").trim();
          const query = normalizeSearchText(rawQuery);
          let visible = 0;

          for (const item of items) {
            const searchableText = normalizeSearchText(
              item.dataset.linkSearch || item.textContent,
            );
            const matches =
              query.length === 0 ||
              searchableText.includes(query);

            item.hidden = !matches;
            item.style.display = matches ? "" : "none";

            if (matches) {
              visible += 1;
            }
          }

          if (count) {
            count.textContent = query
              ? `Showing ${visible.toLocaleString()} of ${items.length.toLocaleString()} records matching "${rawQuery}"`
              : `Showing all ${items.length.toLocaleString()} records`;
          }
        };

        const syncQueryToUrl = () => {
          const nextUrl = new URL(window.location.href);
          const query = String(input.value ?? "").trim();

          if (query) {
            nextUrl.searchParams.set("q", query);
          } else {
            nextUrl.searchParams.delete("q");
          }

          window.history.replaceState(
            {},
            "",
            `${nextUrl.pathname}${nextUrl.search}${nextUrl.hash}`,
          );
        };

        const handleFilterInput = () => {
          syncQueryToUrl();
          applyFilter();
        };

        input.dataset.filterReady = "true";
        input.addEventListener("input", handleFilterInput);
        input.addEventListener("change", handleFilterInput);
        input.addEventListener("search", handleFilterInput);

        applyFilter();
      };

      if (document.readyState === "loading") {
        document.addEventListener(
          "DOMContentLoaded",
          initializeTradeFilter,
          { once: true },
        );
      } else {
        initializeTradeFilter();
      }

      document.addEventListener(
        "astro:page-load",
        initializeTradeFilter,
      );
    })();
  </script>
  </body>
</html>



<style>
  :global(:root) {
    color-scheme: dark;
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    --bg: #080d12;
    --panel: #151d26;
    --panel-2: #0d141c;
    --border: #344557;
    --accent: #d7aa3e;
    --accent-soft: #f0cd72;
    --muted: #a9c9e8;
    --good: #38d98a;
    --bad: #ff5d68;
    background: var(--bg);
    color: #f2f4f8;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background:
      radial-gradient(
        circle at 50% -8rem,
        rgba(55, 82, 112, 0.18),
        transparent 44rem
      ),
      linear-gradient(
        180deg,
        #0b1118 0%,
        var(--bg) 52%,
        #060a0e 100%
      );
    color: #f2f4f8;
  }

  .site-header {
    display: grid;
    grid-template-columns: auto 1fr auto;
