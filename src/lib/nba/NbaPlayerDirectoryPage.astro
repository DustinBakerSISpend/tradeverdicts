---
import NbaPlayerDirectoryLayout from "./NbaPlayerDirectoryLayout.astro";
import {
  getNbaPlayerDirectoryPageHref,
  NBA_PLAYER_DIRECTORY_PAGE_SIZE,
} from "./player-directory.mjs";

const {
  rows = [],
  currentPage = 1,
  totalPages = 1,
  totalPlayers = 0,
} = Astro.props;

const pageTitle =
  currentPage === 1
    ? "NBA Player Trade Directory | TradeVerdicts"
    : `NBA Player Trade Directory — Page ${currentPage} | TradeVerdicts`;

const description =
  currentPage === 1
    ? `Browse ${totalPlayers.toLocaleString("en-US")} NBA players and see every trade connected to each player on TradeVerdicts.`
    : `Browse page ${currentPage} of the TradeVerdicts NBA player trade directory.`;

const pageStart =
  totalPlayers === 0
    ? 0
    : (currentPage - 1) * NBA_PLAYER_DIRECTORY_PAGE_SIZE + 1;

const pageEnd = Math.min(
  currentPage * NBA_PLAYER_DIRECTORY_PAGE_SIZE,
  totalPlayers,
);

const windowStart = Math.max(
  1,
  Math.min(currentPage - 2, totalPages - 4),
);

const windowEnd = Math.min(
  totalPages,
  Math.max(currentPage + 2, 5),
);

const pageNumbers = Array.from(
  { length: Math.max(0, windowEnd - windowStart + 1) },
  (_, index) => windowStart + index,
);

const alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("");
---

<NbaPlayerDirectoryLayout
  title={pageTitle}
  description={description}
>
  <main class="directory-shell">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/nba/">Home</a>
      <span aria-hidden="true">/</span>
      <span>Players</span>
    </nav>

    <section class="hero">
      <p class="eyebrow">NBA Trade History by Player</p>
      <h1>Player Trade Directory</h1>

      <p class="lede">
        Browse {totalPlayers.toLocaleString("en-US")} NBA players and open a
        profile to see every trade connected to that player.
      </p>

      <div class="search-panel">
        <label for="playerSearch">Find a player</label>
        <input
          id="playerSearch"
          type="search"
          placeholder="Try Kevin Durant, Shaquille O'Neal, or Chris Paul"
          autocomplete="off"
        />
        <p>
          Search for a player by name, or browse the directory alphabetically below.
        </p>
      </div>

      <div
        class="alphabet"
        aria-label="Filter search results by last-name initial"
      >
        {alphabet.map((letter) => (
          <button
            type="button"
            data-letter={letter}
            aria-pressed="false"
          >
            {letter}
          </button>
        ))}
      </div>
    </section>

    <section id="liveResults" class="directory-section" hidden>
      <div class="section-heading">
        <div>
          <p class="eyebrow">Live Search</p>
          <h2>Matching Players</h2>
        </div>
        <p id="liveResultCount">0 matches</p>
      </div>

      <div id="liveResultGrid" class="player-grid"></div>
      <p id="liveResultNote" class="result-note"></p>
    </section>

    <section id="browseResults" class="directory-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Crawlable Directory</p>
          <h2>
            {currentPage === 1
              ? "Browse Players"
              : `Browse Players — Page ${currentPage}`}
          </h2>
        </div>

        <p>
          Showing {pageStart.toLocaleString("en-US")}–{
            pageEnd.toLocaleString("en-US")
          } of {totalPlayers.toLocaleString("en-US")}
        </p>
      </div>

      <div class="player-grid">
        {rows.map((player) => (
          <a
            class="player-card"
            href={`/nba/players/${player.slug}/`}
          >
            <strong>{player.name}</strong>
          </a>
        ))}
      </div>

      <nav class="pagination" aria-label="Player directory pages">
        {currentPage > 1 && (
          <a
            class="page-link"
            rel="prev"
            href={getNbaPlayerDirectoryPageHref(currentPage - 1)}
          >
            Previous
          </a>
        )}

        {windowStart > 1 && (
          <>
            <a class="page-link" href="/nba/players/">1</a>
            {windowStart > 2 && <span aria-hidden="true">…</span>}
          </>
        )}

        {pageNumbers.map((pageNumber) => (
          <a
            class:list={[
              "page-link",
              { "is-current": pageNumber === currentPage },
            ]}
            href={getNbaPlayerDirectoryPageHref(pageNumber)}
            aria-current={pageNumber === currentPage ? "page" : undefined}
          >
            {pageNumber}
          </a>
        ))}

        {windowEnd < totalPages && (
          <>
            {windowEnd < totalPages - 1 && (
              <span aria-hidden="true">…</span>
            )}
            <a
              class="page-link"
              href={getNbaPlayerDirectoryPageHref(totalPages)}
            >
              {totalPages}
            </a>
          </>
        )}

        {currentPage < totalPages && (
          <a
            class="page-link"
            rel="next"
            href={getNbaPlayerDirectoryPageHref(currentPage + 1)}
          >
            Next
          </a>
        )}
      </nav>
    </section>
  </main>
</NbaPlayerDirectoryLayout>

<script>
  const searchInput = document.getElementById("playerSearch");
  const liveResults = document.getElementById("liveResults");
  const browseResults = document.getElementById("browseResults");
  const liveResultGrid = document.getElementById("liveResultGrid");
  const liveResultCount = document.getElementById("liveResultCount");
  const liveResultNote = document.getElementById("liveResultNote");
  const letterButtons = Array.from(
    document.querySelectorAll("[data-letter]"),
  );

  let playerIndex = null;
  let activeLetter = "";

  const normalize = (value) =>
    String(value || "")
      .toLowerCase()
      .normalize("NFKD")
      .replace(/[’']/g, "")
      .replace(/[^a-z0-9]+/g, " ")
      .replace(/\s+/g, " ")
      .trim();

  async function loadPlayerIndex() {
    if (playerIndex) return playerIndex;

    const response = await fetch("/api/nba-player-search.json");

    if (!response.ok) {
      throw new Error("NBA player search index could not be loaded.");
    }

    playerIndex = await response.json();
    return playerIndex;
  }

  function makePlayerCard(player) {
    const link = document.createElement("a");
    link.className = "player-card";
    link.href = `/nba/players/${player.slug}/`;

    const name = document.createElement("strong");
    name.textContent = player.name;

    link.append(name);
    return link;
  }

  async function renderSearch() {
    const query = normalize(searchInput?.value);
    const hasFilter = Boolean(query || activeLetter);

    if (!hasFilter) {
      if (liveResults) liveResults.hidden = true;
      if (browseResults) browseResults.hidden = false;
      return;
    }

    try {
      const rows = await loadPlayerIndex();

      const matches = rows.filter((player) => {
        const queryMatch =
          !query || normalize(player.name).includes(query);
        const letterMatch =
          !activeLetter ||
          player.lastInitial === activeLetter;

        return queryMatch && letterMatch;
      });

      const visibleMatches = matches.slice(0, 100);

      if (liveResultGrid) {
        liveResultGrid.replaceChildren(
          ...visibleMatches.map(makePlayerCard),
        );
      }

      if (liveResultCount) {
        liveResultCount.textContent =
          `${matches.length.toLocaleString("en-US")} match${
            matches.length === 1 ? "" : "es"
          }`;
      }

      if (liveResultNote) {
        liveResultNote.textContent =
          matches.length > visibleMatches.length
            ? "Showing the first 100 matches. Add more letters to narrow the list."
            : matches.length === 0
              ? "No NBA player profiles match that search."
              : "";
      }

      if (liveResults) liveResults.hidden = false;
      if (browseResults) browseResults.hidden = true;
    } catch (error) {
      if (liveResultNote) {
        liveResultNote.textContent =
          error instanceof Error
            ? error.message
            : "NBA player search is temporarily unavailable.";
      }

      if (liveResults) liveResults.hidden = false;
      if (browseResults) browseResults.hidden = false;
    }
  }

  searchInput?.addEventListener("input", renderSearch);

  letterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const letter = button.getAttribute("data-letter") || "";
      activeLetter = activeLetter === letter ? "" : letter;

      letterButtons.forEach((item) => {
        const selected =
          item.getAttribute("data-letter") === activeLetter;
        item.classList.toggle("is-active", selected);
        item.setAttribute("aria-pressed", String(selected));
      });

      renderSearch();
    });
  });
</script>

<style>
  .directory-shell {
    width: min(1120px, 100%);
    margin: 0 auto;
    padding: 42px 20px 80px;
  }

  .breadcrumbs {
    display: flex;
    gap: 8px;
    margin-bottom: 28px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .breadcrumbs a {
    color: var(--accent);
  }

  .hero,
  .directory-section {
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--panel);
    padding: clamp(22px, 4vw, 38px);
  }

  .hero {
    margin-bottom: 24px;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    margin-bottom: 9px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
    margin-bottom: 18px;
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
  }

  .lede {
    color: var(--muted);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 800px;
  }

  .search-panel {
    margin-top: 28px;
    max-width: 780px;
  }

  .search-panel label {
    display: block;
    font-weight: 800;
    margin-bottom: 9px;
  }

  .search-panel input {
    width: 100%;
    border: 1px solid #36506d;
    border-radius: 12px;
    background: #0c131b;
    color: var(--text);
    font-size: 1rem;
    padding: 15px 16px;
  }

  .search-panel input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(78, 161, 255, 0.18);
    outline: none;
  }

  .search-panel p,
  .result-note,
  .section-heading > p {
    color: var(--muted);
    line-height: 1.55;
    margin-top: 9px;
  }

  .alphabet {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }

  .alphabet button {
    min-width: 38px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--panel-2);
    color: var(--text);
    cursor: pointer;
    font-weight: 800;
    padding: 9px;
  }

  .alphabet button:hover,
  .alphabet button.is-active {
    border-color: var(--accent);
    color: var(--accent);
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
  }

  .player-grid {
    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(220px, 1fr)
    );
    gap: 12px;
  }

  .player-card {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-height: 86px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--panel-2);
    padding: 16px;
    text-decoration: none;
  }

  .player-card:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .player-card strong {
    line-height: 1.3;
  }

  .player-card span {
    color: var(--muted);
    font-size: 0.88rem;
  }

  .pagination {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .page-link {
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--panel-2);
    padding: 9px 12px;
    text-decoration: none;
  }

  .page-link:hover,
  .page-link.is-current {
    border-color: var(--accent);
    color: var(--accent);
  }

  .page-link.is-current {
    pointer-events: none;
  }

  @media (max-width: 680px) {
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .player-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
